@code {
    /// <summary>abrir, guardar, imprimir, agregar, quitar, deshacer, desglose, desglose-abierto, aviso, sistema, claro, oscuro;
    /// los tipos de carga: alumbrado, contactos, equipo, motor, aire, calefaccion, tablero;
    /// y los campos de la ficha (I-178): clave, ubicacion, proyecto, cliente, tension, fases, hilos, frecuencia,
    /// espacios, acometida, principal, espacios-principal, montaje, barras, gabinete, capacidad, interruptores,
    /// inmueble, area, uso, equipo-acometida, conductor, aislamiento, terminales, lugar, temperatura, no-lineal,
    /// caida-derivado, caida-alimentador, diametro.</summary>
    [Parameter, EditorRequired] public string Nombre { get; set; } = "";

    /// <summary>En px; 16 en botones, 14 dentro del cuadro y en la ficha.</summary>
    [Parameter] public int Tamano { get; set; } = 16;

    [Parameter] public string? Clase { get; set; }

    /// <summary>El icono de un tipo de carga.</summary>
    public static string De(CategoriaDeCarga categoria) => categoria switch
    {
        CategoriaDeCarga.Alumbrado => "alumbrado",
        CategoriaDeCarga.Contactos => "contactos",
        CategoriaDeCarga.Equipo => "equipo",
        CategoriaDeCarga.Motor => "motor",
        CategoriaDeCarga.AireAcondicionado => "aire",
        CategoriaDeCarga.Tablero => "tablero",
        _ => "calefaccion",
    };
}
