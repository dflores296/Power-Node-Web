@*
    EL INTERRUPTOR TERMOMAGNÉTICO, DUOTONO (I-66). Mismo trazo que Icono.razor —1.5 px, remate
    redondo, relleno del acento al 16 %—, pero no en la rejilla de 24 × 24: su alto crece con los
    polos, para que en el gabinete cada polo quede frente a su espacio. Genérico: ni marca ni
    logotipo (sin-catalogo-square-d.md).

    NEMA (centro de carga): montado de lado, como va en el gabinete; los polos se apilan cada 34 px
    —el renglón de 30 más el hueco de 4 de .interior— y una sola manija los une, con el valor
    calado en ella. DIN (riel de 35 mm): de pie, módulos de 18 lado a lado, bornes arriba y abajo,
    la curva y el valor en el frente. El DIN está hecho pero sin usar: el único gabinete es NEMA.
*@
@if (Din)
{
    var ancho = 18 * Polos;
    <svg class="interruptor din @Clase" viewBox="0 0 @ancho 40" width="@ancho" height="40" role="img" aria-label="@Nombre">
        <rect class="relleno" x="1" y="1.5" width="@(ancho - 2)" height="37" rx="2.5" />
        <rect class="trazo" x="1" y="1.5" width="@(ancho - 2)" height="37" rx="2.5" />
        <path class="trazo" d="@($"M1 11h{ancho - 2}M1 29h{ancho - 2}")" />
        @for (var k = 0; k < Polos; k++)
        {
            var x = 18 * k;
            if (k > 0)
            {
                <path class="trazo" d="@($"M{x} 1.5v9.5M{x} 29v9.5")" />
            }
            <circle class="trazo" cx="@(x + 9)" cy="6.2" r="1.8" />
            <circle class="trazo" cx="@(x + 9)" cy="33.8" r="1.8" />
        }
        <rect class="manija" x="4.5" y="13.5" width="@(ancho - 9)" height="5.5" rx="1.5" />
        <text class="valor-frente" x="@(ancho / 2)" y="26" font-size="5.5">@Etiqueta</text>
    </svg>
}
else
{
    var alto = 24 + Paso * (Polos - 1);
    <svg class="interruptor nema @Clase" viewBox="0 0 36 @alto" width="36" height="@alto" role="img" aria-label="@Nombre">
        @for (var k = 0; k < Polos; k++)
        {
            var y = Paso * k;
            <rect class="relleno" x="1.5" y="@(y + 2)" width="33" height="20" rx="3" />
            <rect class="trazo" x="1.5" y="@(y + 2)" width="33" height="20" rx="3" />
            <path class="trazo" d="@($"M7.5 {y + 2}v20")" />
            <circle class="trazo" cx="30.5" cy="@(y + 12)" r="1.8" />
        }
        <rect class="manija" x="12" y="6" width="14" height="@(alto - 12)" rx="2.5" />
        <text class="valor" x="19" y="@((alto / 2m + 2.5m).ToString(System.Globalization.CultureInfo.InvariantCulture))" font-size="7">@Etiqueta</text>
    </svg>
}

@code {
    /// <summary>De un polo al siguiente en el NEMA: el renglón del gabinete (30 px) más su hueco (4 px).</summary>
    private const int Paso = 34;

    /// <summary>1, 2 o 3.</summary>
    [Parameter] public int Polos { get; set; } = 1;

    /// <summary>En amperes. En DIN se rotula con la curva: «C16».</summary>
    [Parameter, EditorRequired] public decimal Amperes { get; set; }

    /// <summary>Riel DIN en vez de centro de carga NEMA.</summary>
    [Parameter] public bool Din { get; set; }

    /// <summary>La curva del DIN; no aplica al NEMA.</summary>
    [Parameter] public char Curva { get; set; } = 'C';

    [Parameter] public string? Clase { get; set; }

    private string Etiqueta => Din ? $"{Curva}{Amperes:0}" : $"{Amperes:0}";

    private string Nombre => $"Interruptor {(Din ? "DIN" : "NEMA")} de {Polos} {(Polos == 1 ? "polo" : "polos")}, {Etiqueta}{(Din ? "" : " A")}";

    protected override void OnParametersSet()
    {
        if (Polos is < 1 or > 3)
            throw new ArgumentOutOfRangeException(nameof(Polos), Polos, "Un interruptor lleva de 1 a 3 polos.");
    }
}
