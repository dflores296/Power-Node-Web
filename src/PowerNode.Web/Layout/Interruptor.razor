@*
    EL INTERRUPTOR TERMOMAGNÉTICO NEMA, TIPO QO, DUOTONO (I-66). Mismo trazo que Icono.razor —1.5 px,
    remate redondo, relleno del acento al 16 %—. Genérico: sin marca, logotipo ni rótulo
    (sin-catalogo-square-d.md). Canvas «Iconos de termomagnético», tercera propuesta (David).

    Visto de frente con la manija arriba (encendido): arriba, la pinza de cada polo que entra a la
    barra; al centro, la tapa; abajo, la zapata de carga con su tornillo, una por polo. UNA manija, de
    ancho normal, con la ventana de disparo debajo: en el único polo del de 1, en el derecho del de 2,
    en el central del de 3. La tapa de los otros polos va lisa.

    Proporción del QO real: 20 por polo y 62 de largo, casi 1 : 3 (David: «muy anchos»; la versión
    que llenaba el renglón del gabinete, 34 por polo, se veía chata). En el gabinete va acostado,
    centrado en su celda y con la pinza hacia la barra del centro.
*@
<svg class="interruptor @Clase" viewBox="0 0 @AnchoEnPantalla @AltoEnPantalla" width="@N(AnchoEnPantalla * Escala)" height="@N(AltoEnPantalla * Escala)" role="img" aria-label="@Nombre">
    <g transform="@Giro">
        @foreach (var y in new[] { 0.75m, Largo - 11.75m })
        {
            <rect class="relleno" x="2.25" y="@N(y)" width="@N(Ancho - 4.5m)" height="11" rx="2" />
            <rect class="trazo" x="2.25" y="@N(y)" width="@N(Ancho - 4.5m)" height="11" rx="2" />
        }
        @for (var k = 1; k < Polos; k++)
        {
            <path class="trazo" d="@($"M{Polo * k} 0.75v11M{Polo * k} {N(Largo - 11.75m)}v11")" />
        }
        @for (var k = 0; k < Polos; k++)
        {
            var x = Polo * k + Polo / 2;
            <path class="trazo" d="@($"M{N(x - 2.5m)} 6h5")" />
            <circle class="trazo" cx="@x" cy="@N(Largo - 6.25m)" r="2.2" />
            <path class="trazo" d="@($"M{N(x - 1.1m)} {N(Largo - 5.15m)}l2.2-2.2")" />
        }
        <rect class="fondo" x="0.75" y="9.5" width="@N(Ancho - 1.5m)" height="@(Largo - 19)" rx="2.5" />
        <rect class="relleno" x="0.75" y="9.5" width="@N(Ancho - 1.5m)" height="@(Largo - 19)" rx="2.5" />
        <rect class="trazo" x="0.75" y="9.5" width="@N(Ancho - 1.5m)" height="@(Largo - 19)" rx="2.5" />
        <rect class="trazo" x="@(Manija - 5)" y="15" width="10" height="17" rx="1.5" />
        <rect class="manija" x="@N(Manija - 3.5m)" y="16.5" width="7" height="8.5" rx="1" />
        <path class="ranura" d="@($"M{Manija - 2} 20.75h4")" />
        <rect class="trazo" x="@(Manija - 2)" y="38" width="4" height="3.5" rx="0.8" />
    </g>
</svg>

@code {
    /// <summary>El ancho de un polo.</summary>
    private const int Polo = 20;

    /// <summary>Largo del interruptor, de la pinza a la zapata: 3.1 veces un polo.</summary>
    private const int Largo = 62;

    /// <summary>1, 2 o 3.</summary>
    [Parameter] public int Polos { get; set; } = 1;

    /// <summary>Hacia dónde apunta la pinza. De frente (arriba) por omisión.</summary>
    [Parameter] public HaciaLaBarra Barra { get; set; } = HaciaLaBarra.Arriba;

    /// <summary>Tamaño en pantalla: 1 = 20 px por polo. El gabinete lo usa a 1.2, un polo por renglón de 24 px.</summary>
    [Parameter] public decimal Escala { get; set; } = 1m;

    [Parameter] public string? Clase { get; set; }

    public enum HaciaLaBarra { Arriba, Derecha, Izquierda }

    private int Ancho => Polo * Polos;

    private bool Acostado => Barra != HaciaLaBarra.Arriba;
    private int AnchoEnPantalla => Acostado ? Largo : Ancho;
    private int AltoEnPantalla => Acostado ? Ancho : Largo;

    private string? Giro => Barra switch
    {
        HaciaLaBarra.Derecha => $"translate({Largo} 0) rotate(90)",
        HaciaLaBarra.Izquierda => $"translate(0 {Ancho}) rotate(-90)",
        _ => null,
    };

    /// <summary>El centro del polo que lleva la manija: el único, el derecho (de 2) o el central (de 3).</summary>
    private int Manija => Polo * (Polos == 1 ? 0 : 1) + Polo / 2;

    private string Nombre => $"Interruptor de {Polos} {(Polos == 1 ? "polo" : "polos")}";

    private static string N(decimal valor) => valor.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        if (Polos is < 1 or > 3)
            throw new ArgumentOutOfRangeException(nameof(Polos), Polos, "Un interruptor lleva de 1 a 3 polos.");
    }
}
