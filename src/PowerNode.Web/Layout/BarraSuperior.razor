@inject NavigationManager Navegacion
@inject IJSRuntime JS
@implements IDisposable

@*
    LA BARRA SUPERIOR (David, 2026-09-25 — I-58), con el patrón de las otras dos herramientas de la casa:
    el sitio de la NOM (header.top) y msa-toolkit (header.toolbar). A todo lo ancho, fija arriba y con
    una línea abajo: la marca a la izquierda, las páginas, y a la derecha el tema y la acción de la
    página. Fija porque lo que vive aquí se usa mientras se captura: bajar 24 renglones y tener que
    subir para ir al documento es lo que se quería quitar.
*@
<header class="barra-superior no-imprime">
    <div class="barra-superior-interior">
        @* La carta en línea, para que se dibuje al pasar el cursor (I-59): copia de
           marca/powernode-icono.svg con currentColor, igual que la de la pantalla de carga (index.html). *@
        <a class="marca" href="">
            <svg class="carta-animada" viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <g class="finas" stroke-width="1.8">
                        <circle cx="40.667" cy="32" r="17.333" style="--t: .10" />
                        <circle cx="45" cy="32" r="13" style="--t: .20" />
                        <circle cx="49.333" cy="32" r="8.667" style="--t: .30" />
                        <path d="M58,32 A52,52 0 0 1 16.4,11.2" style="--t: .40" />
                        <path d="M58,32 A52,52 0 0 0 16.4,52.8" style="--t: .45" />
                        <path d="M58,32 A26,26 0 0 1 32,6" style="--t: .55" />
                        <path d="M58,32 A26,26 0 0 0 32,58" style="--t: .60" />
                        <path d="M58,32 A13,13 0 0 1 47.6,11.2" style="--t: .70" />
                        <path d="M58,32 A13,13 0 0 0 47.6,52.8" style="--t: .75" />
                        <path d="M6,32 L58,32" style="--t: .82" />
                    </g>
                    <circle class="borde" cx="32" cy="32" r="26" stroke-width="3.5" pathLength="100" />
                </g>
                <circle class="nodo" cx="32" cy="32" r="4.5" fill="#0B6E99" />
            </svg>
            <span class="marca-texto">Power Node<small>NOM-001-SEDE-2012</small></span>
        </a>
        <span class="vsep" aria-hidden="true"></span>
        <nav class="paginas" aria-label="Páginas">
            <NavLink href="" Match="NavLinkMatch.All">Captura</NavLink>
            <NavLink href="documento" Match="NavLinkMatch.All">Cuadro de carga</NavLink>
            <NavLink href="documento/memoria" Match="NavLinkMatch.All">Memoria de cálculo</NavLink>
        </nav>
        <span class="espaciador"></span>
        <TemaDePantalla />
        @if (EnDocumento)
        {
            <button class="boton primario" type="button" @onclick="Imprimir">Imprimir / PDF</button>
        }
    </div>
</header>

@code {
    private bool EnDocumento => Navegacion.ToBaseRelativePath(Navegacion.Uri).StartsWith("documento", StringComparison.Ordinal);

    protected override void OnInitialized() => Navegacion.LocationChanged += AlCambiarDePagina;

    private void AlCambiarDePagina(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    public void Dispose() => Navegacion.LocationChanged -= AlCambiarDePagina;
}
