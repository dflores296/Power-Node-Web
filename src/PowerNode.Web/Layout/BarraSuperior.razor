@inject NavigationManager Navegacion
@inject IJSRuntime JS
@inject ProyectoActual Proyecto
@implements IDisposable

@*
    LA BARRA SUPERIOR (David, 2026-09-25 — I-58), con el patrón de las otras dos herramientas de la casa:
    el sitio de la NOM (header.top) y msa-toolkit (header.toolbar). A todo lo ancho, fija arriba y con
    una línea abajo: la marca a la izquierda, las páginas, y a la derecha el tema y la acción de la
    página. Fija porque lo que vive aquí se usa mientras se captura: bajar 24 renglones y tener que
    subir para ir al documento es lo que se quería quitar.
*@
<header class="barra-superior no-imprime">
    <div class="barra-superior-interior">
        @* La carta en línea, para que se dibuje al pasar el cursor (I-59): copia de
           marca/powernode-icono.svg con currentColor, igual que la de la pantalla de carga (index.html). *@
        <a class="marca" href="">
            <svg class="carta-animada" viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <g class="finas" stroke-width="1.8">
                        <circle cx="40.667" cy="32" r="17.333" style="--t: .10" />
                        <circle cx="45" cy="32" r="13" style="--t: .20" />
                        <circle cx="49.333" cy="32" r="8.667" style="--t: .30" />
                        <path d="M58,32 A52,52 0 0 1 16.4,11.2" style="--t: .40" />
                        <path d="M58,32 A52,52 0 0 0 16.4,52.8" style="--t: .45" />
                        <path d="M58,32 A26,26 0 0 1 32,6" style="--t: .55" />
                        <path d="M58,32 A26,26 0 0 0 32,58" style="--t: .60" />
                        <path d="M58,32 A13,13 0 0 1 47.6,11.2" style="--t: .70" />
                        <path d="M58,32 A13,13 0 0 0 47.6,52.8" style="--t: .75" />
                        <path d="M6,32 L58,32" style="--t: .82" />
                    </g>
                    <circle class="borde" cx="32" cy="32" r="26" stroke-width="3.5" pathLength="100" />
                </g>
                <circle class="nodo" cx="32" cy="32" r="4.5" fill="#0B6E99" />
            </svg>
            <span class="marca-texto">Power Node<small>NOM-001-SEDE-2012</small></span>
        </a>
        <span class="vsep" aria-hidden="true"></span>
        <nav class="paginas" aria-label="Páginas">
            <NavLink href="" Match="NavLinkMatch.All">Captura</NavLink>
            <NavLink href="documento" Match="NavLinkMatch.All">Cuadro de carga</NavLink>
            <NavLink href="documento/memoria" Match="NavLinkMatch.All">Memoria de cálculo</NavLink>
        </nav>
        <span class="espaciador"></span>
        @* Abrir y guardar el tablero (I-05), en la captura: es donde se edita. En el celular, solo los
           iconos, igual que Imprimir (I-60). *@
        @if (!EnDocumento)
        {
            <button class="boton con-icono" type="button" @onclick="Abrir"
                    title="Abrir un tablero guardado (.powernode.json). Para tener varios a la vez, uno por pestaña.">
                <svg class="boton-icono" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1.5 4.5a1 1 0 0 1 1-1h3.2l1.5 1.5h6.3a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1z" />
                </svg>
                <span class="boton-texto">Abrir</span>
            </button>
            <button class="boton con-icono" type="button" @onclick="Guardar"
                    title="Guardar el tablero en un archivo de este equipo: la captura completa, para abrirla después.">
                <svg class="boton-icono" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.5 1.5h9l3 3v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z" />
                    <path d="M4.5 1.5v4h6v-4" />
                    <path d="M4.5 14.5v-5h7v5" />
                </svg>
                <span class="boton-texto">Guardar</span>
            </button>
        }
        <TemaDePantalla />
        @if (EnDocumento)
        {
            @* En el celular, solo el icono: con el texto la barra se iba a tres renglones (I-60). *@
            <button class="boton primario con-icono" type="button" @onclick="Imprimir">
                <svg class="boton-icono" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 6V2h8v4" />
                    <path d="M4 12H2.5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H12" />
                    <path d="M4 9.5h8V14H4z" />
                </svg>
                <span class="boton-texto">Imprimir / PDF</span>
            </button>
        }
    </div>
    @if (_nota is { } nota)
    {
        <div class="nota-archivo @(_notaEsError ? "error" : null)" role="status">
            <span>@nota</span>
            <button type="button" class="cerrar" aria-label="Cerrar el aviso" @onclick="() => _nota = null">×</button>
        </div>
    }
</header>

@code {
    private bool EnDocumento => Navegacion.ToBaseRelativePath(Navegacion.Uri).StartsWith("documento", StringComparison.Ordinal);

    protected override void OnInitialized() => Navegacion.LocationChanged += AlCambiarDePagina;

    private void AlCambiarDePagina(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private async Task Imprimir() => await JS.InvokeVoidAsync("window.print");

    // ---- Abrir y guardar (I-05) ---------------------------------------------------------------------

    private sealed record ArchivoLeido(string Nombre, string Texto);

    private async Task Guardar()
    {
        var (nombre, texto) = Proyecto.ParaGuardar();
        string? escrito;
        try
        {
            escrito = await JS.InvokeAsync<string?>("powerNode.archivo.guardar", nombre, texto);
        }
        catch (JSException e)
        {
            Avisar($"No se pudo guardar: {e.Message}", error: true);
            return;
        }
        if (escrito is null)
            return; // canceló el diálogo
        Proyecto.Guardado();
        await JS.InvokeVoidAsync("powerNode.archivo.marcarSinGuardar", false);
        Avisar($"Guardado: «{escrito}».");
    }

    private async Task Abrir()
    {
        var archivo = await JS.InvokeAsync<ArchivoLeido?>("powerNode.archivo.abrir");
        if (archivo is null)
            return;
        if (Proyecto.SinGuardar &&
            !await JS.InvokeAsync<bool>("powerNode.archivo.confirmar",
                $"El tablero de esta pestaña tiene cambios sin guardar. ¿Abrir «{archivo.Nombre}» en su lugar y perderlos?\n\nPara tener los dos, cancela, guarda este y abre el otro en una pestaña nueva."))
            return;

        var apertura = Proyecto.Abrir(archivo.Texto);
        if (apertura.Error is { } error)
        {
            Avisar($"No se abrió «{archivo.Nombre}». {error}", error: true);
            return;
        }
        await JS.InvokeVoidAsync("powerNode.archivo.marcarSinGuardar", false);
        Avisar(apertura.Avisos.Count == 0
            ? $"Abierto: «{archivo.Nombre}»."
            : $"Abierto: «{archivo.Nombre}». {string.Join(" ", apertura.Avisos)}", error: false, largo: apertura.Avisos.Count > 0);
    }

    private string? _nota;
    private bool _notaEsError;
    private CancellationTokenSource? _borrarNota;

    /// <summary>El aviso bajo la barra: se va solo a los 5 s (a los 12 si es error o trae avisos).</summary>
    private void Avisar(string nota, bool error = false, bool largo = false)
    {
        _nota = nota;
        _notaEsError = error;
        _borrarNota?.Cancel();
        var cancelar = _borrarNota = new CancellationTokenSource();
        _ = BorrarDespues(error || largo ? 12000 : 5000, cancelar.Token);
    }

    private async Task BorrarDespues(int ms, CancellationToken token)
    {
        try
        {
            await Task.Delay(ms, token);
            _nota = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= AlCambiarDePagina;
        _borrarNota?.Cancel();
    }
}
