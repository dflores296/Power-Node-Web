@*
    EL CONDUCTOR VISTO DE FRENTE (David, 2026-10-03 — I-181). Reemplaza a las cajitas de color de «Fase»,
    «Neutro» y «Puesta a tierra» del alimentador. Sólido, no duotono: el forro con el color que le toca —
    fases A negro, B rojo, C azul; neutro blanco, 200-6; tierra verde, 250-119 — y adentro el conductor
    cableado de 7 hilos (1 + 6), como en la Tabla 8.

    Dice lo que el cálculo usa: los hilos en cobre o en aluminio según el material, y la tierra sin forro
    cuando la canalización la lleva desnuda.

    Con volumen (David: «se ven planos… ¿no le puedes poner brillo?»): cada hilo con su degradado radial,
    la luz arriba a la izquierda —cobre o aluminio pulido—, y el forro con un reflejo y la orilla en sombra.
    Los degradados llevan un id por icono: con uno solo para todos, el navegador toma el primero de la
    página, y si ese está oculto algunos no pintan nada.
*@
<svg class="corte @(Aluminio ? "aluminio" : null)" viewBox="0 0 24 24" width="@Tamano" height="@Tamano" aria-hidden="true" focusable="false">
    <defs>
        <radialGradient id="@($"corte-hilo-{_n}")" cx=".36" cy=".32" r=".72">
            @if (Aluminio)
            {
                <stop offset="0" stop-color="#ffffff" />
                <stop offset=".4" stop-color="#cfd4da" />
                <stop offset="1" stop-color="#7f8790" />
            }
            else
            {
                <stop offset="0" stop-color="#ffd9b3" />
                <stop offset=".4" stop-color="#d98a50" />
                <stop offset="1" stop-color="#8e4a1f" />
            }
        </radialGradient>
        <radialGradient id="@($"corte-brillo-{_n}")" cx=".32" cy=".26" r=".85">
            <stop offset="0" stop-color="#fff" stop-opacity=".5" />
            <stop offset=".45" stop-color="#fff" stop-opacity="0" />
            <stop offset=".8" stop-color="#000" stop-opacity="0" />
            <stop offset="1" stop-color="#000" stop-opacity=".35" />
        </radialGradient>
    </defs>
    @if (!Desnudo)
    {
        <circle class="forro forro-@Forro" cx="12" cy="12" r="11" />
        <circle cx="12" cy="12" r="11" fill="@($"url(#corte-brillo-{_n})")" />
        <circle class="hueco" cx="12" cy="12" r="8.2" />
    }
    @foreach (var (x, y) in Hilos)
    {
        <circle class="hilo" cx="@x" cy="@y" r="2.6" fill="@($"url(#corte-hilo-{_n})")" />
    }
</svg>

@code {
    /// <summary>a, b, c (la fase), neutro o tierra.</summary>
    [Parameter, EditorRequired] public string Forro { get; set; } = "";

    /// <summary>Sin forro: la tierra desnuda.</summary>
    [Parameter] public bool Desnudo { get; set; }

    /// <summary>Los hilos en aluminio; si no, en cobre.</summary>
    [Parameter] public bool Aluminio { get; set; }

    /// <summary>En px.</summary>
    [Parameter] public int Tamano { get; set; } = 26;

    // Los 7 hilos: uno al centro y seis alrededor, tocándose (radio 2.6 a 5.15 del centro).
    private static readonly (string X, string Y)[] Hilos =
        [("12", "12"), ("16.46", "14.58"), ("12", "17.15"), ("7.54", "14.58"), ("7.54", "9.43"), ("12", "6.85"), ("16.46", "9.43")];

    private static int _siguiente;
    private readonly int _n = System.Threading.Interlocked.Increment(ref _siguiente);
}
