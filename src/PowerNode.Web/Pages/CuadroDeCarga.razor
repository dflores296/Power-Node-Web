@page "/"
@inject MotorNom Motor

<PageTitle>Cuadro de carga — Power Node</PageTitle>

<header class="encabezado">
    <div>
        <h1>Cuadro de carga</h1>
        <p class="meta">NOM-001-SEDE-2012 · Art. 210, 240, 250, 310</p>
    </div>
    <div class="sistema">
        <label>
            Tensión (V)
            <select @bind="_tensionFF" @bind:after="RecalcularTodo">
                <option value="127">127 (1F-2H)</option>
                <option value="220">220 (3F-4H)</option>
                <option value="440">440 (3F-4H)</option>
            </select>
        </label>
        <label>
            Espacios
            <select @bind="_espacios" @bind:after="RecalcularTodo">
                <option value="12">12</option>
                <option value="18">18</option>
                <option value="24">24</option>
                <option value="30">30</option>
                <option value="42">42</option>
            </select>
        </label>
    </div>
</header>

<div class="lados">
    @foreach (var (titulo, circuitos) in new[]
              {
                  ("Lado izquierdo (nones)", Circuitos.Where(c => c.Numero % 2 == 1).ToList()),
                  ("Lado derecho (pares)", Circuitos.Where(c => c.Numero % 2 == 0).ToList()),
              })
    {
        <section class="lado">
            <h2>@titulo</h2>
            <table class="cuadro">
                <thead>
                    <tr>
                        <th>N.º</th>
                        <th class="izq">Descripción</th>
                        <th>Tipo</th>
                        <th>Continua<br /><small>VA</small></th>
                        <th>No continua<br /><small>VA</small></th>
                        <th>L<br /><small>m</small></th>
                        <th>P</th>
                        <th>Fase</th>
                        <th>In<br /><small>A</small></th>
                        <th>Protec.</th>
                        <th>Fase</th>
                        <th>N</th>
                        <th>T</th>
                        <th>e %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in circuitos)
                    {
                        <tr class="@(c.Resultado is null ? "vacio" : null)">
                            <td class="num">@c.Numero</td>
                            <td><input class="desc" @bind="c.Descripcion" @bind:event="oninput" placeholder="—" /></td>
                            <td>
                                <select class="tipo" @bind="c.Tipo" @bind:after="() => Recalcular(c)">
                                    <option value="@TipoCarga.Alumbrado">Alumbrado</option>
                                    <option value="@TipoCarga.Contactos">Contactos</option>
                                    <option value="@TipoCarga.Equipo">Equipo</option>
                                </select>
                            </td>
                            <td><input class="va" type="number" min="0" @bind="c.ContinuaVA" @bind:after="() => Recalcular(c)" /></td>
                            <td><input class="va" type="number" min="0" @bind="c.NoContinuaVA" @bind:after="() => Recalcular(c)" /></td>
                            <td><input class="va" type="number" min="0" @bind="c.LongitudM" @bind:after="() => Recalcular(c)" /></td>
                            <td>
                                <select class="polos" @bind="c.Polos" @bind:after="() => { AsignarFase(c); Recalcular(c); }">
                                    @foreach (var p in PolosPosibles) { <option value="@p">@p</option> }
                                </select>
                            </td>
                            <td class="fase fase-@c.Fase.ToLowerInvariant()">@c.Fase</td>
                            <td class="num">@c.Resultado?.CorrienteDisenoA.ToString("N2")</td>
                            <td class="num fuerte">@(c.Resultado is null ? "" : $"{c.Resultado.ProteccionA:N0} A")</td>
                            <td class="num">@c.Resultado?.CalibreFase.Designacion</td>
                            <td class="num">@c.Resultado?.CalibreNeutro.Designacion</td>
                            <td class="num">@c.Resultado?.CalibreTierra.Designacion</td>
                            <td class="num @(c.Excede ? "excede" : null)">@c.Resultado?.CaidaTensionPct.ToString("N2")</td>
                        </tr>
                        @if (c.Error is not null)
                        {
                            <tr class="fila-error">
                                <td></td>
                                <td colspan="13">@c.Error</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    }
</div>

@if (Seleccionado?.Resultado is not null)
{
    <section class="memoria">
        <h2>Memoria del circuito @Seleccionado.Numero</h2>
        <ul>
            @foreach (var cita in Seleccionado.Resultado.Citas)
            {
                <li><code>@cita.Referencia</code> @cita.Descripcion</li>
            }
        </ul>
    </section>
}

<footer class="pie">
    Tablas leídas de
    <a href="https://github.com/dflores296/NOM-001-SEDE-2012">NOM-001-SEDE-2012</a>,
    verificadas celda por celda contra el PDF del DOF.
    Tabla 8 verificada el @Motor.Fuente.VerificadaEl("8").
    <strong>Los resultados no sustituyen el criterio del ingeniero responsable.</strong>
</footer>

@code {
    private int _tensionFF = 220;
    private int _espacios = 24;

    private List<Circuito> Circuitos { get; set; } = [];
    private Circuito? Seleccionado => Circuitos.FirstOrDefault(c => c.Resultado is not null);

    protected override void OnInitialized() => Reconstruir();

    private void RecalcularTodo()
    {
        Reconstruir();
        foreach (var c in Circuitos)
            Recalcular(c);
    }

    private void Reconstruir()
    {
        var previos = Circuitos.ToDictionary(c => c.Numero);
        Circuitos = Enumerable.Range(1, _espacios)
            .Select(n => previos.TryGetValue(n, out var p) ? p : new Circuito { Numero = n })
            .ToList();

        foreach (var c in Circuitos)
        {
            if (c.Polos > PolosPosibles.Max()) c.Polos = PolosPosibles.Max();
            AsignarFase(c);
        }
    }

    /// <summary>1 y 2 polos en bifásico/monofásico; hasta 3 en un tablero trifásico.</summary>
    private int[] PolosPosibles => _tensionFF <= 127 ? [1] : [1, 2, 3];

    /// <summary>
    /// NEMA por pares: los dos espacios a la misma altura muerden la misma barra.
    /// 1 y 2 → A, 3 y 4 → B, 5 y 6 → C, 7 y 8 → A…
    /// Convención confirmada contra un unifilar real en el proyecto de escritorio; no reabrirla sin
    /// evidencia nueva. En 1F-2H sólo hay una fase, así que todo cae en A.
    /// </summary>
    private string FaseDelEspacio(int numero) =>
        _tensionFF <= 127 ? "A" : "ABC"[((numero - 1) / 2) % 3].ToString();

    /// <summary>
    /// Un multipolar ocupa N, N+2, N+4 — del mismo lado del tablero, saltándose el espacio de
    /// enfrente. Un 3 polos en el espacio 8 toca 8-10-12, que con la convención de pares da A-B-C.
    /// </summary>
    private void AsignarFase(Circuito c) =>
        c.Fase = string.Concat(Enumerable.Range(0, c.Polos)
            .Select(i => FaseDelEspacio(c.Numero + i * 2)));

    /// <summary>
    /// El piso de calibre por criterio de diseño, no por norma. Mismos valores por omisión que
    /// <c>ConfiguracionProyecto</c> en escritorio. Equipo nace sin piso a propósito: un aparato se
    /// dimensiona por su consumo de placa.
    /// </summary>
    private static decimal? PisoPracticoDe(TipoCarga tipo) => tipo switch
    {
        TipoCarga.Alumbrado => CalibresDePractica.DoceAwgMm2,
        TipoCarga.Contactos => CalibresDePractica.DiezAwgMm2,
        _ => null,
    };

    private void Recalcular(Circuito c)
    {
        c.Error = null;

        if (c.ContinuaVA <= 0 && c.NoContinuaVA <= 0)
        {
            c.Resultado = null;
            return;
        }

        try
        {
            // NumeroFases es el del CIRCUITO —cuántas barras toca, o sea sus polos—, NO el del
            // tablero. Pasar el del tablero fue un bug real de la primera versión de esta pantalla:
            // un circuito de 1 polo con 720 VA daba 1.89 A en vez de 5.67 A, porque el motor repartía
            // la carga entre tres fases. El escritorio lo resuelve igual: circuito.Fase.Length.
            var tensionFN = _tensionFF <= 127
                ? _tensionFF
                : Math.Round(_tensionFF / (decimal)Math.Sqrt(3), 2);

            c.Resultado = Motor.NoMotor.Calcular(new DatosEntradaCircuitoDerivadoNoMotor(
                TipoCarga: c.Tipo,
                CargaContinuaVA: c.ContinuaVA,
                CargaNoContinuaVA: c.NoContinuaVA,
                NumeroFases: c.Polos,
                TensionFaseNeutroV: tensionFN,
                TensionFaseFaseV: _tensionFF,
                LongitudM: c.LongitudM,
                NumeroConductoresParalelo: 1,
                NumeroConductoresAgrupados: 3,
                TemperaturaAmbienteC: 30m,
                MaterialConductor: MaterialConductor.Cobre,
                MaterialCanalizacion: MaterialCanalizacion.Pvc,
                FactorPotencia: 0.9m,
                CaidaTensionMaxPct: 3m,
                // El piso práctico NO es de la norma (que permite 14 AWG, 210-19(a)(4)): es criterio
                // de diseño, y son los mismos valores por omisión que ya trae ConfiguracionProyecto
                // en la versión de escritorio -- 12 AWG en alumbrado, 10 en contactos. Sin esto la
                // web daba 14 AWG donde el escritorio da 12, con los dos cumpliendo la caída.
                PisoPracticoCalibreMm2: PisoPracticoDe(c.Tipo)));
        }
        catch (Exception ex)
        {
            c.Resultado = null;
            c.Error = ex.Message;
        }
    }

    private sealed class Circuito
    {
        public int Numero { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal ContinuaVA { get; set; }
        public decimal NoContinuaVA { get; set; }
        public decimal LongitudM { get; set; } = 20;
        public TipoCarga Tipo { get; set; } = TipoCarga.Alumbrado;
        public int Polos { get; set; } = 1;
        public string Fase { get; set; } = "A";
        public ResultadoCircuitoDerivado? Resultado { get; set; }
        public string? Error { get; set; }

        public bool Excede => Resultado is { CaidaTensionPct: > 3m };
    }
}
