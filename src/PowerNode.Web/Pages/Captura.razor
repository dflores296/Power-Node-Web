                        <span class="tenue">—</span>
                    }
                </td>
            }
            <td class="casilla-canal"><input type="checkbox" data-col="cn-desnuda" aria-label="@CuadroDeCarga.NombreDe(t) · Tierra desnuda" title="Tierra desnuda — Tabla 8" checked="@t.TierraDesnuda" @onchange="e => { t.TierraDesnuda = e.Value is true; Recalcular(); }" /></td>
            <td class="@(alimentador ? null : "ultima")">
                @if (t.Tipo.EsTubo())
