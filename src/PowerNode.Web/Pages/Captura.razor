@page "/"
@inject ProyectoActual Proyecto
@inject MotorNom Motor
@inject NavigationManager Navegacion
@inject IJSRuntime JS
@implements IDisposable
@using System.Globalization

@* La pestaña lleva el nombre del tablero: con varias abiertas, dice cuál es cuál (I-05). *@
<PageTitle>@Proyecto.TituloDeVentana</PageTitle>

@* El título de la página va para los lectores de pantalla (y para FocusOnNavigate): a la vista, la
   barra superior ya dice dónde se está (I-58). *@
<h1 class="solo-lector">Captura del cuadro de carga</h1>

<section class="ficha" id="sec-ficha">
    <div class="pila">
    <div class="grupo">
        <h2>Identificación</h2>
        <label>Tablero <input @bind="Datos.Tablero" @bind:event="oninput" /></label>
        <label>Clave <input @bind="Datos.Clave" @bind:event="oninput" /></label>
        <label>Ubicación <input @bind="Datos.Ubicacion" @bind:event="oninput" /></label>
        <label>Proyecto <input @bind="Datos.Proyecto" @bind:event="oninput" /></label>
        <label>Cliente <input @bind="Datos.Cliente" @bind:event="oninput" /></label>
    </div>

    <div class="grupo">
        <h2>Sistema</h2>
        @* En 1F-2H no hay dos fases: la tensión es de fase a neutro (I-53). *@
        <label><span class="ayuda" title="@(EsUnaFaseDosHilos ? "Capturar la tensión de fase a neutro: 127 V (o 120 V) — 110-4." : "Capturar la tensión entre fases. 1F-3H: 240 V (120/240). 2F-3H y 3F-4H: 220 V (220Y/127) o 208 V (208Y/120). 3F-3H: 220, 240, 480 V… — 110-4.")">@(EsUnaFaseDosHilos ? "Tensión F-N (V)" : "Tensión F-F (V)")</span>
            <input data-requerido type="number" min="100" step="1" value="@Numero(Datos.TensionFaseFaseV)" @onchange="e => { Datos.TensionFaseFaseV = Leer(e, Datos.TensionFaseFaseV); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Seleccionar los conductores energizados. 1: una fase y neutro (1F-2H) o monofásico con derivación central, 120/240 V (1F-3H). 2: dos fases de un sistema en estrella, 220/127 V (2F-3H, el «bifásico»). 3: trifásico.">Fases</span>
            <select @bind="Datos.Fases" @bind:after="Recalcular">@foreach (var f in new[] { 1, 2, 3 }) { <option value="@f">@f</option> }</select></label>
        <label><span class="ayuda" title="Hilos = fases + neutro. La tierra no se cuenta: fase, neutro y tierra es 1F-2H. 1F-3H es otro sistema: dos vivos en oposición y neutro, 120/240 V.">Hilos</span>
            <select @bind="Datos.Hilos" @bind:after="Recalcular">@foreach (var h in Datos.HilosValidos) { <option value="@h">@h</option> }</select></label>
        <label>Frecuencia (Hz) <input data-requerido type="number" min="50" step="10" @bind="Datos.FrecuenciaHz" /></label>
        <p class="derivado">
            @Datos.EtiquetaSistema ·
            Tensión F-N <strong>@Datos.TensionFaseNeutroV.ToString("N1") V</strong> ·
            barras <strong>@string.Join(" ", Datos.Barras)</strong>
        </p>
        @if (Datos.AvisoTension is { } avisoTension)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoTension</span></p>
        }
    </div>
    </div>

    <div class="grupo">
        <h2>Gabinete</h2>
        <label>Espacios <select @bind="Datos.NumeroEspacios" @bind:after="Recalcular">
            @foreach (var e in Datos.EspaciosValidos) { <option value="@e">@e</option> }
        </select></label>
        <label>Acometida <select @bind="Datos.TipoAcometida" @bind:after="Recalcular">
            <option value="@TipoAcometidaTablero.InterruptorPrincipal">Interruptor principal</option>
            <option value="@TipoAcometidaTablero.ZapatasPrincipales">Zapatas principales</option>
        </select></label>
        @* Dónde va el principal — decisión montaje-del-interruptor-principal (I-68). Con una barra no
           hay zócalo: siempre va en un espacio. *@
        @if (Datos.UsaInterruptorPrincipal && Datos.Barras.Count > 1)
        {
            <label><span class="ayuda" title="Zócalo propio: abajo de las barras, sin ocupar espacios numerados. En espacios: como un derivado, se come tantos espacios como polos; por omisión, los últimos pares.">Montaje del principal</span>
                <select @bind="Datos.MontajePrincipal" @bind:after="Recalcular">
                    <option value="@MontajeDelPrincipal.Zocalo">Zócalo propio</option>
                    <option value="@MontajeDelPrincipal.EnEspacios">En espacios del gabinete</option>
                </select></label>
        }
        @if (Datos.PrincipalEnEspacios)
        {
            <label><span class="ayuda" title="Los espacios que se come el interruptor principal. Es un valor por omisión: se puede mover a donde quepa sin pisar un circuito.">Espacios del principal</span>
                <select value="@Cuadro.EspacioInicialDelPrincipal" @onchange="CambiarEspacioDelPrincipal">
                    @foreach (var e in Datos.EspaciosValidosDelPrincipal)
                    {
                        <option value="@e">@string.Join("-", DistribucionBarras.EspaciosQueOcupa(e, Datos.PolosDelPrincipal))</option>
                    }
                </select></label>
        }
        @if (Cuadro.AvisoDelPrincipal is { } avisoPrincipal)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoPrincipal</span></p>
        }
        <label>Montaje <select @bind="Datos.Montaje">
            <option value="Sobreponer">Sobreponer</option>
            <option value="Empotrar">Empotrar</option>
        </select></label>
        <label>Barras <select @bind="Datos.MaterialBarras">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label>Gabinete NEMA <select @bind="Datos.GabineteNema">
            @foreach (var n in new[] { "1", "3R", "4X", "12" }) { <option value="@n">@n</option> }
        </select></label>
        <label>Capacidad de barra (A) <input type="number" min="0" step="1" placeholder="—"
                                             @bind="Datos.CapacidadBarraA" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Seleccionar la familia de interruptores. Centro de carga (NEMA): 240-6(a) sin 16, 32 ni 63 A. Riel DIN (IEC): 16, 20, 25, 32, 40, 50, 63, 80, 100 y 125 A. NOM completa: 240-6(a) sin exclusiones.">Interruptores</span>
            <select @bind="Datos.SerieInterruptores" @bind:after="Recalcular">
                @foreach (var serie in new[] { SerieDeInterruptores.CentroDeCargaNema, SerieDeInterruptores.RielDinIec, SerieDeInterruptores.NomCompleta })
                {
                    <option value="@serie">@serie.Nombre()</option>
                }
            </select></label>
        <label><span class="ayuda" title="Seleccionar el inmueble. Decide dos cosas: el mínimo del principal si el tablero es equipo de acometida — 230-79 (vivienda unifamiliar: según la carga; vivienda popular hasta 60 m²: 30 A; los demás: 60 A) — y qué justificaciones del factor de demanda aplican — Tabla 220-42, vivienda o no vivienda.">Inmueble</span>
            <select @bind="Datos.Inmueble" @bind:after="Recalcular">
                @foreach (var inmueble in Enum.GetValues<TipoDeInmueble>()) { <option value="@inmueble">@inmueble.Nombre()</option> }
            </select></label>
        <label><span class="ayuda" title="Marcar si el tablero es el medio de desconexión de la acometida (el primero después del medidor). El principal sube al mínimo de 230-79 según el inmueble.">Equipo de acometida</span>
            <input type="checkbox" class="casilla" @bind="Datos.EsEquipoDeAcometida" @bind:after="Recalcular" /></label>
    </div>

    <div class="grupo">
        <h2>Condiciones de cálculo</h2>
        <label>Conductor <select @bind="Datos.MaterialConductor" @bind:after="Recalcular">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label><span class="ayuda" title="Seleccionar el aislamiento — Tabla 310-104(a). Determina la columna de temperatura de la Tabla 310-15(b)(16) para aplicar FT y FA. Ampacidad limitada a la temperatura de la terminal — 110-14(c).">Aislamiento</span>
            <select @bind="Datos.TipoAislamiento" @bind:after="Recalcular">
                @foreach (var aislamiento in Aislamientos)
                {
                    <option value="@aislamiento">@aislamiento@(EnTabla5(aislamiento) ? "" : " · diámetro del fabricante")</option>
                }
            </select></label>
        <label><span class="ayuda" title="Declarar la temperatura de las terminales del interruptor y del equipo — 110-14(c)(1). Regla general: 60 °C hasta 100 A; 75 °C arriba de 100 A. Marcadas 75 °C: aplicar solo si ambas terminales lo indican — a.(3). Conductor de 60 °C: usar 60 °C — a.(1).">Terminales</span>
            <select @bind="Terminales" @bind:after="Recalcular">
                <option value="60">60 °C hasta 100 A (regla general)</option>
                <option value="75">Marcadas 75 °C</option>
            </select></label>
        <label><span class="ayuda" title="Seleccionar el lugar de instalación — Tabla 310-104(a). Determina la temperatura del aislamiento (THHW-LS: 90 °C seco, 75 °C mojado) y su validez (THHN: solo lugar seco).">Lugar</span>
            <select @bind="Lugar" @bind:after="Recalcular">
                <option value="seco">Seco</option>
                <option value="mojado">Húmedo o mojado</option>
            </select></label>
        <label>T. ambiente (°C) <input data-requerido type="number" min="10" max="80" step="1" value="@Numero(Datos.TemperaturaAmbienteC)" @onchange="e => { Datos.TemperaturaAmbienteC = Leer(e, Datos.TemperaturaAmbienteC); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Marcar si la mayor parte de la carga es no lineal (electrónica, iluminación LED, equipo de cómputo): en 3F-4H el neutro lleva armónicas y cuenta como portador — 310-15(b)(5)(3).">Carga no lineal</span>
            <input type="checkbox" class="casilla" @bind="Datos.CargaNoLineal" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del circuito derivado. Recomendado: 3 % — 210-19(a)(1), NOTA 4.">e% máx. derivado</span> <input data-requerido type="number" min="0.5" max="10" step="0.5" value="@Numero(Datos.CaidaMaxDerivadoPct)" @onchange="e => { Datos.CaidaMaxDerivadoPct = Leer(e, Datos.CaidaMaxDerivadoPct); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del alimentador. Valor inicial: 2 %, para que con el 3 % del derivado sumen el 5 % combinado — 215-2(a)(4), NOTA 2; 210-19(a)(1), NOTA 4.">e% máx. alimentador</span> <input data-requerido type="number" min="0.5" max="10" step="0.5" value="@Numero(Datos.CaidaMaxAlimentadorPct)" @onchange="e => { Datos.CaidaMaxAlimentadorPct = Leer(e, Datos.CaidaMaxAlimentadorPct); Recalcular(); }" /></label>
        @if (Datos.AvisoLimitesDeCaida is { } avisoLimites)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoLimites</span></p>
        }
    </div>
</section>

<section class="cuadro-completo" id="sec-cuadro">
    <table class="cuadro">
        <thead>
            @*
                Encabezados en UN renglón con la unidad entre paréntesis —«In (A)», «L (m)», «e (%)»—
                y no partidos en dos líneas: partidos, las columnas de una sola línea quedaban
                desalineadas con las de dos y el cuadro se leía torcido. Lo que no cabe en el rótulo
                va en el tooltip, no en una segunda línea.
            *@
            <tr>
                <th rowspan="2"><span class="ayuda" title="@(Cuadro.UnaSolaBarra ? "Identificar el circuito por su espacio en la barra. Una sola barra: en orden." : "Identificar el circuito por su espacio en la barra. Nones arriba, pares abajo.")">N.º</span></th>
                <th rowspan="2" class="izq descripcion" data-col="desc" title="Describir el circuito. Ctrl+Enter abre o cierra el desglose de sus aparatos.">Descripción</th>
                <th rowspan="2" data-col="tipo"><span class="ayuda" title="Seleccionar el tipo de carga. Determina el factor de demanda del resumen — Art. 220.&#10;&#10;Alumbrado: luminarias y alumbrado general.&#10;Contactos: contactos de uso general; en vivienda, seleccionar el uso (cocina, lavadora, baño).&#10;Equipo: hornos, estufas, parrillas, secadoras, calentadores de agua, equipo electrónico.&#10;Motor / A/C: todo lo que funciona con motor o compresor: aire acondicionado, refrigeración, bombas, ventiladores, bombas de calor e inverter frío/calor.&#10;Calefacción: calefacción por resistencia eléctrica: calefactores, cables calefactores, calderas eléctricas; carga continua — 424-3(b).&#10;&#10;Motor / A/C y calefacción se calculan como carga de placa (Art. 430 pendiente). 240-4(b) no aplica en contactos.">Tipo</span></th>
                <th colspan="4"><span class="ayuda" title="Capturar la carga de placa en VA, W o A y su factor de potencia. Continua (3 h o más): 125 % — 210-19(a)(1), 210-20(a). No continua: 100 %. En W o A, consultar abajo el VA de cálculo.">Carga</span></th>
                <th colspan="@Datos.Barras.Count"><span class="ayuda" title="Consultar la carga del circuito repartida entre las barras que toca.">Balanceo de fases <span class="simbolo">(VA)</span></span></th>
                <th rowspan="2" data-col="l"><span class="ayuda" title="Capturar la longitud del circuito. Determina la caída de tensión — Tabla 9."><span class="simbolo">L (m)</span></span></th>
                <th rowspan="2" data-col="canal"><span class="ayuda" title="Seleccionar la canalización del circuito de la lista de la tarjeta «Canalizaciones». Al capturar la carga, cada circuito nace en la suya (T1, T2…); para agrupar, elegir la de otro circuito, o «+ Nueva». Los circuitos de una misma canalización se agrupan y el programa cuenta sus portadores — 310-15(b)(3)(a). Si el circuito pasa por varias, la del tramo más desfavorable — 310-15(a)(2). Debajo: el tamaño que resultó.">Canal.</span></th>
                <th rowspan="2" data-col="polos masn"><span class="ayuda" title="Seleccionar los polos del interruptor. Un multipolar ocupa los espacios N, N+2 y N+4 del mismo lado.">P</span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar las barras que toca el interruptor. Las determina el espacio de montaje.">Barras</span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar la corriente de diseño de la carga capturada — 210-19(a)(1)."><span class="simbolo">In (A)</span></span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar la protección: primer tamaño normalizado mayor o igual a la capacidad mínima — 240-6(a), 210-20(a). Pasar el cursor sobre el valor para consultar el desglose.">Protec. <span class="simbolo">(A)</span></span></th>
                <th rowspan="2"><span class="muestras">@foreach (var barra in Datos.Barras) { <i class="color-@char.ToLowerInvariant(barra)"></i> }</span><span class="ayuda" title="Consultar el conductor de fase: designación AWG/kcmil y, debajo, su sección (mm²) — Tabla 8. Si lleva conductores en paralelo, «2 ×» antes del calibre. Pasar el cursor sobre el calibre para consultar el desglose.&#10;&#10;Colores de fase: la NOM no los fija — 210-5(c)(2) —; se usan negro, rojo y azul, la práctica común.">Fase</span></th>
                <th rowspan="2"><span class="muestras"><i class="color-neutro"></i></span><span class="ayuda" title="Consultar el conductor de neutro. Blanco o gris claro — 200-6.">Neutro</span></th>
                <th rowspan="2"><span class="muestras"><i class="color-tierra"></i></span><span class="ayuda" title="Consultar el conductor de puesta a tierra de equipos — Tabla 250-122 y 250-122(b). Verde, o verde con franjas amarillas — 250-119.">Puesta a tierra</span></th>
                <th rowspan="2" class="ultima"><span class="ayuda" title="Consultar la caída de tensión del circuito. Límite recomendado: 3 % en el derivado y 5 % combinada — 210-19(a)(1), nota 4."><span class="simbolo">e (%)</span></span></th>
            </tr>
            <tr>
                <th data-col="unidad"><span class="ayuda" title="Seleccionar la unidad de placa. W: convertir con el factor de potencia. A: convertir con la tensión y los polos del circuito.">Unidad</span></th>
                <th data-col="continua"><span class="ayuda" title="Capturar la carga que opera 3 h o más. Aplicar 125 % — 210-19(a)(1), 210-20(a).">Continua</span></th>
                <th data-col="nocontinua"><span class="ayuda" title="Capturar la carga que opera menos de 3 h. Aplicar 100 %.">No continua</span></th>
                <th data-col="fp"><span class="ayuda" title="Capturar el factor de potencia de la carga. Valor inicial: 0.9.&#10;&#10;Capturada en W: VA = W ÷ F.P. Modifica corriente, protección, conductor, caída de tensión y kW.&#10;&#10;Capturada en VA o A: modifica solo la caída de tensión (y el conductor, si excede el límite) y los kW — Tabla 9, nota 2.">F.P.</span></th>
                @foreach (var barra in Datos.Barras)
                {
                    <th class="col-fase"><span class="ayuda" title="Consultar la carga que el circuito asigna a la barra @barra."><span class="fase-rect fase-rect-@char.ToLowerInvariant(barra)">@barra</span></span></th>
                }
            </tr>
        </thead>
        <tbody>
            @*
                Los nones arriba y los pares abajo, separados por un renglón delgado — es como está
                armado el Excel (filas 34-54, una fila en blanco de 6 pt, y 56-76), y ahí NO hay
                ningún rótulo de "lado": el número de circuito dice de qué columna del gabinete es.

                Van en UNA sola tabla y no en dos, aunque se vean como dos bloques: dos tablas
                independientes calculan sus anchos de columna por separado, y los renglones de
                abajo no cuadrarían con los de arriba.

                UN MULTIPOLAR ES UN SOLO RENGLÓN ALTO. Sus celdas se combinan hacia abajo cubriendo
                los espacios que ocupa —así se VE que abarca tres—, menos la columna del número, que
                sigue renglón por renglón porque 1 / 3 / 5 es justo lo que se quiere leer. Misma
                decisión que el exportador de escritorio, tomada con esta misma queja: antes decía
                "↳ ocupado por el circuito 1" en cada espacio, y eso se LEE en vez de VERSE.
            *@
            @foreach (var (lado, indice) in Lados.Select((b, i) => (b, i)))
            {
                @if (indice > 0)
                {
                    <tr class="separador"><td colspan="@Columnas"></td></tr>
                }

                @foreach (var c in lado.Where(x => !x.EsContinuacion))
                {
                    @* El interruptor principal en espacios: un renglón que dice lo que es, sin captura (I-68). *@
                    if (c.EsDelPrincipal)
                    {
                        <tr class="fila-principal" data-espacio="@c.Espacio">
                            <td class="num asa" data-arrastre="@c.Espacio" data-destino="@c.Espacio" data-etiqueta="Interruptor principal" data-principal="1" title="Arrastrar para mover el interruptor principal, también al zócalo">@c.Espacio</td>
                            <td colspan="@(Columnas - 1)" rowspan="@Cuadro.EspaciosDelPrincipal.Count">
                                <strong>Interruptor principal</strong>@(Cuadro.InterruptorPrincipalA > 0m ? $" · {Cuadro.InterruptorPrincipalA:N0} A" : "") · @Polos(Datos.PolosDelPrincipal) · @(Datos.Barras.Count == 1 ? "alimenta la barra" : "alimenta las barras")
                            </td>
                        </tr>
                        @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                        {
                            <tr class="fila-principal"><td class="num asa" data-arrastre="@seguido.Espacio" data-destino="@seguido.Espacio" data-etiqueta="Interruptor principal" data-principal="1" title="Arrastrar para mover el interruptor principal, también al zócalo">@seguido.Espacio</td></tr>
                        }
                        continue;
                    }
                    <tr class="@(c.Resultado is null ? "vacio" : null)" data-espacio="@c.Espacio">
                        <td class="num @(c.TieneCaptura ? "asa" : null)" data-destino="@c.Espacio" data-arrastre="@(c.TieneCaptura ? c.Espacio : null)" data-etiqueta="@EtiquetaDeArrastre(c)" title="@(c.TieneCaptura ? "Arrastrar para mover el circuito a otro espacio" : null)">@c.Espacio</td>
                        <td rowspan="@c.Polos">
                            <div class="desc-linea">
                                <button class="desglosar" tabindex="-1" aria-label="Desglose del circuito @c.Espacio" aria-expanded="@(Abierto(c) ? "true" : "false")" title="Desglosar los aparatos que alimenta el circuito. La carga del circuito es la suma. Con el teclado: Ctrl+Enter."
                                        @onclick="() => AlternarDesglose(c)"><Icono Nombre="@(Abierto(c) ? "desglose-abierto" : "desglose")" Tamano="14" /></button>
                                <input class="desc" data-col="desc" aria-label="Circuito @c.Espacio · Descripción" @bind="c.Descripcion" @bind:event="oninput" placeholder="—" />
                            </div>
                            @if (c.TieneDesglose)
                            {
                                <span class="en-va izq">(@c.Aparatos.Sum(x => x.Cantidad) aparato@(c.Aparatos.Sum(x => x.Cantidad) == 1 ? "" : "s"))</span>
                            }
                        </td>
                        <td rowspan="@c.Polos">
                            <div class="tipo-uso">
                            @* El icono del tipo, solo en los renglones con carga: en los vacíos sería ruido (I-63). *@
                            <div class="tipo-con-icono">
                            @if (c.TieneCarga)
                            {
                                <Icono Nombre="@Icono.De(c.Categoria)" Tamano="16" Clase="icono-carga" />
                            }
                            else
                            {
                                <span class="icono-carga" aria-hidden="true"></span>
                            }
                            <select class="tipo" data-col="tipo" aria-label="Circuito @c.Espacio · Tipo" title="@c.Categoria.Descripcion()" @bind="c.Categoria" @bind:after="Recalcular">
                                @foreach (var categoria in Enum.GetValues<CategoriaDeCarga>()) { <option value="@categoria">@categoria.Nombre()</option> }
                            </select>
                            </div>
                            @* El uso solo cuenta en vivienda de más de 60 m² — 210-11(c), 220-52 (I-46). *@
                            @if (c.Tipo == TipoCarga.Contactos && Datos.Inmueble.AplicaUsoDeContactos())
                            {
                                <select class="tipo uso" data-col="uso" aria-label="Circuito @c.Espacio · Uso de los contactos" title="Seleccionar el uso del circuito de contactos. Cocina = aparatos pequeños (cocina, despensa, comedor, desayunador), lavadora y baño llevan 20 A — 210-11(c) — y solo esas salidas — 210-52(b)(2), 210-11(c)(2) y (3). Aparatos pequeños y lavadora cuentan 1500 VA en el alimentador — 220-52. Solo en vivienda; no en la popular de hasta 60 m² ni fuera de vivienda."
                                        @bind="c.Uso" @bind:after="Recalcular">
                                    @foreach (var uso in Enum.GetValues<UsoDeContactos>()) { <option value="@uso">@uso.NombreCorto()</option> }
                                </select>
                                @if (c.Ajuste220_52VA > 0m)
                                {
                                    <span class="en-va">Alimentador: 1,500 VA — @c.UsoEfectivo.ReferenciaCargaMinima()</span>
                                }
                            }
                            </div>
                        </td>
                        <td rowspan="@c.Polos">
                            <select class="unidad" data-col="unidad" aria-label="Circuito @c.Espacio · Unidad" @bind="c.Unidad" @bind:after="Recalcular" disabled="@c.TieneDesglose" title="@SumaDelDesglose(c)">
                                <option value="@UnidadConsumo.VoltAmperes">VA</option>
                                <option value="@UnidadConsumo.Watts">W</option>
                                <option value="@UnidadConsumo.Amperes">A</option>
                            </select>
                        </td>
                        <td rowspan="@c.Polos">
                            <input class="va" type="number" min="0" placeholder="0" data-col="continua" aria-label="Circuito @c.Espacio · Continua" value="@Carga(c.Continua)" @onchange="e => { c.Continua = LeerCarga(e, c.Continua); Recalcular(); }"
                                   disabled="@c.TieneDesglose" title="@SumaDelDesglose(c)" />
                            @EnVA(c, c.Continua, c.ContinuaVA)
                        </td>
                        <td rowspan="@c.Polos">
                            <input class="va" type="number" min="0" placeholder="0" data-col="nocontinua" aria-label="Circuito @c.Espacio · No continua" value="@Carga(c.NoContinua)" @onchange="e => { c.NoContinua = LeerCarga(e, c.NoContinua); Recalcular(); }"
                                   disabled="@(c.TieneDesglose || c.Categoria == CategoriaDeCarga.CalefaccionFija)"
                                   title="@(c.Categoria == CategoriaDeCarga.CalefaccionFija ? "Calefacción fija: carga continua — 424-3(b)." : SumaDelDesglose(c))" />
                            @EnVA(c, c.NoContinua, c.NoContinuaVA)
                        </td>
                        <td rowspan="@c.Polos"><input data-requerido data-col="fp" aria-label="Circuito @c.Espacio · F.P." class="va fp" type="number" min="0.1" max="1" step="0.05" title="@(c.TieneDesglose ? "F.P. combinado de los aparatos: P ÷ √(P² + Q²)." : AyudaFactorPotencia(c))" value="@Factor(c.FactorPotencia)" @onchange="e => { c.FactorPotencia = Leer(e, c.FactorPotencia); Recalcular(); }" disabled="@c.TieneDesglose" /></td>
                        @foreach (var barra in Datos.Barras)
                        {
                            <td rowspan="@c.Polos" class="num tenue col-fase">@(c.TieneCarga && c.Fases.Contains(barra) ? c.CargaPorFaseVA.ToString("#,0.##") : "")</td>
                        }
                        <td rowspan="@c.Polos"><input data-requerido class="va corto" type="number" min="0" data-col="l" aria-label="Circuito @c.Espacio · Longitud (m)" value="@Numero(c.LongitudM)" @onchange="e => { c.LongitudM = Leer(e, c.LongitudM); Recalcular(); }" /></td>
                        <td rowspan="@c.Polos" class="canal">
                            <select class="canal" data-col="canal" aria-label="Circuito @c.Espacio · Canalización" value="@(c.Canalizacion ?? "")" @onchange="e => CambiarCanalizacion(c, e.Value?.ToString())">
                                @if (!c.TieneCarga)
                                {
                                    <option value="">—</option>
                                }
                                @* @key: al quitarse un tubo de la lista, Blazor reutilizaba las opciones por posición y la
                                   seleccionada pasaba a decir otro tubo; el circuito seguía en el suyo (I-45). *@
                                @foreach (var t in Datos.Canalizaciones) { <option @key="t.Id" value="@t.Id">@t.Nombre</option> }
                                @if (!c.TieneCarga || c.CanalizacionEfectiva?.Circuitos.Count > 1)
                                {
                                    <option value="+">+ Nueva</option>
                                }
                            </select>
                            @if (c.TieneCarga && c.CanalizacionEfectiva is { } canal)
                            {
                                <span class="en-va">@canal.TamanoRotulo</span>
                            }
                        </td>
                        <td rowspan="@c.Polos">
                            <select class="polos" data-col="polos" aria-label="Circuito @c.Espacio · Polos" value="@c.Polos"
                                    @onchange="e => CambiarPolos(c, e.Value?.ToString())">
                                @foreach (var p in Enumerable.Range(1, Datos.MaximoPolos)) { <option value="@p">@p</option> }
                            </select>
                            @if (c.Polos > 1 && TieneNeutro)
                            {
                                <label class="mas-n" title="Marcar si la carga es F-N (220/127 V) y el circuito lleva neutro. En 2 fases + neutro de estrella el neutro cuenta como portador — 310-15(b)(5)(2).">
                                    <input type="checkbox" data-col="masn" aria-label="Circuito @c.Espacio · Con neutro" checked="@c.ConNeutro" @onchange="e => { c.ConNeutro = e.Value is true; Recalcular(); }" />+N</label>
                            }
                        </td>
                        <td rowspan="@c.Polos" class="fase">
                            @foreach (var barra in c.Fases)
                            {
                                <span class="fase-rect fase-rect-@char.ToLowerInvariant(barra)">@barra</span>
                            }
                        </td>
                        <td rowspan="@c.Polos" class="num">@c.Resultado?.CorrienteDisenoA.ToString("N2")</td>
                        @{ var desglose = Cuadro.Desglose(c); }
                        <td rowspan="@c.Polos" class="num">@Ayuda(c.Resultado?.ProteccionA.ToString("N0"), desglose?.Proteccion)</td>
                        @Conductor(c.Resultado?.CalibreFase, c.Resultado?.NumeroConductoresParalelo ?? 0, c.Polos, desglose?.Conductor)
                        @Conductor(c.Resultado?.CalibreNeutro, c.Resultado is null ? 0 : 1, c.Polos, sinConductor: c.Resultado is not null && !c.LlevaNeutro)
                        @Conductor(c.Resultado?.CalibreTierra, c.Resultado is null ? 0 : 1, c.Polos)
                        <td rowspan="@c.Polos" class="num ultima @(Excede(c) ? "excede" : null)">@c.Resultado?.CaidaTensionPct.ToString("N2")</td>
                    </tr>

                    @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                    {
                        <tr class="@(c.Resultado is null ? "vacio" : null)">
                            <td class="num @(c.TieneCaptura ? "asa" : null)" data-destino="@seguido.Espacio" data-arrastre="@(c.TieneCaptura ? seguido.Espacio : null)" data-etiqueta="@EtiquetaDeArrastre(c)">@seguido.Espacio</td>
                        </tr>
                    }

                    @if (c.Error is not null || _motivo.TryGetValue(c.Espacio, out _))
                    {
                        <tr class="fila-error">
                            <td></td>
                            <td colspan="@(Columnas - 1)">@(c.Error ?? _motivo[c.Espacio])</td>
                        </tr>
                    }

                    @*
                        EL DESGLOSE VA DESPUÉS DEL ÚLTIMO ESPACIO DEL CIRCUITO, en un renglón que ocupa todo
                        el ancho: nunca entre los espacios de un multipolar, y sin mover ninguna columna.
                    *@
                    @if (Abierto(c))
                    {
                        var calefaccion = c.Categoria == CategoriaDeCarga.CalefaccionFija;
                        <tr class="fila-desglose">
                            <td></td>
                            <td colspan="@(Columnas - 1)">
                                <table class="desglose" data-circuito="@c.Espacio">
                                    <thead>
                                        <tr>
                                            <th class="izq" data-col="ap-desc">Aparato del circuito @c.Espacio</th>
                                            <th data-col="ap-cant">Cant.</th>
                                            <th data-col="ap-unidad">Unidad</th>
                                            <th data-col="ap-carga">Carga c/u</th>
                                            <th data-col="ap-continua"><span class="ayuda" title="Opera 3 h o más: 125 % — 210-19(a)(1). Calefacción: siempre — 424-3(b).">Continua</span></th>
                                            <th data-col="ap-fp">F.P.</th>
                                            <th>Total <span class="simbolo">(VA)</span></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (aparato, n) in c.Aparatos.Select((a, i) => (a, i + 1)))
                                        {
                                            <tr>
                                                <td class="izq"><input class="desc" data-col="ap-desc" aria-label="Circuito @c.Espacio, aparato @n · Descripción" @bind="aparato.Descripcion" @bind:after="Recalcular" placeholder="Aparato (Contacto: 180 VA)" /></td>
                                                <td><input data-requerido data-col="ap-cant" aria-label="Circuito @c.Espacio, aparato @n · Cantidad" class="va corto" type="number" min="1" step="1" @bind="aparato.Cantidad" @bind:after="Recalcular" /></td>
                                                <td>
                                                    <select class="unidad" data-col="ap-unidad" aria-label="Circuito @c.Espacio, aparato @n · Unidad" @bind="aparato.Unidad" @bind:after="Recalcular">
                                                        <option value="@UnidadConsumo.VoltAmperes">VA</option>
                                                        <option value="@UnidadConsumo.Watts">W</option>
                                                        <option value="@UnidadConsumo.Amperes">A</option>
                                                    </select>
                                                </td>
                                                <td><input class="va" type="number" min="0" placeholder="0" data-col="ap-carga" aria-label="Circuito @c.Espacio, aparato @n · Carga c/u" value="@Carga(aparato.CargaUnitaria)" @onchange="e => { aparato.CargaUnitaria = LeerCarga(e, aparato.CargaUnitaria); Recalcular(); }" /></td>
                                                <td><input type="checkbox" data-col="ap-continua" aria-label="Circuito @c.Espacio, aparato @n · Continua" @bind="aparato.Continua" @bind:after="Recalcular" disabled="@calefaccion" /></td>
                                                <td><input data-requerido class="va fp" type="number" min="0.1" max="1" step="0.05" data-col="ap-fp" aria-label="Circuito @c.Espacio, aparato @n · F.P." value="@Factor(aparato.FactorPotencia)" @onchange="e => { aparato.FactorPotencia = Leer(e, aparato.FactorPotencia); Recalcular(); }" /></td>
                                                <td class="num">@aparato.TotalVA.ToString("#,0.##")</td>
                                                <td><button class="quitar" title="Quitar el aparato" aria-label="Quitar el aparato @n del circuito @c.Espacio" @onclick="() => QuitarAparato(c, aparato, n)"><Icono Nombre="quitar" Tamano="14" /></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td class="izq"><button class="agregar" data-agregar="@c.Espacio" @onclick="() => AgregarAparato(c)"><Icono Nombre="agregar" Tamano="14" />Agregar aparato</button></td>
                                            <td colspan="7" class="num">
                                                @if (c.TieneDesglose)
                                                {
                                                    <text>Total: continua @c.ContinuaVA.ToString("#,0.##") · no continua @c.NoContinuaVA.ToString("#,0.##") VA · F.P. @c.FactorPotencia.ToString("N2")</text>
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</section>

@*
    CANALIZACIONES — decisión canalizaciones-y-agrupamiento (2026-09-24). Se captura qué circuitos van
    juntos (columna «Canal.») y aquí sale lo demás: portadores, factor de agrupamiento según el tipo
    de canalización y tamaño (Capítulo 10). Una sola lista: cada circuito con carga nace en la suya;
    todas nacen como tubo EMT y se configuran en su renglón (David, 2026-09-24).
*@
<section class="tarjeta canalizaciones" id="sec-canalizaciones">
    <div class="encabezado-tarjeta">
        <h2>Canalizaciones</h2>
        <button class="boton con-icono" id="nueva-canalizacion" @onclick="NuevaCanalizacion"><Icono Nombre="agregar" Clase="boton-icono" />Nueva canalización</button>
    </div>

    @* Una sola lista de tubos: por omisión cada circuito con carga recibe el suyo (T1, T2…) y en la
       columna «Canal.» del cuadro se elige de la lista (David, 2026-09-24). Una fila por canalización,
       sin plegar: la tabla crece con el tablero. Las opciones van en columnas, no apiladas. *@
    <h3 class="subtitulo-canal">Circuitos derivados</h3>
    <div class="desplazable">
    <table class="cuadro canal-tabla">
        <thead>
            <tr>
                <th rowspan="2" data-col="cn-nombre"><span class="ayuda" title="El nombre con el que aparece en la columna «Canal.» del cuadro, en el documento y en la memoria. Nace T1, T2…; editable: «Tubo pasillo», «Bajada cocina». Borrado, regresa a su número.">Nombre</span></th>
                <th rowspan="2" data-col="cn-tipo cn-tubo cn-ancho cn-alto cn-area cn-max"><span class="ayuda" title="Toda canalización nace como tubo conduit EMT; se decide en cada una. En tubo, el bloque de la Tabla 4. Ductos y canales: medidas interiores (20 % — 376-22, 378-22, 366-22). Superficiales: área interior y número de conductores del fabricante (386-22, 388-22).">Tipo</span></th>
                <th rowspan="2"><span class="ayuda" title="Los circuitos que van por esta canalización. Cada circuito con carga nace en la suya; se cambia en la columna «Canal.» del cuadro.">Circuitos</span></th>
                <th colspan="3"><span class="ayuda" title="Cuántos conductores de cada uno van en la canalización. Para el llenado cuentan todos — Nota 3 del Capítulo 10.">Conductores</span></th>
                @EncabezadoCalculo()
                <th colspan="4">Opciones</th>
            </tr>
            <tr>
                <th>Fase</th><th>Neutro</th><th>Tierra</th>
                <th><span class="simbolo">mm</span></th><th><span class="simbolo">in</span></th>
                <th class="dos-lineas" data-col="cn-neutro"><span class="ayuda" title="Los circuitos de 1 polo de esta canalización, en barras distintas, comparten un solo neutro: circuito multiconductor — 210-4. Baja los portadores, pero exige que los interruptores desconecten juntos — 210-4(b). Solo con dos o más circuitos.">Neutro comp.</span></th>
                <th class="dos-lineas" data-col="cn-tierra"><span class="ayuda" title="Una sola tierra para todos los circuitos de la canalización, del calibre que pide la protección mayor — 250-122(c). Menos conductores, tubo más chico. Solo con dos o más circuitos.">Tierra común</span></th>
                @EncabezadoTierraDesnuda()
                @EncabezadoAzotea()
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Datos.Canalizaciones)
            {
                @FilaCanal(t)
            }
            @if (Datos.Canalizaciones.Count == 0)
            {
                <tr><td colspan="16" class="ultima vacia">Captura la carga de algún circuito y aquí sale su canalización.</td></tr>
            }
        </tbody>
    </table>
    </div>

    <h3 class="subtitulo-canal">Alimentador</h3>
    <div class="desplazable">
    <table class="cuadro canal-tabla">
        <thead>
            <tr>
                <th rowspan="2" data-col="cn-tipo cn-tubo cn-ancho cn-alto cn-area cn-max"><span class="ayuda" title="La canalización del alimentador, que va sola: no hereda el agrupamiento de los derivados. Nace como tubo conduit EMT.">Tipo</span></th>
                <th colspan="3">Conductores</th>
                @EncabezadoCalculo()
                <th colspan="3">Opciones</th>
            </tr>
            <tr>
                <th>Fase</th><th>Neutro</th><th>Tierra</th>
                <th><span class="simbolo">mm</span></th><th><span class="simbolo">in</span></th>
                @EncabezadoTierraDesnuda()
                @EncabezadoAzotea()
                <th class="dos-lineas" data-col="cn-paralelos"><span class="ayuda" title="Solo si el alimentador sale con conductores en paralelo: todos los juegos en una sola canalización, y cada conductor cuenta como portador — 310-15(b)(3)(a). Sin marcar: un juego por canalización, todas iguales — 310-10(h)(3).">Paralelos en un tubo</span></th>
            </tr>
        </thead>
        <tbody>
            @FilaCanal(Datos.CanalizacionAlimentador, alimentador: true)
        </tbody>
    </table>
    </div>

    @{ var sinDiametro = DesignacionesSinDiametro(); }
    @if (sinDiametro.Count > 0 || Datos.DiametrosFabricante.Keys.Any(k => k.StartsWith(Datos.TipoAislamiento + "|")))
    {
        <div class="fabricante">
            <h2 class="separado"><span class="ayuda" title="El aislamiento @Datos.TipoAislamiento no está en la Tabla 5 del Capítulo 10: el llenado se calcula con el diámetro exterior real del fabricante — Nota 5.">Diámetro exterior del fabricante · @Datos.TipoAislamiento</span></h2>
            @foreach (var designacion in DesignacionesEnUso())
            {
                var clave = DatosDelTablero.ClaveDiametro(Datos.TipoAislamiento, designacion);
                <label class="suelto">@Calibre.UnidadDe(designacion) (mm)
                    <input type="number" min="0" step="0.01" value="@(Datos.DiametrosFabricante.TryGetValue(clave, out var d) ? Numero(d) : "")"
                           @onchange="e => CambiarDiametro(clave, e.Value?.ToString())" />
                </label>
            }
        </div>
    }
</section>

@if (_aviso is { } flotante)
{
    <div class="aviso-flotante @flotante.Clase" role="status" aria-live="polite">
        <span>@flotante.Texto</span>
        @if (flotante.Clase == "bien" && Cuadro.PuedeDeshacer)
        {
            <button class="boton" @onclick="DeshacerMovimiento">Deshacer</button>
        }
    </div>
}

<div class="cierre">
    @*
        El interior del tablero: la tapa muerta con las barras en multifilar, los interruptores a sus
        lados y el directorio afuera — Layout/InteriorDelGabinete.razor (I-67).
    *@
    <section class="tarjeta">
        <div class="encabezado-tarjeta">
            <h2>Gabinete · convención NEMA · @Datos.EtiquetaSistema</h2>
            @if (Cuadro.PuedeDeshacer)
            {
                <button class="boton con-icono" @onclick="DeshacerMovimiento" title="Regresar al acomodo de antes del último movimiento u optimización"><Icono Nombre="deshacer" Clase="boton-icono" />Deshacer movimiento</button>
            }
        </div>
        <p class="derivado sin-margen">
            <strong>@Cuadro.EspaciosOcupados</strong> de @Datos.NumeroEspacios espacios ocupados ·
            @Cuadro.EspaciosLibres libres
        </p>

        <InteriorDelGabinete Cuadro="Cuadro" />
    </section>

    <div class="columna">
    <section class="tarjeta" id="sec-resumen">
        <h2>Resumen de carga</h2>
        <table class="datos resumen">
            <tr>
                <th class="izq">Tipo de carga</th><th>Instalada <span class="simbolo">(kVA)</span></th><th data-col="fd" title="Factor de demanda del tipo de carga — Art. 220. Enter baja al siguiente.">F.D.</th><th>Demandada <span class="simbolo">(kVA)</span></th>
            </tr>
            @foreach (var fila in Cuadro.Resumen.PorCategoria ?? [])
            {
                <tr>
                    <td class="izq"><span class="con-icono-carga"><Icono Nombre="@Icono.De(fila.Categoria)" Tamano="16" />@fila.Categoria.NombreCompleto()</span></td>
                    <td class="num">@((fila.InstaladaVA / 1000m).ToString("N2"))</td>
                    <td class="num">
                        <input data-requerido data-col="fd" aria-label="F.D. · @fila.Categoria.NombreCompleto()" class="va chico" type="number" min="0" max="1" step="0.05"
                               value="@Factor(fila.FactorDemanda)"
                               @onchange="e => CambiarFactor(fila.Categoria, e)" />
                    </td>
                    <td class="num">@((fila.DemandadaVA / 1000m).ToString("N2"))</td>
                </tr>
            }
            @if (Cuadro.Resumen.Minimo220_52VA > 0m)
            {
                <tr>
                    <td class="izq"><span class="ayuda" title="Completar a 1500 VA cada circuito de aparatos pequeños o de lavadora — 220-52(a) y (b). Carga de alimentador; no cambia el derivado. Lleva el F.D. de contactos.">Mínimo 220-52</span></td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52VA / 1000m).ToString("N2"))</td>
                    <td class="num">@Factor(Datos.FactorDemandaContactos)</td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52DemandadoVA / 1000m).ToString("N2"))</td>
                </tr>
            }
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kVA)</span></td>
                <td class="num">@((Cuadro.Resumen.CalculadaVA / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kW)</span></td>
                <td class="num">@((Cuadro.Resumen.InstaladaW / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaW / 1000m).ToString("N2"))</td>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar el factor de potencia de la carga instalada: kW totales ÷ suma vectorial de kVA. El del alimentador, con el que se calcula la caída, lleva además el factor de demanda.">F.P. resultante</span></td>
                <td class="num">@Cuadro.Resumen.FactorPotencia.ToString("N2")</td>
                <td></td><td></td>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar la carga continua y la no continua. La continua entra al 125 % en el alimentador — 215-2(a)(1), 215-3.">Continua / no continua</span></td>
                <td class="num">@((Cuadro.Resumen.ContinuaVA / 1000m).ToString("N2")) / @((Cuadro.Resumen.NoContinuaVA / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.ContinuaDemandadaVA / 1000m).ToString("N2")) / @(((Cuadro.Resumen.NoContinuaDemandadaVA + Cuadro.Resumen.Minimo220_52DemandadoVA) / 1000m).ToString("N2"))</td>
            </tr>
        </table>

        @if (Datos.ReduceCargaPorDemanda)
        {
            <h2 class="separado"><span class="ayuda" title="Seleccionar, para cada tipo con F.D. menor que 1, la tabla o sección del Art. 220 que lo sustenta. Se imprime en la memoria del alimentador — 220-40.">Justificación del F.D.</span></h2>
            @foreach (var categoria in CategoriasDeCarga.Todas.Where(c => Datos.FactorDeDemanda(c) < 1m))
            {
                <div class="justificaciones">
                    <strong>@categoria.NombreCompleto() · F.D. @Datos.FactorDeDemanda(categoria).ToString("N2")</strong>
                    @foreach (var j in categoria.JustificacionesPosibles(Datos.Inmueble))
                    {
                        <label><input type="checkbox" checked="@Datos.Justificaciones[categoria].Contains(j)" @onchange="e => Justificar(categoria, j, e)" /> @j.Nombre()</label>
                    }
                    @if (Datos.Justificaciones[categoria].Contains(JustificacionFactorDemanda.Otra))
                    {
                        <input class="otra" placeholder="Describir el criterio" value="@Datos.JustificacionOtra[categoria]"
                               @oninput="e => { Datos.JustificacionOtra[categoria] = e.Value?.ToString() ?? string.Empty; Recalcular(); }" />
                    }
                </div>
            }
        }

    </section>

    @* Balanceo en su propia tarjeta, con barras de los colores de fase (David, 2026-09-24). La barra
       más cargada llena la pista; las demás, en proporción. *@
    <section class="tarjeta balanceo">
        <div class="encabezado-tarjeta">
            <h2>Balanceo de fases</h2>
            @if (Datos.Barras.Count > 1)
            {
                <button class="boton" @onclick="OptimizarAcomodo" title="Reacomodar los circuitos para el menor desbalanceo, moviendo los menos posibles. Se puede deshacer.">Optimizar acomodo</button>
            }
        </div>
        @{ var mayor = Datos.Barras.Max(b => Cuadro.Resumen.CargaPorFaseVA[b]); }
        @foreach (var barra in Datos.Barras)
        {
            var va = Cuadro.Resumen.CargaPorFaseVA[barra];
            var ancho = mayor > 0m ? va * 100m / mayor : 0m;
            <div class="fila-fase">
                <span class="fase-rect fase-rect-@char.ToLowerInvariant(barra)">@barra</span>
                <div class="pista"><div class="relleno color-@char.ToLowerInvariant(barra)" style="width: @ancho.ToString("0.#", CultureInfo.InvariantCulture)%"></div></div>
                <span class="num fuerte">@va.ToString("#,0.##") VA</span>
            </div>
        }
        <div class="desbalanceo">
            <span>Desbalanceo</span>
            <strong class="num">@Cuadro.Resumen.DesbalanceoPct.ToString("N1") %</strong>
        </div>
    </section>
    </div>

    @*
        Lo primero que se ve es la protección seleccionada, y luego los conductores con el color de su
        forro (David, 2026-09-24). El cálculo que lleva a ellos va abajo; los avisos, en su tarjeta.
    *@
    <section class="tarjeta alimentador" id="sec-alimentador">
        <h2>Alimentador y protección principal</h2>

        @if (Cuadro.Alimentador.Resultado is { } a)
        {
            <div class="seleccion">
                <span class="rotulo">@(Datos.UsaInterruptorPrincipal ? "Interruptor principal" : "Protección del lado de alimentación")</span>
                <span class="valor">@Ayuda($"{a.ProteccionA:N0} A", Cuadro.DesgloseDelAlimentador()?.Proteccion) <span class="polos">· @Polos(Cuadro.Alimentador.Polos)</span></span>
            </div>

            <div class="cables">
                <div class="cable">
                    <span class="muestras grande">@foreach (var barra in Datos.Barras) { <i class="color-@char.ToLowerInvariant(barra)"></i> }</span>
                    <span class="rotulo">Fase</span>
                    <span class="calibre">@Ayuda(ConHilos(a.CalibreFase, a.NumeroConductoresParalelo), Cuadro.DesgloseDelAlimentador()?.Conductor)<small>@a.CalibreFase.AreaMm2.ToString("N2") mm²</small></span>
                </div>
                <div class="cable">
                    <span class="muestras grande"><i class="color-neutro"></i></span>
                    <span class="rotulo"><span class="ayuda" title="Consultar el conductor de neutro: mismo calibre que la fase. En 2 fases + neutro de estrella lleva ≈ la corriente de fase: contarlo en «Agrupados» — 310-15(b)(5)(2); no reducirlo — 220-61(c)(1). Blanco o gris claro — 200-6.">Neutro</span></span>
                    <span class="calibre">@ConHilos(a.CalibreNeutro, a.NumeroConductoresParalelo)<small>@a.CalibreNeutro.AreaMm2.ToString("N2") mm²</small></span>
                </div>
                <div class="cable">
                    <span class="muestras grande"><i class="color-tierra"></i></span>
                    <span class="rotulo"><span class="ayuda" title="Consultar el conductor de puesta a tierra de equipos — Tabla 250-122. Verde, o verde con franjas amarillas — 250-119.">Puesta a tierra</span></span>
                    <span class="calibre">@a.CalibreTierra.DesignacionConUnidad<small>@a.CalibreTierra.AreaMm2.ToString("N2") mm²</small></span>
                </div>
            </div>

            <p class="derivado">Canalización: <strong>@Datos.CanalizacionAlimentador.Rotulo · @Datos.CanalizacionAlimentador.TamanoRotulo</strong> · @(Datos.CanalizacionAlimentador.Conteo?.Portadores) portadores — ver «Canalizaciones».</p>

            <label class="suelto">Longitud del alimentador (m)
                <input data-requerido type="number" min="0" step="1" value="@Numero(Datos.LongitudAlimentadorM)" @onchange="e => { Datos.LongitudAlimentadorM = Leer(e, Datos.LongitudAlimentadorM); Recalcular(); }" />
            </label>
            <table class="datos">
                @if (Cuadro.Alimentador.Gobierna is { } g && Datos.Barras.Count > 1)
                {
                    <tr>
                        <td class="izq"><span class="ayuda" title="Consultar la fase de mayor capacidad requerida (125 % continua + no continua). Dimensiona el alimentador — 215-2(a)(1), 215-3.">Fase que gobierna</span></td>
                        <td class="num">@g.Fase, la más cargada</td>
                    </tr>
                }
                <tr><td class="izq"><span class="ayuda" title="Consultar la corriente con la que se dimensionan la protección y el conductor: los VA demandados sumados directamente, entre la tensión. La caída de tensión usa la suma fasorial, que puede ser un poco menor.">Corriente de diseño</span></td><td class="num">@a.CorrienteDisenoA.ToString("N2") A</td></tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar el factor de potencia de las cargas de la fase que gobierna, con su factor de demanda y el mínimo de 220-52: el de la corriente con la que se calcula la caída de tensión del alimentador.">Factor de potencia</span></td>
                    <td class="num">@Cuadro.Alimentador.FactorPotencia.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar la caída de tensión del alimentador: la de la peor fase, con la caída del neutro — Tabla 9. Pasar el cursor sobre el valor para consultar cada fase. Recomendado: 3 % en el alimentador y 5 % combinada con el derivado — 215-2(a)(4), NOTA 2.">Caída de tensión</span></td>
                    <td class="num @(a.CaidaTensionPct > Datos.CaidaMaxAlimentadorPct ? "excede" : null)">@Ayuda(CaidaDelAlimentador(a), CaidaPorFase(a))</td>
                </tr>
                @* En 1F-2H el neutro lleva la corriente de la fase: un renglón aparte decía otro número (I-47). *@
                @if (a.CorrienteNeutro is { } neutro && SistemaDelTablero.De(Datos.Sistema) != ConfiguracionTablero.UnaFaseDosHilos)
                {
                    <tr><td class="izq"><span class="ayuda" title="Consultar la corriente del neutro: suma fasorial de las corrientes de fase. Entra a la caída de tensión.">Corriente de neutro</span></td><td class="num">@neutro.Magnitud.ToString("N2") A</td></tr>
                }
            </table>
        }
        else
        {
            <label class="suelto">Longitud del alimentador (m)
                <input data-requerido type="number" min="0" step="1" value="@Numero(Datos.LongitudAlimentadorM)" @onchange="e => { Datos.LongitudAlimentadorM = Leer(e, Datos.LongitudAlimentadorM); Recalcular(); }" />
            </label>
            @if (Cuadro.Alimentador.Error is { } error)
            {
                <p class="aviso error"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@error</span></p>
            }
            else
            {
                <p class="derivado">Captura la carga de algún circuito y aquí sale el alimentador.</p>
            }
        }
    </section>
</div>

@*
    TODOS LOS AVISOS DEL CÁLCULO, en una tarjeta al final (David, 2026-09-24): los del principal y los
    de caída combinada. Van después de los resultados porque salen de ellos: se capturan los
    circuitos, se revisa el cierre y aquí queda lo que hay que atender. Dentro del cuadro partían los
    circuitos; dentro de la tarjeta del alimentador la amontonaban.
*@
@if (Cuadro.Alimentador.Resultado is not null && Cuadro.Alimentador.Avisos.Any() || Cuadro.ConCaidaCombinadaExcedida.Any() || Cuadro.AvisosDeCanalizaciones.Any())
{
    <section class="tarjeta avisos">
        <h2>Avisos</h2>
        @if (Cuadro.Alimentador.Resultado is not null)
        {
            @foreach (var aviso in Cuadro.Alimentador.Avisos)
            {
                <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@aviso</span></p>
            }
        }
        @foreach (var c in Cuadro.ConCaidaCombinadaExcedida)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@c.AvisoCaidaCombinada</span></p>
        }
        @foreach (var aviso in Cuadro.AvisosDeCanalizaciones)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@aviso</span></p>
        }
    </section>
}

<footer class="pie">
    Tablas leídas de
    <a href="https://github.com/dflores296/NOM-001-SEDE-2012">NOM-001-SEDE-2012</a>,
    verificadas celda por celda contra el PDF del DOF.
    Tabla 8 verificada el @Motor.Fuente.VerificadaEl("8").
    <strong>Los resultados no sustituyen el criterio del ingeniero responsable.</strong>
</footer>

@code {
    /// <summary>Por circuito, el motivo por el que no se pudo cambiar de polos. Se borra al siguiente intento.</summary>
    private readonly Dictionary<int, string> _motivo = [];

    private CuadroDeCarga Cuadro => Proyecto.Cuadro;
    private DatosDelTablero Datos => Cuadro.Datos;

    private void Recalcular() => Cuadro.Recalcular();

    // ---- Mover circuitos y optimizar el acomodo (I-69) -------------------------------------------

    private DotNetObjectReference<Captura>? _arrastre;

    /// <summary>Lo que dice el fantasma mientras se arrastra: «7 · Alumbrado planta baja».</summary>
    private static string? EtiquetaDeArrastre(CircuitoDelCuadro c) =>
        !c.TieneCaptura ? null
        : string.IsNullOrWhiteSpace(c.Descripcion) ? $"Circuito {c.Espacio}" : $"{c.Espacio} · {c.Descripcion.Trim()}";

    /// <summary>Lo llama js/arrastre.js al soltar un interruptor sobre un espacio.</summary>
    [JSInvokable]
    public void Soltar(int origen, int destino)
    {
        var r = Cuadro.MoverCircuito(origen, destino);
        if (r.Mensaje is { } mensaje)
            Avisar(mensaje, r.Movio);
        StateHasChanged();
    }

    private void OptimizarAcomodo()
    {
        var p = Cuadro.OptimizarBalanceo();
        if (p.Mejora)
        {
            var movs = string.Join(" · ", p.Movimientos.Select(m => $"{m.De} → {m.A}"));
            Avisar($"Desbalanceo de {p.DesbalanceoAntesPct:N1} % a {p.DesbalanceoDespuesPct:N1} %: " +
                   $"{(p.Movimientos.Count == 1 ? "se movió 1 circuito" : $"se movieron {p.Movimientos.Count} circuitos")} ({movs}).", true);
        }
        else
            Avisar(p.DesbalanceoAntesPct == 0m
                ? "No hay desbalanceo que corregir."
                : "El acomodo ya tiene el menor desbalanceo que se alcanza moviendo circuitos.", false, neutro: true);
    }

    private void DeshacerMovimiento()
    {
        Cuadro.Deshacer();
        Avisar("Se deshizo el último movimiento.", true);
    }

    // El aviso temporal: arriba, debajo de la barra, y se va solo.
    private (string Texto, string Clase, int Id)? _aviso;
    private int _avisos;

    private void Avisar(string texto, bool bien, bool neutro = false)
    {
        var id = ++_avisos;
        _aviso = (texto, neutro ? "neutro" : bien ? "bien" : "mal", id);
        _ = Task.Delay(bien || neutro ? 4500 : 5500).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_aviso?.Id == id)
            {
                _aviso = null;
                StateHasChanged();
            }
        }));
    }

    private void CambiarEspacioDelPrincipal(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var espacio))
            Datos.EspacioDelPrincipal = espacio;
        Recalcular();
    }

    private void NuevaCanalizacion()
    {
        var nueva = Datos.NuevaCanalizacion();
        Recalcular();
        _enfocar = $"tr[data-canal=\"{nueva.Id}\"] input[data-col=\"cn-nombre\"]";
    }

    /// <summary>Quita una canalización y deja el foco en la que queda en su lugar, o en «+ Nueva canalización».</summary>
    private void QuitarCanalizacion(CanalizacionDelTablero t)
    {
        var i = Datos.Canalizaciones.IndexOf(t);
        Cuadro.QuitarCanalizacion(t);
        var siguiente = Datos.Canalizaciones.ElementAtOrDefault(Math.Min(i, Datos.Canalizaciones.Count - 1));
        _enfocar = siguiente is null ? "#nueva-canalizacion" : $"tr[data-canal=\"{siguiente.Id}\"] input[data-col=\"cn-nombre\"]";
    }

    // ---- FOCO DESPUÉS DE UNA ACCIÓN (I-56) ---------------------------------------------------------
    // Lo que se acaba de crear o abrir recibe el foco: antes se quedaba en el botón y había que
    // buscarlo con el ratón. Se aplica al terminar de dibujar, cuando el elemento ya existe.

    private string? _enfocar;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _arrastre = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("powerNode.arrastre.conectar", _arrastre);
        }
        if (_enfocar is { } selector)
        {
            _enfocar = null;
            await JS.InvokeVoidAsync("powerNode.enfocar", selector);
        }
        // Con cambios sin guardar, el navegador pregunta antes de cerrar la pestaña (I-05).
        await JS.InvokeVoidAsync("powerNode.archivo.marcarSinGuardar", Proyecto.SinGuardar);
    }

    // Al abrir un archivo, el tablero es otro: se dibuja de nuevo, sin desgloses abiertos del anterior.
    protected override void OnInitialized() => Proyecto.Cambio += AlAbrirOtroTablero;

    private void AlAbrirOtroTablero()
    {
        _desgloseAbierto.Clear();
        StateHasChanged();
    }

    public void Dispose()
    {
        Proyecto.Cambio -= AlAbrirOtroTablero;
        _ = JS.InvokeVoidAsync("powerNode.arrastre.desconectar").AsTask();
        _arrastre?.Dispose();
    }

    private static string DescripcionDeAparato(int espacio, int n) =>
        $"table.desglose[data-circuito=\"{espacio}\"] > tbody > tr:nth-child({n}) input[data-col=\"ap-desc\"]";

    private static string AgregarDe(int espacio) => $"button[data-agregar=\"{espacio}\"]";

    private void CambiarDiametro(string clave, string? valor)
    {
        if (decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d > 0m)
            Datos.DiametrosFabricante[clave] = d;
        else
            Datos.DiametrosFabricante.Remove(clave);
        Recalcular();
    }

    /// <summary>Los calibres aislados que se usan en alguna canalización, de menor a mayor.</summary>
    private List<string> DesignacionesEnUso() =>
        Cuadro.TodasLasCanalizaciones
            .SelectMany(t => t.Ocupacion?.Renglones ?? [])
            .Where(r => r.Conductor.TipoAislamiento is not null)
            .Select(r => r.Conductor.Designacion)
            .Distinct()
            .OrderBy(d => Motor.Calibres.BuscarPorDesignacion(d)?.AreaMm2 ?? 0m)
            .ToList();

    private List<string> DesignacionesSinDiametro() =>
        Cuadro.TodasLasCanalizaciones.SelectMany(t => t.Ocupacion?.Faltantes ?? []).Distinct().ToList();

    private static string Opcional(decimal? v) => v is { } x ? Numero(x) : "";

    /// <summary>Una carga: el 0 no se escribe, se ve como marca de agua — teclear 5 sobre un «0» daba «50» (I-55).</summary>
    private static string Carga(decimal v) => v == 0m ? "" : Numero(v);

    /// <summary>Una carga capturada: vacía es 0 — cortar el valor dejaba el anterior en el cálculo (I-55).</summary>
    private static decimal LeerCarga(ChangeEventArgs e, decimal actual) =>
        string.IsNullOrWhiteSpace(e.Value?.ToString()) ? 0m : Leer(e, actual);

    /// <summary>
    /// Un número capturable, como se muestra: hasta dos decimales, sin ceros de más — «1500»,
    /// «156.25», «823.53» (David, 2026-09-24: una carga en W con su F.P. se veía «823.529411…»). El
    /// valor guardado conserva todos sus decimales. Con punto: lo exige <c>type="number"</c>.
    /// </summary>
    private static string Numero(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Un factor (F.P., F.D.): siempre con dos decimales, «0.90», «1.00».</summary>
    private static string Factor(decimal v) => v.ToString("0.00", CultureInfo.InvariantCulture);

    /// <summary>
    /// Lo capturado se guarda completo: el cálculo usa todos sus decimales y solo lo que se muestra
    /// va con dos (David, 2026-09-24). Ilegible: se queda el que estaba.
    /// </summary>
    private static decimal Leer(ChangeEventArgs e, decimal actual) =>
        decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : actual;

    private static decimal? Decimal(object? valor) =>
        decimal.TryParse(valor?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d > 0m ? d : null;

    // Encabezados que se repiten en las dos tablas.
    private RenderFragment EncabezadoCalculo() =>
        @<text>
            <th rowspan="2"><span class="ayuda" title="Conductores portadores de corriente — 310-15(b)(3)(a), (b)(5). La tierra no cuenta — (b)(6). Pasar el cursor sobre el número para consultar el conteo.">Portadores</span></th>
            <th rowspan="2"><span class="ayuda" title="Factor de ajuste por agrupamiento — Tabla 310-15(b)(3)(a), según el tipo de canalización. Pasar el cursor para consultar por qué.">F.A.</span></th>
            <th rowspan="2"><span class="ayuda" title="Suma de las áreas de los conductores — Tablas 5 y 8 del Capítulo 10."><span class="simbolo">Área (mm²)</span></span></th>
            <th colspan="2" data-col="cn-mm cn-in"><span class="ayuda" title="Tubo: el tamaño más chico que alcanza — Tablas 1 y 4 del Capítulo 10. Se puede cambiar en el combo; fijado, se marca y el programa verifica que alcance. ↺ regresa al cálculo. Ducto o canal: sus medidas, o sin ellas el área interior mínima. «2 ×»: una canalización por juego de conductores en paralelo — 310-10(h)(3).">Tamaño</span></th>
            <th rowspan="2"><span class="ayuda" title="Área de los conductores entre el área interior de la canalización.">Ocupación</span></th>
        </text>;

    private RenderFragment EncabezadoTierraDesnuda() =>
        @<th class="dos-lineas" data-col="cn-desnuda"><span class="ayuda" title="Tierra desnuda: su área sale de la Tabla 8 — Nota 8 del Capítulo 10.">Tierra desnuda</span></th>;

    private RenderFragment EncabezadoAzotea() =>
        @<th class="dos-lineas" data-col="cn-azotea"><span class="ayuda" title="Tubo expuesto al sol sobre una azotea: la distancia del techo a la base del tubo, en mm. Se suma temperatura al ambiente — Tabla 310-15(b)(3)(c). Vacío: no está en azotea.">Azotea al sol (mm)</span></th>;

    /// <summary>
    /// Un renglón de la tarjeta «Canalizaciones». Cada opción en su columna, para que el renglón no
    /// crezca (David, 2026-09-24). Neutro compartido y tierra común, con dos o más circuitos.
    /// </summary>
    private RenderFragment FilaCanal(CanalizacionDelTablero t, bool alimentador = false) =>
        @<tr @key="t.Id" data-canal="@t.Id">
            @if (!alimentador)
            {
                <td class="nombre-canal">
                    <div class="nombre-controles">
                        <input type="text" maxlength="40" data-col="cn-nombre" aria-label="@CuadroDeCarga.NombreDe(t) · Nombre" value="@t.Nombre" title="Editar el nombre. Borrado, regresa a @t.Id." @onchange="e => { t.Nombre = e.Value?.ToString() ?? string.Empty; Recalcular(); }" />
                        @if (!t.Automatica || t.Circuitos.Count > 1)
                        {
                            <button class="quitar" title="Quitar la canalización: cada uno de sus circuitos recibe un tubo nuevo, EMT." aria-label="Quitar @CuadroDeCarga.NombreDe(t)" @onclick="() => QuitarCanalizacion(t)"><Icono Nombre="quitar" Tamano="14" /></button>
                        }
                    </div>
                </td>
            }
            <td class="tipo">
                <div class="tipo-controles">
                    <select data-col="cn-tipo" aria-label="@CuadroDeCarga.NombreDe(t) · Tipo" value="@t.Tipo" title="@t.Tipo.Nombre()" @onchange="e => { t.Tipo = Enum.Parse<TipoCanalizacion>(e.Value!.ToString()!); t.TamanoFijado = null; Recalcular(); }">
                        @foreach (var tipo in Enum.GetValues<TipoCanalizacion>()) { <option value="@tipo" title="@tipo.Nombre()">@TipoCorto(tipo)</option> }
                    </select>
                    @if (t.Tipo.EsTubo())
                    {
                        <select data-col="cn-tubo" aria-label="@CuadroDeCarga.NombreDe(t) · Tubo" value="@t.Tubo" @onchange="e => { t.Tubo = Enum.Parse<TipoTuboConduit>(e.Value!.ToString()!); t.TamanoFijado = null; Recalcular(); }">
                            @foreach (var tubo in Enum.GetValues<TipoTuboConduit>()) { <option value="@tubo">@tubo.Corto()</option> }
                        </select>
                    }
                    else if (t.Tipo.EsDuctoOCanal())
                    {
                        <span class="medidas">
                            <input type="number" min="0" placeholder="ancho" data-col="cn-ancho" aria-label="@CuadroDeCarga.NombreDe(t) · Ancho interior (mm)" title="Ancho interior (mm)" value="@Opcional(t.AnchoMm)" @onchange="e => { t.AnchoMm = Decimal(e.Value); Recalcular(); }" />
                            ×
                            <input type="number" min="0" placeholder="alto" data-col="cn-alto" aria-label="@CuadroDeCarga.NombreDe(t) · Alto interior (mm)" title="Alto interior (mm)" value="@Opcional(t.AltoMm)" @onchange="e => { t.AltoMm = Decimal(e.Value); Recalcular(); }" /> mm
                        </span>
                    }
                    else
                    {
                        <span class="medidas">
                            <input type="number" min="0" placeholder="área mm²" data-col="cn-area" aria-label="@CuadroDeCarga.NombreDe(t) · Área interior (mm²)" title="Área interior (mm²)" value="@Opcional(t.AreaInteriorMm2)" @onchange="e => { t.AreaInteriorMm2 = Decimal(e.Value); Recalcular(); }" />
                            <input type="number" min="0" placeholder="máx." data-col="cn-max" aria-label="@CuadroDeCarga.NombreDe(t) · Máximo de conductores" title="Número máximo de conductores que marca el fabricante" value="@(t.MaxConductoresFabricante?.ToString() ?? "")" @onchange="e => { t.MaxConductoresFabricante = int.TryParse(e.Value?.ToString(), out var m) && m > 0 ? m : null; Recalcular(); }" />
                        </span>
                    }
                </div>
            </td>
            @if (!alimentador)
            {
                <td>@(t.Circuitos.Count == 0 ? "—" : string.Join(", ", t.Circuitos.Select(c => c.Espacio)))</td>
            }
            <td class="num">@DePapel(t, PapelConductor.Fase)</td>
            <td class="num">@DePapel(t, PapelConductor.Neutro)</td>
            <td class="num">@DePapel(t, PapelConductor.Tierra)</td>
            <td class="num">
                @if (t.Conteo is { } conteo)
                {
                    <span class="ayuda" title="@string.Join("\n", conteo.Desglose.Select(d => $"{d.Circuito}: {d.Fases} fase(s) + {d.Neutros} neutro(s) — {d.Motivo}"))">@conteo.Portadores</span>
                }
            </td>
            <td class="num">
                @if (t.Ajuste is { } ajuste)
                {
                    <span class="ayuda" title="@ajuste.Motivo">@t.FactorAgrupamiento?.ToString("N2")</span>
                }
            </td>
            <td class="num">@t.Ocupacion?.AreaTotalMm2?.ToString("N1")</td>
            <td class="num fuerte">@CeldaTamano(t, pulgadas: false)</td>
            <td class="num fuerte">@CeldaTamano(t, pulgadas: true)</td>
            <td class="num @(t.Ocupacion?.Excede == true ? "excede" : null)">@(t.Ocupacion?.OcupacionPct is { } pct ? $"{pct:N1} %" : "")</td>
            @if (!alimentador)
            {
                <td class="casilla-canal">
                    @if (t.Circuitos.Count > 1)
                    {
                        <input type="checkbox" data-col="cn-neutro" aria-label="@CuadroDeCarga.NombreDe(t) · Neutro compartido" title="Neutro compartido — 210-4" checked="@t.NeutroCompartido" @onchange="e => { t.NeutroCompartido = e.Value is true; Recalcular(); }" />
                    }
                    else
                    {
                        <span class="tenue">—</span>
                    }
                </td>
                <td class="casilla-canal">
                    @if (t.Circuitos.Count > 1)
                    {
                        <input type="checkbox" data-col="cn-tierra" aria-label="@CuadroDeCarga.NombreDe(t) · Tierra común" title="Tierra común — 250-122(c)" checked="@t.TierraComun" @onchange="e => { t.TierraComun = e.Value is true; Recalcular(); }" />
                    }
                    else
                    {
                        <span class="tenue">—</span>
                    }
                </td>
            }
            <td class="casilla-canal"><input type="checkbox" data-col="cn-desnuda" aria-label="@CuadroDeCarga.NombreDe(t) · Tierra desnuda" title="Tierra desnuda — Tabla 8" checked="@t.TierraDesnuda" @onchange="e => { t.TierraDesnuda = e.Value is true; Recalcular(); }" /></td>
            <td class="@(alimentador ? null : "ultima")">
                @if (t.Tipo.EsTubo())
                {
                    <input type="number" min="0" class="corto" placeholder="—" data-col="cn-azotea" aria-label="@CuadroDeCarga.NombreDe(t) · Azotea al sol (mm)" title="Distancia del techo a la base del tubo, en mm — Tabla 310-15(b)(3)(c). Vacío: no está en azotea." value="@Opcional(t.AlturaSobreTechoMm)" @onchange="e => { t.AlturaSobreTechoMm = decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var h) && h >= 0m ? h : null; Recalcular(); }" />
                }
                else
                {
                    <span class="tenue">—</span>
                }
            </td>
            @if (alimentador)
            {
                <td class="casilla-canal ultima"><input type="checkbox" data-col="cn-paralelos" aria-label="@CuadroDeCarga.NombreDe(t) · Paralelos en un tubo" title="Paralelos en un tubo — 310-15(b)(3)(a)" checked="@t.JuegosEnUnTubo" @onchange="e => { t.JuegosEnUnTubo = e.Value is true; Recalcular(); }" /></td>
            }
        </tr>;

    /// <summary>
    /// El tamaño en mm o en pulgadas. En tubo es un combo con los tamaños de la Tabla 4, en el que
    /// ya viene el que dio el cálculo; si el ingeniero elige otro, queda fijado (se marca, con ↺ para
    /// regresar al cálculo) y el programa verifica que alcance. En lo demás, texto.
    /// </summary>
    private RenderFragment CeldaTamano(CanalizacionDelTablero t, bool pulgadas) =>
        @<text>
            @if (t.Tipo.EsTubo() && t.Ocupacion is { } o && o.AreaTotalMm2 is not null)
            {
                var calculado = o.TamanoCalculado;
                <div class="tamano-controles">
                    @if (t.CanalizacionesIguales > 1)
                    {
                        <span>@t.CanalizacionesIguales ×</span>
                    }
                    <select class="@(t.TamanoFijado is null ? null : "fijado")" data-col="@(pulgadas ? "cn-in" : "cn-mm")" aria-label="@CuadroDeCarga.NombreDe(t) · Tamaño en @(pulgadas ? "pulgadas" : "mm")"
                            title="@(t.TamanoFijado is null ? "Calculado — Tablas 1 y 4 del Capítulo 10. Elegir otro para fijarlo." : $"Fijado por el ingeniero. El cálculo da {calculado?.Rotulo ?? "ninguno"}.")"
                            value="@(o.Tamano?.DesignacionMetrica.ToString() ?? "")"
                            @onchange="e => FijarTamano(t, e.Value?.ToString())">
                        @if (o.Tamano is null)
                        {
                            <option value="">—</option>
                        }
                        @foreach (var tam in Motor.Tubos.Tamanos(t.Tubo))
                        {
                            <option @key="tam.DesignacionMetrica" value="@tam.DesignacionMetrica">@(pulgadas ? tam.Pulgadas : tam.Milimetros)</option>
                        }
                    </select>
                    @if (!pulgadas && t.TamanoFijado is not null)
                    {
                        <button class="quitar" aria-label="Regresar al tamaño calculado" title="Regresar al cálculo: @(calculado?.Rotulo ?? "ninguno alcanza")" @onclick="() => FijarTamano(t, null)"><Icono Nombre="deshacer" Tamano="14" /></button>
                    }
                </div>
            }
            else
            {
                @(pulgadas ? t.TamanoIn : t.TamanoMm)
            }
        </text>;

    /// <summary>El tipo en el selector, corto para no ensanchar la columna; el nombre completo, en el título.</summary>
    private static string TipoCorto(TipoCanalizacion tipo) => tipo switch
    {
        TipoCanalizacion.Niple => "Niple ≤ 60 cm",
        TipoCanalizacion.CanalAuxiliarMetalico => "Canal aux. metálico",
        TipoCanalizacion.CanalAuxiliarNoMetalico => "Canal aux. no metálico",
        TipoCanalizacion.SuperficialMetalica => "Superficial metálica",
        TipoCanalizacion.SuperficialNoMetalica => "Superficial no metálica",
        _ => tipo.Nombre(),
    };

    /// <summary>Elegir el tamaño que da el cálculo lo deja en automático; otro lo fija.</summary>
    private void FijarTamano(CanalizacionDelTablero t, string? valor)
    {
        t.TamanoFijado = int.TryParse(valor, out var d) && d != t.Ocupacion?.TamanoCalculado?.DesignacionMetrica ? d : null;
        Recalcular();
    }

    private static string DePapel(CanalizacionDelTablero t, PapelConductor papel) =>
        t.Ocupacion is { } o ? o.Renglones.Where(r => r.Conductor.Papel == papel).Sum(r => r.Conductor.Cantidad).ToString() : "";

    /// <summary>«1 polo», «3 polos».</summary>
    private static string Polos(int n) => n == 1 ? "1 polo" : $"{n} polos";

    private bool EsUnaFaseDosHilos => SistemaDelTablero.De(Datos.Sistema) == ConfiguracionTablero.UnaFaseDosHilos;

    /// <summary>El tablero tiene neutro: todos salvo 3F-3H.</summary>
    private bool TieneNeutro => SistemaDelTablero.De(Datos.Sistema) != ConfiguracionTablero.TresFasesTresHilos;

    /// <summary>
    /// Una canalización de la lista, o «+ Nueva»: sin carga, crea la siguiente y lo pone ahí; con carga
    /// en una compartida, lo saca a un tubo para él, que da el recálculo con el número libre más chico.
    /// Solo en su tubo no se ofrece: ya va en uno para él.
    /// </summary>
    private void CambiarCanalizacion(CircuitoDelCuadro circuito, string? valor)
    {
        circuito.Canalizacion = valor switch
        {
            "+" when circuito.TieneCarga => null,
            "+" => Datos.NuevaCanalizacion().Id,
            null or "" => null,
            _ => valor,
        };
        Recalcular();
    }

    /// <summary>
    /// Los aislamientos de uso común en instalaciones de baja tensión, todos reconocidos por la
    /// Tabla 310-104(a) que lee el motor. THW no está: la tabla lo da solo para lugares mojados;
    /// THW-LS cubre secos y mojados.
    /// </summary>
    /// <summary>El lugar como texto: un <c>select</c> enlazado directo a un <c>bool</c> no reconoce «true»/«false» y se queda en blanco.</summary>
    private string Lugar
    {
        get => Datos.LugarSeco ? "seco" : "mojado";
        set => Datos.LugarSeco = value == "seco";
    }

    private string Terminales
    {
        get => Datos.TerminalesMarcadas75C ? "75" : "60";
        set => Datos.TerminalesMarcadas75C = value == "75";
    }

    /// <summary>
    /// Los aislamientos que reconoce el motor (Tabla 310-104(a)), no una lista aparte: la de antes
    /// ofrecía 7 de 17 y dejaba fuera THW, THHW, XHHW, RHW y USE, entre otros.
    /// </summary>
    private IReadOnlyList<string> Aislamientos => Motor.Aislamiento.DesignacionesReconocidas;

    /// <summary>
    /// Si la Tabla 5 del Capítulo 10 trae sus dimensiones. Los que no (THW-LS, THHW-LS, USE…) piden el
    /// diámetro del fabricante para el llenado — Nota 5. Se prueba con 12 AWG, que todos traen.
    /// </summary>
    private bool EnTabla5(string aislamiento) => Motor.Dimensiones.Aislado("12", aislamiento) is not null;

    /// <summary>
    /// Cuántas columnas tiene el cuadro, para los <c>colspan</c> de los renglones que abarcan todo.
    /// Depende de las barras: un tablero de dos barras no tiene columna de balanceo para la C.
    /// </summary>
    private int Columnas => 17 + Datos.Barras.Count;

    /// <summary>Los dos bloques del cuadro, ya materializados: cada uno se recorre más de una vez.</summary>
    private IReadOnlyList<IReadOnlyList<CircuitoDelCuadro>> Lados => Cuadro.Lados;

    /// <summary>
    /// La celda de un conductor: la designación con su unidad («12 AWG», «250 kcmil») y, debajo, su sección en mm². Los hilos en
    /// paralelo ya no llevan columna (David, 2026-09-24): si son más de uno, «2 ×» antes del calibre.
    /// Se combina hacia abajo tantos renglones como polos tenga el interruptor.
    /// </summary>
    /// <param name="porque">El desglose de la selección: si viene, la designación AWG/kcmil lleva un
    /// tooltip con cómo se llegó a ese calibre.</param>
    /// <param name="sinConductor">El circuito no lleva ese conductor (un bipolar F-F sin neutro): «—» — I-41.</param>
    private static RenderFragment Conductor(Calibre? calibre, int hilos, int polos, IReadOnlyList<string>? porque = null, bool sinConductor = false) => builder =>
    {
        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "class", "num conductor");
        builder.AddAttribute(2, "rowspan", polos);
        if (sinConductor)
            builder.AddContent(7, "—");
        else if (calibre is not null && hilos > 0)
        {
            builder.AddContent(3, Ayuda(ConHilos(calibre, hilos), porque));
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "mm2");
            builder.AddContent(6, $"{calibre.AreaMm2:N2} mm²");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    /// <summary>El calibre con su unidad, y «2 ×» antes si lleva conductores en paralelo.</summary>
    internal static string ConHilos(Calibre calibre, int hilos) =>
        hilos > 1 ? $"{hilos} × {calibre.DesignacionConUnidad}" : calibre.DesignacionConUnidad;

    /// <summary>
    /// Un valor con su porqué en un tooltip, subrayado punteado como los encabezados que ya lo
    /// llevan. Sin desglose, el valor tal cual.
    /// </summary>
    private static RenderFragment Ayuda(string? valor, IReadOnlyList<string>? porque) => builder =>
    {
        if (porque is null || string.IsNullOrEmpty(valor))
        {
            builder.AddContent(0, valor);
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "ayuda");
        builder.AddAttribute(3, "title", DesgloseDeSeleccion.ComoTexto(porque));
        builder.AddContent(4, valor);
        builder.CloseElement();
    };

    /// <summary>
    /// El VA con el que de verdad se calcula, debajo de lo capturado en W o A — I-25. En VA no se
    /// repite: sería el mismo número dos veces.
    /// </summary>
    private static RenderFragment? EnVA(CircuitoDelCuadro c, decimal capturado, decimal va) =>
        c.Unidad == UnidadConsumo.VoltAmperes || capturado <= 0m
            ? null
            : @<span class="en-va">= @va.ToString("#,0.##") VA</span>;

    /// <summary>
    /// Qué hace el F.P. en ESTE renglón, que depende de la unidad: con W convierte a VA y mueve todo;
    /// con VA o A la corriente no pasa por él, y solo mueve la caída de tensión y los kW.
    /// </summary>
    private static string AyudaFactorPotencia(CircuitoDelCuadro c) => c.Unidad == UnidadConsumo.Watts
        ? "Capturada en W: VA = W ÷ F.P. Modifica corriente, protección, conductor, caída de tensión y kW."
        : $"Capturada en {(c.Unidad == UnidadConsumo.Amperes ? "A" : "VA")}: el F.P. no modifica la corriente ni la protección. " +
          "Modifica la caída de tensión (y el conductor, si excede el límite) y los kW.";

    /// <summary>«6.77 % (fase C)»: la caída del alimentador y la fase que la da.</summary>
    private static string CaidaDelAlimentador(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? $"{a.CaidaTensionPct:N2} % (fase {fases.Aggregate((m, f) => f.CaidaPct > m.CaidaPct ? f : m).Fase})"
            : $"{a.CaidaTensionPct:N2} %";

    private static IReadOnlyList<string>? CaidaPorFase(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? [.. fases.Select(f => $"Fase {f.Fase}: {f.Corriente.Magnitud:N2} A → {f.CaidaV:N2} V ({f.CaidaPct:N2} %)")]
            : null;

    private readonly HashSet<int> _desgloseAbierto = [];

    private bool Abierto(CircuitoDelCuadro c) => _desgloseAbierto.Contains(c.Espacio);

    /// <summary>Abrir lleva el foco al primer aparato (o a «+ Agregar aparato»); cerrar, a la descripción del circuito.</summary>
    private void AlternarDesglose(CircuitoDelCuadro c)
    {
        if (_desgloseAbierto.Remove(c.Espacio))
        {
            _enfocar = $"tr[data-espacio=\"{c.Espacio}\"] input[data-col=\"desc\"]";
            return;
        }
        _desgloseAbierto.Add(c.Espacio);
        _enfocar = c.Aparatos.Count > 0 ? DescripcionDeAparato(c.Espacio, 1) : AgregarDe(c.Espacio);
    }

    private void AgregarAparato(CircuitoDelCuadro c)
    {
        c.AgregarAparato();
        Recalcular();
        _enfocar = DescripcionDeAparato(c.Espacio, c.Aparatos.Count);
    }

    /// <summary>Quita el aparato <paramref name="n"/> y deja el foco en el que queda en su lugar, o en «+ Agregar aparato».</summary>
    private void QuitarAparato(CircuitoDelCuadro c, AparatoDelCircuito a, int n)
    {
        c.Aparatos.Remove(a);
        Recalcular();
        _enfocar = c.Aparatos.Count == 0 ? AgregarDe(c.Espacio) : DescripcionDeAparato(c.Espacio, Math.Min(n, c.Aparatos.Count));
    }

    private static string? SumaDelDesglose(CircuitoDelCuadro c) =>
        c.TieneDesglose ? "Suma de los aparatos del desglose (la flecha junto a la descripción)." : null;

    private void Justificar(CategoriaDeCarga categoria, JustificacionFactorDemanda j, ChangeEventArgs e)
    {
        if (e.Value is true)
            Datos.Justificaciones[categoria].Add(j);
        else
            Datos.Justificaciones[categoria].Remove(j);
        Recalcular();
    }

    /// <summary>El F.D. de un tipo. Fuera de 0 a 1 o ilegible, se queda el que estaba.</summary>
    private void CambiarFactor(CategoriaDeCarga categoria, ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var factor) || factor < 0m || factor > 1m)
            return;

        Datos.CambiarFactorDeDemanda(categoria, factor);
        Recalcular();
    }

    private bool Excede(CircuitoDelCuadro c) =>
        c.Resultado is not null && c.Resultado.CaidaTensionPct > Datos.CaidaMaxDerivadoPct;

    /// <summary>
    /// Cambiar los polos puede no poderse —el espacio de al lado está ocupado, o el interruptor no
    /// cabe—, así que no se enlaza directo: se pregunta al cuadro y, si dice que no, se enseña el
    /// motivo en vez de dejar que el selector mienta.
    /// </summary>
    private void CambiarPolos(CircuitoDelCuadro circuito, string? valor)
    {
        _motivo.Remove(circuito.Espacio);

        if (!int.TryParse(valor, out var polos))
            return;

        if (Cuadro.CambiarPolos(circuito, polos) is { } motivo)
            _motivo[circuito.Espacio] = motivo;
    }
}
