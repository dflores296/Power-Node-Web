                    {
                        <span>@t.CanalizacionesIguales ×</span>
                    }
                    <select class="@(t.TamanoFijado is null ? null : "fijado")" data-col="@(pulgadas ? "cn-in" : "cn-mm")" aria-label="@CuadroDeCarga.NombreDe(t) · Tamaño en @(pulgadas ? "pulgadas" : "mm")"
                            title="@(t.TamanoFijado is null ? "Calculado — Tablas 1 y 4 del Capítulo 10. Elegir otro para fijarlo." : $"Fijado por el ingeniero. El cálculo da {calculado?.Rotulo ?? "ninguno"}.")"
                            value="@(o.Tamano?.DesignacionMetrica.ToString() ?? "")"
                            @onchange="e => FijarTamano(t, e.Value?.ToString())">
                        @if (o.Tamano is null)
                        {
                            <option value="">—</option>
                        }
                        @foreach (var tam in Motor.Tubos.Tamanos(t.Tubo))
                        {
                            <option @key="tam.DesignacionMetrica" value="@tam.DesignacionMetrica">@(pulgadas ? tam.Pulgadas : tam.Milimetros)</option>
                        }
                    </select>
                    @if (!pulgadas && t.TamanoFijado is not null)
                    {
                        <button class="quitar" aria-label="Regresar al tamaño calculado" title="Regresar al cálculo: @(calculado?.Rotulo ?? "ninguno alcanza")" @onclick="() => FijarTamano(t, null)"><Icono Nombre="deshacer" Tamano="14" /></button>
                    }
                </div>
            }
            else
            {
                @(pulgadas ? t.TamanoIn : t.TamanoMm)
            }
        </text>;

    /// <summary>El tipo en el selector, corto para no ensanchar la columna; el nombre completo, en el título.</summary>
    private static string TipoCorto(TipoCanalizacion tipo) => tipo switch
    {
        TipoCanalizacion.Niple => "Niple ≤ 60 cm",
        TipoCanalizacion.CanalAuxiliarMetalico => "Canal aux. metálico",
        TipoCanalizacion.CanalAuxiliarNoMetalico => "Canal aux. no metálico",
        TipoCanalizacion.SuperficialMetalica => "Superficial metálica",
        TipoCanalizacion.SuperficialNoMetalica => "Superficial no metálica",
        _ => tipo.Nombre(),
    };

    /// <summary>Elegir el tamaño que da el cálculo lo deja en automático; otro lo fija.</summary>
    private void FijarTamano(CanalizacionDelTablero t, string? valor)
    {
        t.TamanoFijado = int.TryParse(valor, out var d) && d != t.Ocupacion?.TamanoCalculado?.DesignacionMetrica ? d : null;
        Recalcular();
    }

    private static string DePapel(CanalizacionDelTablero t, PapelConductor papel) =>
        t.Ocupacion is { } o ? o.Renglones.Where(r => r.Conductor.Papel == papel).Sum(r => r.Conductor.Cantidad).ToString() : "";

    /// <summary>«1 polo», «3 polos».</summary>
    private static string Polos(int n) => n == 1 ? "1 polo" : $"{n} polos";

    private bool EsUnaFaseDosHilos => SistemaDelTablero.De(Datos.Sistema) == ConfiguracionTablero.UnaFaseDosHilos;

    /// <summary>El tablero tiene neutro: todos salvo 3F-3H.</summary>
    private bool TieneNeutro => SistemaDelTablero.De(Datos.Sistema) != ConfiguracionTablero.TresFasesTresHilos;

    /// <summary>
    /// <b>La protección escogida en su celda</b> — I-182: un valor del rango la fija; el que da el cálculo la
    /// regresa al cálculo.
    /// </summary>
    private void CambiarProteccion(CircuitoDelCuadro circuito, string? valor) =>
        Cuadro.FijarProteccion(circuito,
            decimal.TryParse(valor, NumberStyles.Number, CultureInfo.InvariantCulture, out var amperes) ? amperes : null);

    /// <summary>
    /// La ayuda de la celda (David: «hay que explicar por qué se permite seleccionar»): el rango, la calculada o
    /// la fijada y cuál es la calculada — I-182; y el desglose del valor.
    /// </summary>
    private string? AyudaDeLaProteccion(CircuitoDelCuadro c, DesgloseDeSeleccion? desglose)
    {
        // B5 (avisos-de-la-captura.md): el rango y su artículo; fijada, también cuánto da el cálculo. El desglose,
        // abajo, hasta que la memoria tenga su entrada por circuito (B6).
        if (c.Resultado is not { Rango: { } r } resultado)
            return null;
        var ayuda = r.Valores.Count == 1 ? $"Solo se permite {r.MaximoA:N0} A." : $"Se permite de {r.MinimoA:N0} a {r.MaximoA:N0} A.";
        if (CuadroDeCarga.ProteccionFijada(c))
            ayuda += $" Fijada en {resultado.ProteccionA:N0} A" + (Cuadro.ProteccionCalculada(c) is { } calc ? $"; el cálculo da {calc:N0} A." : ".");
        ayuda += $"\n· {r.Regla}";
        return desglose is null ? ayuda : $"{ayuda}\n\n{DesgloseDeSeleccion.ComoTexto(desglose.Proteccion)}";
    }

    /// <summary>Opción A: la celda que causa una advertencia, enmarcada (estados-de-aviso.md).</summary>
    private static string? MarcoDe(IReadOnlyList<AdvertenciaDeLaTabla> avisos, CeldaDelAviso celda) =>
        avisos.Any(a => a.Celda == celda) ? "marco-aviso" : null;

    /// <summary>
    /// El cuadro de ayuda de la celda enmarcada: cada advertencia con su referencia en otra línea, apartada
    /// (guía de David, punto 2); dos en la misma celda, una debajo de otra.
    /// </summary>
    private static string? TituloDe(IReadOnlyList<AdvertenciaDeLaTabla> avisos, CeldaDelAviso celda) =>
        avisos.Where(a => a.Celda == celda).ToList() is { Count: > 0 } deLaCelda
            ? string.Join("\n\n", deLaCelda.Select(a => $"{a.Texto}\n· {a.Referencia}"))
            : null;

    /// <summary>La ayuda propia de un campo, con las advertencias de su celda antes.</summary>
    private static string? ConAvisos(string? propia, IReadOnlyList<AdvertenciaDeLaTabla> avisos, CeldaDelAviso celda) =>
        TituloDe(avisos, celda) is { } aviso ? propia is null ? aviso : $"{aviso}\n\n{propia}" : propia;

    /// <summary>
    /// El campo del desplegable con el dato que falta o que choca: con borde rojo (opción A). <paramref name="aparato"/>
    /// nulo es el equipo del circuito.
    /// </summary>
    private string? FaltaEn(CircuitoDelCuadro c, CargaDelCircuito? aparato, ColDesglose col) =>
        c.Error is not null && AvisosDeLaTabla.ErrorDe(Cuadro, c) is { Campo: { } campo } e && campo == col.ToString()
        && (ReferenceEquals(e.Linea, aparato) || (col == ColDesglose.Tipo && aparato is { Subtipo: null }))
            ? "1" : null;

    // EL CONTADOR, ARRIBA DEL CUADRO (David, 2026-10-07): «1 error · 2 advertencias»; un clic lleva al siguiente.
    private int _siguienteError = -1;
    private int _siguienteAdvertencia = -1;

    private IReadOnlyList<int> ConError => [.. Cuadro.Circuitos.Where(x => !x.EsContinuacion && x.Error is not null).Select(x => x.Espacio)];

    private IReadOnlyList<int> ConAdvertencias => [.. Cuadro.Circuitos.Where(x => !x.EsContinuacion && x.Error is null && AvisosDeLaTabla.AdvertenciasDe(Cuadro, x).Count > 0).Select(x => x.Espacio)];

    private void IrAlSiguiente(bool error)
    {
        var lista = error ? ConError : ConAdvertencias;
        if (lista.Count == 0)
            return;
        ref var i = ref error ? ref _siguienteError : ref _siguienteAdvertencia;
        i = (i + 1) % lista.Count;
        _enfocar = $"tr[data-espacio=\"{lista[i]}\"] input[data-col=\"desc\"]";
    }

    /// <summary>
    /// Una canalización de la lista, o «+ Nueva»: sin carga, crea la siguiente y lo pone ahí; con carga
    /// en una compartida, lo saca a un tubo para él, que da el recálculo con el número libre más chico.
    /// Solo en su tubo no se ofrece: ya va en uno para él.
    /// </summary>
    private void CambiarCanalizacion(CircuitoDelCuadro circuito, string? valor)
    {
        circuito.Canalizacion = valor switch
        {
            "+" when circuito.TieneCarga => null,
            "+" => Datos.NuevaCanalizacion().Id,
            null or "" => null,
            _ => valor,
        };
        Recalcular();
    }

    /// <summary>
    /// Los aislamientos de uso común en instalaciones de baja tensión, todos reconocidos por la
    /// Tabla 310-104(a) que lee el motor. THW no está: la tabla lo da solo para lugares mojados;
    /// THW-LS cubre secos y mojados.
    /// </summary>
    private string Terminales
    {
        get => Datos.TerminalesMarcadas75C ? "75" : "60";
        set => Datos.TerminalesMarcadas75C = value == "75";
    }

    /// <summary>
    /// Los aislamientos que reconoce el motor (Tabla 310-104(a)), no una lista aparte: la de antes
    /// ofrecía 7 de 17 y dejaba fuera THW, THHW, XHHW, RHW y USE, entre otros.
    /// </summary>
    private IReadOnlyList<string> Aislamientos => Motor.Aislamiento.DesignacionesReconocidas;

    /// <summary>
    /// Si la Tabla 5 del Capítulo 10 trae sus dimensiones. Los que no (THW-LS, THHW-LS, USE…) piden el
    /// diámetro del fabricante para el llenado — Nota 5. Se prueba con 12 AWG, que todos traen.
    /// </summary>
    private bool EnTabla5(string aislamiento) => Motor.Dimensiones.Aislado("12", aislamiento) is not null;

    /// <summary>
    /// Cuántas columnas tiene el cuadro, para los <c>colspan</c> de los renglones que abarcan todo.
    /// Depende de las barras: un tablero de dos barras no tiene columna de balanceo para la C.
    /// </summary>
    /// <summary>
    /// El número del espacio con el contorno del color de su barra, como en el gabinete: dice en qué
    /// fase cae el circuito aunque el renglón esté vacío. Reemplaza a la columna «Barras» (I-99).
    /// </summary>
    private RenderFragment NumeroConFase(int espacio) => builder =>
    {
        var fase = DistribucionBarras.FaseDe(espacio, Datos.Sistema);
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"num-fase num-fase-{char.ToLowerInvariant(fase)}");
        builder.AddAttribute(2, "title", $"Barra {fase}");
        builder.OpenElement(3, "span");
        builder.AddContent(4, espacio);
        builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>
    /// Un renglón de un espacio con notas debajo de sus campos (tamaño del tubo, mm², VA, MCA…) crece
    /// para que quepan; un multipolar ya mide dos o tres espacios.
    /// </summary>
    /// <summary>
    /// El renglón crece solo si muestra una nota: el detalle de la clase, la placa, el tamaño del tubo o
    /// los mm² — todas salen con carga. Antes crecía con solo tener una línea en el desplegable, aunque no
    /// hubiera nada que mostrar (David, 2026-09-30: una calefacción en 0 VA).
    /// </summary>
    private static bool LlevaNotas(CircuitoDelCuadro c) => c.Polos == 1 && c.TieneCarga;

    private int Columnas => 16 + Datos.Barras.Count;

    /// <summary>Los dos bloques del cuadro, ya materializados: cada uno se recorre más de una vez.</summary>
    private IReadOnlyList<IReadOnlyList<CircuitoDelCuadro>> Lados => Cuadro.Lados;

    /// <summary>
    /// La celda de un conductor: la designación con su unidad («12 AWG», «250 kcmil») y, debajo, su sección en mm². Los hilos en
    /// paralelo ya no llevan columna (David, 2026-09-24): si son más de uno, «2 ×» antes del calibre.
    /// Se combina hacia abajo tantos renglones como polos tenga el interruptor.
    /// </summary>
    /// <param name="porque">El desglose de la selección: si viene, la designación AWG/kcmil lleva un
    /// tooltip con cómo se llegó a ese calibre.</param>
    /// <param name="sinConductor">El circuito no lleva ese conductor (un bipolar F-F sin neutro): «—» — I-41.</param>
    private static RenderFragment Conductor(Calibre? calibre, int hilos, int polos, IReadOnlyList<string>? porque = null, bool sinConductor = false) => builder =>
    {
        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "class", "num conductor");
        builder.AddAttribute(2, "rowspan", polos);
        if (sinConductor)
            builder.AddContent(7, "—");
        else if (calibre is not null && hilos > 0)
        {
            builder.AddContent(3, Ayuda(ConHilos(calibre, hilos), porque));
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "mm2");
            builder.AddContent(6, $"{calibre.AreaMm2:N2} mm²");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    /// <summary>El calibre con su unidad, y «2 ×» antes si lleva conductores en paralelo.</summary>
    internal static string ConHilos(Calibre calibre, int hilos) =>
        hilos > 1 ? $"{hilos} × {calibre.DesignacionConUnidad}" : calibre.DesignacionConUnidad;

    /// <summary>
    /// Un valor con su porqué en un tooltip, subrayado punteado como los encabezados que ya lo
    /// llevan. Sin desglose, el valor tal cual.
    /// </summary>
    private static RenderFragment Ayuda(string? valor, IReadOnlyList<string>? porque) => builder =>
    {
        if (porque is null || string.IsNullOrEmpty(valor))
        {
            builder.AddContent(0, valor);
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "ayuda");
        builder.AddAttribute(3, "title", DesgloseDeSeleccion.ComoTexto(porque));
        builder.AddContent(4, valor);
        builder.CloseElement();
    };

    /// <summary>«6.77 % (fase C)»: la caída del alimentador y la fase que la da.</summary>
    private static string CaidaDelAlimentador(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? $"{a.CaidaTensionPct:N2} % (fase {fases.Aggregate((m, f) => f.CaidaPct > m.CaidaPct ? f : m).Fase})"
            : $"{a.CaidaTensionPct:N2} %";

    private static IReadOnlyList<string>? CaidaPorFase(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? [.. fases.Select(f => $"Fase {f.Fase}: {f.Corriente.Magnitud:N2} A → {f.CaidaV:N2} V ({f.CaidaPct:N2} %)")]
            : null;

    private readonly HashSet<int> _desgloseAbierto = [];

    private bool Abierto(CircuitoDelCuadro c) => _desgloseAbierto.Contains(c.Espacio);

    /// <summary>Abrir lleva el foco al primer aparato (o a «+ Agregar aparato»); cerrar, a la descripción del circuito.</summary>
    private void AlternarDesglose(CircuitoDelCuadro c)
    {
        if (_desgloseAbierto.Remove(c.Espacio))
        {
            _enfocar = $"tr[data-espacio=\"{c.Espacio}\"] input[data-col=\"desc\"]";
            return;
        }
        _desgloseAbierto.Add(c.Espacio);
        // Un archivo de antes traía la carga en el renglón: al abrir, pasa a sus líneas, con su subtipo.
        if (c.RenglonALineas(conSubtipo: true))
            Recalcular();
        _enfocar = c.Cargas.Count > 0 ? DescripcionDeAparato(c.Espacio, 1) : AgregarDe(c.Espacio);
    }

    /// <summary>Una línea nueva lleva ya su subtipo: el primero del tipo del circuito — I-123.</summary>
    private void AgregarCarga(CircuitoDelCuadro c)
    {
        var nueva = c.AgregarCarga();
        // Sin tipo elegido, la línea empieza en «—»: el tipo se escoge en ella, una sola vez.
        nueva.Subtipo = c.TipoElegido ? SubtiposDeCarga.PorOmision(c.Categoria) : null;
        Nombrar(c, nueva);
        Recalcular();
        _enfocar = DescripcionDeAparato(c.Espacio, c.Cargas.Count);
    }


    /// <summary>«3 motores», «2 motores, 1 carga»: lo que lleva un grupo — I-115.</summary>
    private static string TextoDelGrupo(CircuitoDelCuadro c)
    {
        int Cuantos(ClaseDeAparato clase) => c.Cargas.Where(a => a.Clase == clase).Sum(a => a.Cantidad);
        var partes = new List<string>();
        if (Cuantos(ClaseDeAparato.Motocompresor) is > 0 and var compresores)
            partes.Add($"{compresores} motocompresor{(compresores == 1 ? "" : "es")}");
        var variadores = Cuantos(ClaseDeAparato.Variador);
        if (Cuantos(ClaseDeAparato.Motor) is var motores && (motores > 0 || (partes.Count == 0 && variadores == 0)))
            partes.Add($"{motores} motor{(motores == 1 ? "" : "es")}");
        if (variadores > 0)
            partes.Add($"{variadores} con variador");
        if (c.Cargas.Where(a => !a.EsMaquina).Sum(a => a.Cantidad) is > 0 and var cargas)
            partes.Add($"{cargas} carga{(cargas == 1 ? "" : "s")}");
        return string.Join(", ", partes);
    }

    /// <summary>
    /// El tipo de una carga: su primer subtipo; un motor sigue siendo motor si su nuevo tipo lo admite
    /// (aparato con motor, calefacción con motor) — I-123.
    /// </summary>
    private void CambiarTipoDeCarga(CircuitoDelCuadro c, CargaDelCircuito a, string? valor)
    {
        if (!Enum.TryParse<CategoriaDeCarga>(valor, out var tipo))
            return;
        if (!c.TipoElegido)
            c.Categoria = tipo;
        if (tipo == CategoriaDeCarga.Tablero)
        {
            CambiarSubtipo(c, a, nameof(SubtipoDeCarga.TableroAlimentado));
            return;
        }
        var subtipos = SubtiposDeCarga.De(tipo).Where(s => !s.SoloEnElRenglon()).ToList();
        a.Subtipo = subtipos.FirstOrDefault(s => s.Clase() == a.Clase, subtipos[0]);
        Nombrar(c, a);
        TrasEditarLinea(c);
    }

    /// <summary>
    /// El subtipo de una línea. Un variador, un A/A con ampacidad de placa y otro tablero van solos: el
    /// circuito pasa a ese equipo, con lo capturado en la línea — captura-en-el-desplegable.md.
    /// </summary>
    private void CambiarSubtipo(CircuitoDelCuadro c, CargaDelCircuito a, string? valor)
    {
        if (!Enum.TryParse<SubtipoDeCarga>(valor, out var subtipo))
            return;
        if (subtipo.SoloEnElRenglon())
        {
            if (!c.PasarARenglon(subtipo))
                Avisar($"{subtipo.Nombre()} va solo. Quita primero las demás líneas del circuito {c.Espacio}.", bien: false);
            Recalcular();
            return;
        }
        a.Subtipo = subtipo;
        Nombrar(c, a);
        TrasEditarLinea(c);
    }

    /// <summary>Las flechas de la cantidad: una más o una menos, sin bajar de 1.</summary>
    private void CambiarCantidad(CircuitoDelCuadro c, CargaDelCircuito a, int cambio)
    {
        a.Cantidad = Math.Max(1, a.Cantidad + cambio);
        TrasEditarLinea(c);
    }

    private void CambiarContinua(CargaDelCircuito a, string? valor)
    {
        a.Continua = valor == "si";
        Recalcular();
    }

    /// <summary>
    /// «Contactos 1», «Motor 2»: el nombre genérico de su subtipo, numerado entre las líneas del circuito
    /// con el mismo nombre (David, 2026-09-30). Solo si está vacío o lo puso el programa.
    /// </summary>
    private static void Nombrar(CircuitoDelCuadro c, CargaDelCircuito a)
    {
        if (a.Subtipo is not { } subtipo || !SubtiposDeCarga.EsNombreGenerico(a.Descripcion))
            return;
        var nombre = subtipo.NombreGenerico();
        var usados = c.Cargas.Where(x => x != a && x.Descripcion.StartsWith(nombre + " ", StringComparison.Ordinal))
            .Select(x => int.TryParse(x.Descripcion[(nombre.Length + 1)..], out var k) ? k : 0).ToHashSet();
        var n = 1;
        while (usados.Contains(n))
            n++;
        a.Descripcion = $"{nombre} {n}";
    }

    /// <summary>Un solo motor, motocompresor o acondicionador de habitación se calcula con su artículo, no como grupo.</summary>
    private void TrasEditarLinea(CircuitoDelCuadro c)
    {
        c.LineaARenglon();
        Recalcular();
    }

    /// <summary>El tipo del equipo capturado en el renglón: toma el subtipo por omisión del nuevo tipo.</summary>
    private void CambiarTipoDelRenglon(CircuitoDelCuadro c, string? valor)
    {
        if (Enum.TryParse<CategoriaDeCarga>(valor, out var tipo))
            CambiarSubtipoDelRenglon(c, (tipo == CategoriaDeCarga.Tablero ? SubtipoDeCarga.TableroAlimentado : SubtiposDeCarga.PorOmision(tipo)).ToString());
    }

    /// <summary>
    /// El subtipo del equipo del renglón. Entre las formas de un equipo (motor, variador, motocompresor,
    /// A/A con ampacidad, de habitación, tablero) se cambia la forma; lo capturado en las otras se queda.
    /// Cualquier otro subtipo pasa a ser la línea del desplegable.
    /// </summary>
    private void CambiarSubtipoDelRenglon(CircuitoDelCuadro c, string? valor)
    {
        if (!Enum.TryParse<SubtipoDeCarga>(valor, out var subtipo) || subtipo == c.SubtipoDelRenglon)
            return;
        if (SubtiposDeCarga.EsNombreGenerico(c.DescripcionDelEquipo))
            c.DescripcionDelEquipo = $"{subtipo.NombreGenerico()} 1";
        switch (subtipo)
        {
            case SubtipoDeCarga.MotorUsoGeneral:
                c.Categoria = CategoriaDeCarga.Motor;
                if (c.CapturaMotor is not (CapturaDeMotor.Hp or CapturaDeMotor.Amperes))
                    c.CapturaMotor = CapturaDeMotor.Hp;
                break;
            case SubtipoDeCarga.MotorVelocidadAjustable:
                c.Categoria = CategoriaDeCarga.Motor;
                c.CapturaMotor = CapturaDeMotor.Variador;
                break;
            case SubtipoDeCarga.Motocompresor:
                c.Categoria = CategoriaDeCarga.AireAcondicionado;
                c.PlacaAire = PlacaDeAireAcondicionado.CorrienteNominal;
                break;
            case SubtipoDeCarga.CargaCombinada:
                c.Categoria = CategoriaDeCarga.AireAcondicionado;
                c.PlacaAire = PlacaDeAireAcondicionado.AmpacidadYProteccion;
                break;
            case SubtipoDeCarga.AireDeHabitacion:
                c.Categoria = CategoriaDeCarga.AireAcondicionado;
                c.PlacaAire = PlacaDeAireAcondicionado.Habitacion;
                break;
            default:
                // Deja de ser un equipo del renglón: su línea, vacía, con el nuevo subtipo.
                c.Continua = 0m;
                c.NoContinua = 0m;
                c.Categoria = subtipo.Tipo();
                c.Cargas.Clear();
                c.Cargas.Add(new CargaDelCircuito { Descripcion = c.DescripcionDelEquipo.Trim(), Subtipo = subtipo, FactorPotencia = c.FactorPotencia });
                c.DescripcionDelEquipo = string.Empty;
                _enfocar = DescripcionDeAparato(c.Espacio, 1);
                break;
        }
        Recalcular();
    }

    /// <summary>Quita el equipo del renglón y su tipo: el circuito queda vacío, como uno nuevo.</summary>
    private void QuitarRenglon(CircuitoDelCuadro c)
    {
        c.QuitarEquipo();
        Recalcular();
        _enfocar = AgregarDe(c.Espacio);
    }

    /// <summary>
    /// Una carga que puede no operar a la vez que otra: motores (430-24 Exc. 3), A/A y refrigeración
    /// (440-33 Exc. 1), calefacción y aparatos (220-60). Alumbrado, contactos y otros tableros, no.
    /// </summary>
    private static bool AdmiteNoSimultaneo(CircuitoDelCuadro x) =>
        x.TieneCarga && !x.EsContinuacion && x.Categoria != CategoriaDeCarga.Tablero &&
        (x.EsDeMotor || x.Categoria is CategoriaDeCarga.Equipo or CategoriaDeCarga.CalefaccionFija
         || x.Cargas.Any(a => x.TipoDe(a) is CategoriaDeCarga.Equipo or CategoriaDeCarga.Motor or CategoriaDeCarga.AireAcondicionado or CategoriaDeCarga.CalefaccionFija));

    private static string EtiquetaDelPar(CircuitoDelCuadro x) =>
        string.IsNullOrWhiteSpace(x.Descripcion) ? MemoriaDeCalculo.Etiqueta(x) : x.Descripcion;

    /// <summary>
    /// Los circuitos que pueden formar un par, con su nombre: la lista de «No simultáneo con» lee otros circuitos, así
    /// que un renglón memorizado (I-188) se vuelve a dibujar cuando cambian.
    /// </summary>
    private string FirmaDelPar() =>
        string.Join("|", Cuadro.Circuitos.Where(AdmiteNoSimultaneo).Select(x => $"{x.Espacio}:{EtiquetaDelPar(x)}"));

    /// <summary>El selector, si el circuito lo admite y hay otro con quien formar el par; o si ya tiene par, para poder quitarlo.</summary>
    private bool MuestraNoSimultaneo(CircuitoDelCuadro c) =>
        c.NoSimultaneoCon is not null
        || (AdmiteNoSimultaneo(c) && Cuadro.Circuitos.Any(x => x != c && AdmiteNoSimultaneo(x)));

    /// <summary>Un alimentador a tableros: todas sus líneas son tableros (David, 2026-09-30).</summary>
    private static bool SoloTableros(CircuitoDelCuadro c) => c.Cargas.Count > 0 && c.Cargas.All(a => a.EsTablero);

    /// <summary>
    /// El nombre del equipo o del subtipo que va solo en su circuito — un variador, un A/A con ampacidad de
    /// placa, otro tablero, el contacto del refrigerador —; <c>null</c> si el circuito admite otra carga.
    /// </summary>
    private static string? VaSolo(CircuitoDelCuadro c) =>
        c.SubtipoDelRenglon is { } r && r.VaSolo() ? r.Nombre()
        : c.Cargas.FirstOrDefault(a => a.Subtipo?.VaSolo() == true)?.Subtipo?.Nombre();

    /// <summary>«Motor|Hp», «Carga|Watts»: la clase y la unidad de un miembro del grupo en un valor — I-115.</summary>
    private static string UnidadDeMiembro(CargaDelCircuito a) => a.Clase switch
    {
        ClaseDeAparato.Motor => $"Motor|{a.CapturaMotor}",
        ClaseDeAparato.Carga => $"Carga|{a.Unidad}",
        _ => $"{a.Clase}|{CapturaDeMotor.Amperes}",
    };

    private void CambiarUnidadDeMiembro(CargaDelCircuito a, string? valor)
    {
        var partes = valor?.Split('|');
        if (partes is not { Length: 2 })
            return;
        if (partes[0] is nameof(ClaseDeAparato.Motocompresor) or nameof(ClaseDeAparato.AireDeHabitacion))
            a.Clase = Enum.Parse<ClaseDeAparato>(partes[0]);
        else if (partes[0] == "Motor" && Enum.TryParse<CapturaDeMotor>(partes[1], out var captura) && captura != CapturaDeMotor.Grupo)
        {
            a.Clase = ClaseDeAparato.Motor;
            a.CapturaMotor = captura;
        }
        else if (partes[0] == "Carga" && Enum.TryParse<UnidadConsumo>(partes[1], out var unidad))
        {
            a.Clase = ClaseDeAparato.Carga;
            a.Unidad = unidad;
        }
        Recalcular();
    }

    /// <summary>La alimentación del variador y sus VA, para el título de la nota «Entrada» — I-119.</summary>
    private string AyudaDeEntrada(CircuitoDelCuadro c) =>
        MotoresEnHp.AlimentacionTexto(c.Polos, MotoresEnHp.Tension(c.Polos, Datos.TensionFaseNeutroV, Datos.TensionFaseFaseV)) +
        (c.MotorVA > 0m ? $". {c.MotorVA:#,0} VA: la corriente de entrada por la tensión del circuito." : ".");

    /// <summary>Continuo (vacío) o una de las clases de la Tabla 430-22(e) — I-120.</summary>
    private void CambiarServicio(CircuitoDelCuadro c, string? valor)
    {
        var partes = valor?.Split('|');
        if (partes is [var sv, var t] && Enum.TryParse<ServicioDeMotor>(sv, out var servicio) && Enum.TryParse<EspecificacionDeTiempo>(t, out var tiempo))
        {
            c.Servicio = servicio;
            c.EspecificacionServicio = tiempo;
        }
        else
            c.Servicio = null;
        Recalcular();
    }

    /// <summary>«Intermitente|Minutos15», o vacío si es continuo: el valor del selector de servicio.</summary>
    private static string ValorServicio(CircuitoDelCuadro c) =>
        c.Servicio is { } sv ? $"{sv}|{c.EspecificacionServicio}" : "";

    private static string NombreServicio(ServicioDeMotor s, bool corto = false) => s switch
    {
        ServicioDeMotor.CortaDuracion => corto ? "Corta dur." : "Corta duración",
        ServicioDeMotor.Intermitente => "Intermitente",
        ServicioDeMotor.Periodico => "Periódico",
        _ => "Variable",
    };

    private static string NombreTiempo(EspecificacionDeTiempo t) => t switch
    {
        EspecificacionDeTiempo.Minutos5 => "5 min",
        EspecificacionDeTiempo.Minutos15 => "15 min",
        EspecificacionDeTiempo.Minutos30y60 => "30-60 min",
        _ => "continuo",
    };

    /// <summary>El par no simultáneo, de los dos lados: marcarlo en uno lo marca en el otro — I-121.</summary>
    private void CambiarNoSimultaneo(CircuitoDelCuadro c, string? valor)
    {
        var antes = c.NoSimultaneoCon;
        c.NoSimultaneoCon = int.TryParse(valor, out var n) ? n : null;
        if (antes is { } a && Cuadro.Circuitos.FirstOrDefault(x => x.Espacio == a) is { } exPar && exPar.NoSimultaneoCon == c.Espacio)
            exPar.NoSimultaneoCon = null;
        if (c.NoSimultaneoCon is { } nuevo && Cuadro.Circuitos.FirstOrDefault(x => x.Espacio == nuevo) is { } par)
            par.NoSimultaneoCon = c.Espacio;
        Recalcular();
    }

    /// <summary>
    /// La tensión de placa, y con ella los polos — I-189. Si los polos no se pueden cambiar, no se cambia nada y el
    /// motivo sale en el aviso flotante, como con la columna P.
    /// </summary>
    private async Task CambiarTensionDePlaca(CircuitoDelCuadro c, string? valor)
    {
        TensionDePlaca? tension = Enum.TryParse<TensionDePlaca>(valor, out var t) && Enum.IsDefined(t) ? t : null;
        if (Cuadro.CambiarTensionDePlaca(c, tension) is { } motivo)
        {
            Avisar($"El circuito {c.Espacio} no cabe con {tension!.Value.Polos()} polos. {motivo}", bien: false);
            var etiqueta = c.EsVariador ? "Tensión de entrada del variador" : "Tensión de placa";
            await Restablecer($"[aria-label=\"Circuito {c.Espacio} · {etiqueta}\"]", c.TensionDePlaca?.ToString() ?? "");
            return;
        }
        Recalcular();
    }

    /// <summary>Los HP del motor de un variador — M-23. Vacío: sin capturar.</summary>
    private void CambiarHpDelVariador(CircuitoDelCuadro c, string? valor)
    {
        c.HpMotorDelVariador = decimal.TryParse(valor, NumberStyles.Float, CultureInfo.InvariantCulture, out var hp) && hp > 0m ? hp : null;
        Recalcular();
    }

    private static string ValorHp(decimal? hp) => hp is > 0m and { } v ? v.ToString(CultureInfo.InvariantCulture) : "";

    private void CambiarHpDeMiembro(CargaDelCircuito a, string? valor)
    {
        if (!decimal.TryParse(valor, NumberStyles.Float, CultureInfo.InvariantCulture, out var hp) || hp < 0m)
            return;
        a.Hp = hp > 0m ? hp : null;
        Recalcular();
    }

    /// <summary>Quita el aparato <paramref name="n"/> y deja el foco en el que queda en su lugar, o en «+ Agregar aparato».</summary>
    private void QuitarAparato(CircuitoDelCuadro c, CargaDelCircuito a, int n)
    {
        // Un solo motor, motocompresor, variador o A/A de habitación regresa al renglón; sin líneas, el
        // circuito queda vacío (I-185).
        c.QuitarCarga(a);
        Recalcular();
        _enfocar = c.Cargas.Count == 0 ? AgregarDe(c.Espacio) : DescripcionDeAparato(c.Espacio, Math.Min(n, c.Cargas.Count));
    }

    /// <summary>
    /// Cambia la unidad del tipo que tiene el renglón. Lo capturado en las otras formas se queda: es lo
    /// que vuelve a contar al regresar a ellas.
    /// </summary>
    private void CambiarUnidad(CircuitoDelCuadro c, string? valor)
    {
        if (c.EsMotor && Enum.TryParse<CapturaDeMotor>(valor, out var captura) && captura != CapturaDeMotor.Grupo)
            c.CapturaMotor = captura;
        else if (c.EsAireAcondicionado && Enum.TryParse<PlacaDeAireAcondicionado>(valor, out var placa) && placa != PlacaDeAireAcondicionado.Grupo)
            c.PlacaAire = placa;
        else if (Enum.TryParse<UnidadConsumo>(valor, out var unidad))
            c.Unidad = unidad;
        Recalcular();
    }

    private static string ValorHpConPolos(int polos, decimal hp) => $"{polos}|{hp.ToString(CultureInfo.InvariantCulture)}";

    /// <summary>
    /// «3|5»: 5 HP con 3 polos. Si los polos son otros, primero se cambian —puede no poderse, como en
    /// la columna P— y el motivo sale en el aviso flotante — I-114.
    /// </summary>
    private async Task CambiarHp(CircuitoDelCuadro c, string? valor)
    {
        var partes = valor?.Split('|');
        if (partes is not { Length: 2 } || !int.TryParse(partes[0], out var polos)
            || !decimal.TryParse(partes[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var hp) || hp < 0m)
            return;

        if (polos != c.Polos && Cuadro.CambiarPolos(c, polos) is { } motivo)
        {
            Avisar($"El circuito {c.Espacio} no cabe con {polos} polos. {motivo}", bien: false);
            await Restablecer($"[aria-label=\"Circuito {c.Espacio} · HP\"]", ValorHpConPolos(c.Polos, c.Hp ?? 0m));
            return;
        }
        c.Hp = hp;
        Recalcular();
    }

    private void Justificar(CategoriaDeCarga categoria, JustificacionFactorDemanda j, ChangeEventArgs e)
    {
        if (e.Value is true)
            Datos.Justificaciones[categoria].Add(j);
        else
            Datos.Justificaciones[categoria].Remove(j);
        Recalcular();
    }

    /// <summary>El F.D. de un tipo. Fuera de 0 a 1 o ilegible, se queda el que estaba.</summary>
    /// <summary>
    /// El F.D. va de más de 0 a 1: con 1.5 la casilla lo mostraba y la demanda seguía en 1.0; con 0 el
    /// tipo desaparecía del alimentador (auditoría del 2026-09-29, P2-3).
    /// </summary>
    private void CambiarFactor(CategoriaDeCarga categoria, ChangeEventArgs e)
    {
        var actual = Datos.FactorDeDemanda(categoria);
        var factor = Leer(e, actual, FactorDemandaMinimo, 1m, Factor);
        if (factor == actual)
            return;

        Datos.CambiarFactorDeDemanda(categoria, factor);
        Recalcular();
    }

    private const decimal FactorDemandaMinimo = 0.01m;

    private bool Excede(CircuitoDelCuadro c) =>
        c.Resultado is not null && c.Resultado.CaidaTensionPct > Datos.CaidaMaxDerivadoPct;

    /// <summary>
    /// Cambiar los polos puede no poderse —el espacio de al lado está ocupado, o el interruptor no
    /// cabe—, así que no se enlaza directo: se pregunta al cuadro y, si dice que no, no se hace y el
    /// motivo sale en el aviso flotante, como al soltar un circuito en un espacio ocupado (David,
    /// 2026-09-29). Antes era un renglón de la tabla que se quedaba aunque se borraran los circuitos.
    /// </summary>
    private async Task CambiarPolos(CircuitoDelCuadro circuito, string? valor)
    {
        if (!int.TryParse(valor, out var polos))
            return;

        if (Cuadro.CambiarPolos(circuito, polos) is { } motivo)
        {
            Avisar($"El circuito {circuito.Espacio} no cabe con {polos} polos. {motivo}", bien: false);
            await Restablecer($"[aria-label=\"Circuito {circuito.Espacio} · Polos\"]", circuito.Polos.ToString(CultureInfo.InvariantCulture));
        }
    }

    /// <summary>
    /// Bajo la clase: «15 salidas», «carga total», «sin F.D.», «2 motores, 1 carga» — cómo está
    /// hecha. <c>null</c> sin nada que añadir.
    /// </summary>
    private static string? DetalleDeClase(CircuitoDelCuadro c) =>
        c.ClaseDelCircuito is not { } clase ? null
        : clase == ClaseDeCircuito.Alimentador ? (c.Cargas.Count(x => x.EsTablero) is > 1 and var tableros ? $"{tableros} tableros · sin F.D." : "sin F.D.")
        : c.EsGrupo ? TextoDelGrupo(c)
        : c.Salidas is { } n && clase != ClaseDeCircuito.Individual ? $"{n} {(n == 1 ? "salida" : "salidas")}"
        : c.EsCargaTotal ? "carga total"
        : null;

    /// <summary>«5 HP · FLC 15.20 A», «Ampacidad 18 A · prot. máx. 30 A»: la placa del equipo, bajo sus VA. Un grupo, nada.</summary>
    private static string PlacaDelEquipo(CircuitoDelCuadro c) =>
        c.EsGrupo ? "" // lo que lleva ya va bajo la clase
        : c.EsVariador ? (c.TieneCarga ? $"Variador: entrada {c.CorrienteEntradaVariadorA:#,0.##} A · máx. {c.ProteccionMaximaVariadorA:#,0.##} A" : "")
        : c.EsAireAcondicionado ? (c.TieneCarga ? AireAcondicionadoDePlaca.Texto(c) : "")
        : c.MotorEnAmperes is { } m ? $"{m.Amperes:#,0.##} A ({m.Hp:0.##} HP) · FLC {c.FlcA:N2} A"
        : (c.Hp > 0m ? $"{MotoresEnHp.Texto(c.Hp.Value)} HP" : "") + (c.FlcA > 0m ? $" · FLC {c.FlcA:N2} A" : "");

    /// <summary>Dos canalizaciones con el mismo nombre se verían iguales en «Canal.»: se rechaza — I-94.</summary>
    private async Task RenombrarCanalizacion(CanalizacionDelTablero t, string? nombre)
    {
        if (Datos.RenombrarCanalizacion(t, nombre) is { } motivo)
        {
            Avisar($"{motivo} El nombre de {t.Id} se queda en «{t.Nombre}».", bien: false);
            await Restablecer($"tr[data-canal=\"{t.Id}\"] input[data-col=\"cn-nombre\"]", t.Nombre);
            return;
        }
        Recalcular();
    }

    /// <summary>
    /// Regresa un selector al valor del modelo cuando el modelo no aceptó el cambio — I-79. Blazor no
    /// toca el DOM si el valor no cambió, y el selector se quedaba diciendo lo que se rechazó.
    /// </summary>
    private Task Restablecer(string selector, string valor) =>
        JS.InvokeVoidAsync("powerNode.restablecer", selector, valor).AsTask();

    /// <summary>El área servida — M-14. Vacío o ilegible: sin dato; negativa, se queda la que estaba.</summary>
    private void CambiarArea(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString()?.Trim().Replace(",", "");
        if (string.IsNullOrEmpty(texto))
            Datos.AreaServidaM2 = 0m;
        else if (decimal.TryParse(texto, NumberStyles.Float, CultureInfo.InvariantCulture, out var area) && area >= 0m)
            Datos.AreaServidaM2 = area;
        Recalcular();
    }

    /// <summary>
    /// La clave con la que se guarda un renglón de la Tabla 220-12: su texto hasta la llamada de nota —
    /// «Unidades de vivienda (a)» → «Unidades de vivienda». El modelo lo busca por el principio.
    /// </summary>
    private static string ClaveTabla220_12(string inmueble)
    {
        var i = inmueble.IndexOf(" (", StringComparison.Ordinal);
        return i > 0 ? inmueble[..i] : inmueble;
    }

    // ─── EL DESPLEGABLE POR BLOQUES (acomodo-del-desplegable.md, David, 2026-10-07) ─────────────────────────────
    // Cada línea es un aparato con su cantidad (D1). Las líneas que llevan el mismo juego de columnas van en un
    // bloque, con su fila de encabezados (D4-D7); los bloques, en el orden en que aparece su primera línea. Cada
    // dato que afecta el cálculo, en su columna (R1), de lo general a lo específico (R2, D13). Nada en el pie.

    private enum ColDesglose
    {
        Desc, Tipo, Subtipo, Cant, Tension, Unidad, CargaCU, Hp, CorrientePlaca, CorrienteNominal, CorrienteSeleccion,
        CorrienteTotal, CorrienteEntrada, Ampacidad, ProtMaxFabricante, ProtMaxPlaca, ContinuaTablero, NoContinuaTablero,
        Servicio, NoArranca, Terminal75, Bypass, HpMotor, Arranque225, Fp, Total, Quitar,
    }

    private enum JuegoDeColumnas { Cargas, Motores, Variadores, Motocompresores, Combinada, Habitacion, Tableros }

    /// <summary>Una línea del bloque: un aparato del desglose, o el equipo del renglón (<c>Aparato</c> nulo).</summary>
    private sealed record FilaDelBloque(CargaDelCircuito? Aparato, int N);

    private sealed record BloqueDelDesglose(JuegoDeColumnas Juego, IReadOnlyList<ColDesglose> Columnas, IReadOnlyList<FilaDelBloque> Filas);

    private static JuegoDeColumnas JuegoDe(CargaDelCircuito a) =>
        a.EsTablero ? JuegoDeColumnas.Tableros : a.Clase switch
        {
            ClaseDeAparato.Motor => JuegoDeColumnas.Motores,
            ClaseDeAparato.Variador => JuegoDeColumnas.Variadores,
            ClaseDeAparato.Motocompresor => JuegoDeColumnas.Motocompresores,
            ClaseDeAparato.AireDeHabitacion => JuegoDeColumnas.Habitacion,
            _ => JuegoDeColumnas.Cargas,
        };

    private static JuegoDeColumnas JuegoDe(SubtipoDeCarga s) => s switch
    {
        SubtipoDeCarga.MotorUsoGeneral => JuegoDeColumnas.Motores,
        SubtipoDeCarga.MotorVelocidadAjustable => JuegoDeColumnas.Variadores,
        SubtipoDeCarga.Motocompresor => JuegoDeColumnas.Motocompresores,
        SubtipoDeCarga.CargaCombinada => JuegoDeColumnas.Combinada,
        SubtipoDeCarga.AireDeHabitacion => JuegoDeColumnas.Habitacion,
        _ => JuegoDeColumnas.Cargas,
    };

    /// <summary>Las columnas de un bloque, en el orden de D13. La tensión de placa, solo en el equipo del renglón.</summary>
    private static IReadOnlyList<ColDesglose> ColumnasDe(JuegoDeColumnas juego, bool conTension)
    {
        ColDesglose[] tension = conTension ? [ColDesglose.Tension] : [];
        ColDesglose[] medio = juego switch
        {
            JuegoDeColumnas.Motores => [ColDesglose.Unidad, ColDesglose.Hp, ColDesglose.CorrientePlaca, ColDesglose.Servicio, ColDesglose.NoArranca, ColDesglose.Terminal75],
            JuegoDeColumnas.Variadores => [.. tension, ColDesglose.CorrienteEntrada, ColDesglose.ProtMaxFabricante, ColDesglose.Bypass, ColDesglose.HpMotor],
            JuegoDeColumnas.Motocompresores => [.. tension, ColDesglose.CorrienteNominal, ColDesglose.CorrienteSeleccion, ColDesglose.Arranque225],
            JuegoDeColumnas.Combinada => [.. tension, ColDesglose.Ampacidad, ColDesglose.ProtMaxPlaca],
            JuegoDeColumnas.Habitacion => [.. tension, ColDesglose.CorrienteTotal],
            JuegoDeColumnas.Tableros => [ColDesglose.ContinuaTablero, ColDesglose.NoContinuaTablero],
            _ => [ColDesglose.Unidad, ColDesglose.CargaCU, ColDesglose.Servicio],
        };
        return [ColDesglose.Desc, ColDesglose.Tipo, ColDesglose.Subtipo, ColDesglose.Cant, .. medio, ColDesglose.Fp, ColDesglose.Total, ColDesglose.Quitar];
    }

    private static List<BloqueDelDesglose> BloquesDe(CircuitoDelCuadro c)
    {
        if (c.SubtipoDelRenglon is { } s)
        {
            var juego = JuegoDe(s);
            return [new(juego, ColumnasDe(juego, c.PideTensionDePlaca), [new(null, 0)])];
        }
        if (c.Cargas.Count == 0)
            return [new(JuegoDeColumnas.Cargas, ColumnasDe(JuegoDeColumnas.Cargas, false), [])];
        return [.. c.Cargas.Select((a, i) => new FilaDelBloque(a, i + 1))
            .GroupBy(f => JuegoDe(f.Aparato!))
            .Select(g => new BloqueDelDesglose(g.Key, ColumnasDe(g.Key, false), [.. g]))];
    }

    private static string NombreDelBloque(JuegoDeColumnas j) => j switch
    {
        JuegoDeColumnas.Motores => "Motores",
        JuegoDeColumnas.Variadores => "Variadores",
        JuegoDeColumnas.Motocompresores => "Motocompresores",
        JuegoDeColumnas.Combinada => "Equipos de A/A",
        JuegoDeColumnas.Habitacion => "Acondicionadores de habitación",
        JuegoDeColumnas.Tableros => "Tableros",
        _ => "Cargas",
    };

    /// <summary>
    /// El ancho de base de cada columna, en px, para js/desglose.js: cabe su campo. Las generales (las cuatro del
    /// principio y las tres del final) miden lo mismo en todos los bloques; lo que sobra se reparte entre las demás.
    /// </summary>
    private static int AnchoDe(ColDesglose col) => col switch
    {
        ColDesglose.Desc => 0,
        ColDesglose.Tipo => 130, ColDesglose.Subtipo => 176, ColDesglose.Cant => 76,
        ColDesglose.Tension => 150, ColDesglose.Unidad => 84, ColDesglose.CargaCU => 110, ColDesglose.Hp => 200,
        ColDesglose.CorrientePlaca => 110, ColDesglose.CorrienteNominal => 120, ColDesglose.CorrienteSeleccion => 130,
        ColDesglose.CorrienteTotal => 120, ColDesglose.CorrienteEntrada => 130, ColDesglose.Ampacidad => 130,
        ColDesglose.ProtMaxFabricante => 150, ColDesglose.ProtMaxPlaca => 130,
        ColDesglose.ContinuaTablero => 120, ColDesglose.NoContinuaTablero => 120,
        ColDesglose.Servicio => 190, ColDesglose.NoArranca => 84, ColDesglose.Terminal75 => 96,
        ColDesglose.Bypass => 80, ColDesglose.HpMotor => 170, ColDesglose.Arranque225 => 110,
        ColDesglose.Fp => 74, ColDesglose.Total => 92, _ => 40,
    };

    private static bool EsGeneral(ColDesglose col) =>
        col is ColDesglose.Desc or ColDesglose.Tipo or ColDesglose.Subtipo or ColDesglose.Cant or ColDesglose.Fp or ColDesglose.Total or ColDesglose.Quitar;

    /// <summary>El motocompresor mayor de un grupo: solo él lleva «Arranque 225 %» — 440-22(b)(1) (D10).</summary>
    private static CargaDelCircuito? MotocompresorMayor(CircuitoDelCuadro c) =>
        c.Cargas.Where(a => a.Clase == ClaseDeAparato.Motocompresor).MaxBy(a => a.CorrienteUnitariaA);

    /// <summary>
    /// D1/D2: la cantidad del equipo del renglón. De 2 en adelante pasa a ser la línea del desplegable con esa
    /// cantidad, y el circuito se calcula como grupo; el cálculo lo dice en la memoria, no aquí.
    /// </summary>
    private void CambiarCantidadDelRenglon(CircuitoDelCuadro c, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) || n <= 1 || c.SubtipoDelRenglon is not { } subtipo)
        {
            StateHasChanged();
            return;
        }
        var descripcion = c.DescripcionDelEquipo;
        if (!c.RenglonALineas())
        {
            var linea = new CargaDelCircuito { Descripcion = descripcion, Subtipo = subtipo, FactorPotencia = c.FactorPotencia };
            c.Cargas.Add(linea);
            Nombrar(c, linea);
        }
        c.Cargas[0].Cantidad = n;
        Recalcular();
    }

    private RenderFragment EncabezadoDelDesglose(CircuitoDelCuadro c, BloqueDelDesglose b, ColDesglose col) => __builder =>
    {
        var motores = b.Juego == JuegoDeColumnas.Motores;
        var (texto, ayuda) = col switch
        {
            ColDesglose.Desc => (NombreDelBloque(b.Juego), (string?)null),
            ColDesglose.Tipo => ("Tipo", "Familia de la carga; define su factor de demanda en el alimentador · 220 Parte C"),
            ColDesglose.Subtipo => ("Subtipo", "Qué es la carga dentro de su tipo; define su carga mínima · 220-14"),
            ColDesglose.Cant => ("Cant.", "Cuántas salidas iguales lleva el circuito."),
            ColDesglose.Tension => (c.EsVariador ? "Tensión de entrada" : "Tensión de placa", c.EsVariador ? "Tensión de entrada de la placa del variador." : "Tensión de la placa del equipo."),
            ColDesglose.Unidad => ("Unidad", motores ? "HP: corriente de tabla. A: corriente de placa · 430-6(a)" : "Unidad de la carga: VA, W o A."),
            ColDesglose.CargaCU => ("Carga c/u", "Carga de cada salida."),
            ColDesglose.Hp => ("HP", "Potencia del motor, con su corriente de tabla · 430-6(a)"),
            ColDesglose.CorrientePlaca => ("Corriente de placa (A)", "Corriente de la placa del motor: la que se captura en A, o la de servicio no continuo · 430-22(e)"),
            ColDesglose.CorrienteNominal => ("Corriente nominal (A)", "Corriente de carga nominal de la placa · 440-6(a)"),
            ColDesglose.CorrienteSeleccion => ("Corriente de selección (A)", "Corriente de selección de la placa, si la trae · 440-6(a)"),
            ColDesglose.CorrienteTotal => ("Corriente total (A)", "Corriente total de la placa del acondicionador · 440-62"),
            ColDesglose.CorrienteEntrada => ("Corriente de entrada (A)", "Corriente de entrada de la placa del variador · 430-122(a)"),
            ColDesglose.Ampacidad => ("Ampacidad mínima (A)", "Ampacidad mínima de los conductores, de la placa · 440-4(b)"),
            ColDesglose.ProtMaxFabricante => ("Prot. máx. del fabricante (A)", "Protección máxima permitida por el fabricante · 110-3(b)"),
            ColDesglose.ProtMaxPlaca => ("Prot. máx. de placa (A)", "Protección máxima de la placa · 440-4(b)"),
            ColDesglose.ContinuaTablero => ("Continua (VA)", "Carga continua del otro tablero, ya con sus factores de demanda · 220-40"),
            ColDesglose.NoContinuaTablero => ("No continua (VA)", "Carga no continua del otro tablero, ya con sus factores de demanda · 220-40"),
            ColDesglose.Servicio => ("Servicio", motores ? "Tiempo de trabajo del motor · Tabla 430-22(e)" : "Tiempo de trabajo de la carga: continua (3 h o más) o no continua · 210-19(a)(1)"),
            ColDesglose.NoArranca => ("No arranca", "El motor no arranca con la protección de tabla · 430-52(c)(1)"),
            ColDesglose.Terminal75 => ("Terminal 75 °C", "Motor de diseño B a E con arrancador marcado 75 °C · 110-14(c)"),
            ColDesglose.Bypass => ("Bypass", "El variador tiene bypass a la línea · 430-122(b)"),
            ColDesglose.HpMotor => ("HP del motor", "Potencia del motor que mueve el variador · 430-6(a)"),
            ColDesglose.Arranque225 => ("Arranque 225 %", "No arranca con la protección al 175 % · 440-22(a)"),
            ColDesglose.Fp => ("F.P.", "Factor de potencia de la carga."),
            ColDesglose.Total => ("Total (VA)", "Carga de todas las salidas del renglón, en VA."),
            _ => ("", null),
        };
        <th class="@(col == ColDesglose.Desc ? "izq nombre-bloque" : null)" data-col="@CampoDe(col)">
            @if (ayuda is null) { @texto } else { <span class="ayuda" title="@ayuda">@texto</span> }
        </th>
