                    <span class="tenue">—</span>
                }
            </td>
            @if (alimentador)
            {
                <td class="casilla-canal ultima"><input type="checkbox" data-col="cn-paralelos" aria-label="@CuadroDeCarga.NombreDe(t) · Paralelos en un tubo" title="Paralelos en un tubo — 310-15(b)(3)(a)" checked="@t.JuegosEnUnTubo" @onchange="e => { t.JuegosEnUnTubo = e.Value is true; Recalcular(); }" /></td>
            }
        </tr>;

    /// <summary>
    /// El tamaño en mm o en pulgadas. En tubo es un combo con los tamaños de la Tabla 4, en el que
    /// ya viene el que dio el cálculo; si el ingeniero elige otro, queda fijado (se marca, con ↺ para
    /// regresar al cálculo) y el programa verifica que alcance. En lo demás, texto.
    /// </summary>
    private RenderFragment CeldaTamano(CanalizacionDelTablero t, bool pulgadas) =>
        @<text>
            @if (t.Tipo.EsTubo() && t.Ocupacion is { } o && o.AreaTotalMm2 is not null)
            {
                var calculado = o.TamanoCalculado;
                <div class="tamano-controles">
                    @if (t.CanalizacionesIguales > 1)
                    {
                        <span>@t.CanalizacionesIguales ×</span>
                    }
                    <select class="@(t.TamanoFijado is null ? null : "fijado")" data-col="@(pulgadas ? "cn-in" : "cn-mm")" aria-label="@CuadroDeCarga.NombreDe(t) · Tamaño en @(pulgadas ? "pulgadas" : "mm")"
                            title="@(t.TamanoFijado is null ? "Calculado — Tablas 1 y 4 del Capítulo 10. Elegir otro para fijarlo." : $"Fijado por el ingeniero. El cálculo da {calculado?.Rotulo ?? "ninguno"}.")"
                            value="@(o.Tamano?.DesignacionMetrica.ToString() ?? "")"
                            @onchange="e => FijarTamano(t, e.Value?.ToString())">
                        @if (o.Tamano is null)
                        {
                            <option value="">—</option>
                        }
                        @foreach (var tam in Motor.Tubos.Tamanos(t.Tubo))
                        {
                            <option @key="tam.DesignacionMetrica" value="@tam.DesignacionMetrica">@(pulgadas ? tam.Pulgadas : tam.Milimetros)</option>
                        }
                    </select>
                    @if (!pulgadas && t.TamanoFijado is not null)
                    {
                        <button class="quitar" aria-label="Regresar al tamaño calculado" title="Regresar al cálculo: @(calculado?.Rotulo ?? "ninguno alcanza")" @onclick="() => FijarTamano(t, null)"><Icono Nombre="deshacer" Tamano="14" /></button>
                    }
                </div>
            }
            else
            {
                @(pulgadas ? t.TamanoIn : t.TamanoMm)
            }
        </text>;

    /// <summary>El tipo en el selector, corto para no ensanchar la columna; el nombre completo, en el título.</summary>
    private static string TipoCorto(TipoCanalizacion tipo) => tipo switch
    {
        TipoCanalizacion.Niple => "Niple ≤ 60 cm",
        TipoCanalizacion.CanalAuxiliarMetalico => "Canal aux. metálico",
        TipoCanalizacion.CanalAuxiliarNoMetalico => "Canal aux. no metálico",
        TipoCanalizacion.SuperficialMetalica => "Superficial metálica",
        TipoCanalizacion.SuperficialNoMetalica => "Superficial no metálica",
        _ => tipo.Nombre(),
    };

    /// <summary>Elegir el tamaño que da el cálculo lo deja en automático; otro lo fija.</summary>
    private void FijarTamano(CanalizacionDelTablero t, string? valor)
    {
        t.TamanoFijado = int.TryParse(valor, out var d) && d != t.Ocupacion?.TamanoCalculado?.DesignacionMetrica ? d : null;
        Recalcular();
    }

