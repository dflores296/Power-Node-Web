@page "/"
@inject ProyectoActual Proyecto
@inject MotorNom Motor
@inject NavigationManager Navegacion
@inject IJSRuntime JS
@implements IDisposable
@implements IHandleEvent
@using System.Globalization

@* La pestaña lleva el nombre del tablero: con varias abiertas, dice cuál es cuál (I-05). *@
<PageTitle>@Proyecto.TituloDeVentana</PageTitle>

@* El título de la página va para los lectores de pantalla (y para FocusOnNavigate): a la vista, la
   barra superior ya dice dónde se está (I-58). *@
<h1 class="solo-lector">Captura del cuadro de carga</h1>

<section class="ficha" id="sec-ficha">
    <div class="pila">
    <div class="grupo">
        <h2>Identificación</h2>
        <label>Tablero <input @bind="Datos.Tablero" @bind:event="oninput" @bind:after="DibujarAlPausar" /></label>
        <label>Clave <input @bind="Datos.Clave" @bind:event="oninput" @bind:after="DibujarAlPausar" /></label>
        <label>Ubicación <input @bind="Datos.Ubicacion" @bind:event="oninput" @bind:after="DibujarAlPausar" /></label>
        <label>Proyecto <input @bind="Datos.Proyecto" @bind:event="oninput" @bind:after="DibujarAlPausar" /></label>
        <label>Cliente <input @bind="Datos.Cliente" @bind:event="oninput" @bind:after="DibujarAlPausar" /></label>
    </div>

    <div class="grupo">
        <h2>Sistema</h2>
        @* En 1F-2H no hay dos fases: la tensión es de fase a neutro (I-53). *@
        <label><span class="ayuda" title="@(EsUnaFaseDosHilos ? "Capturar la tensión de fase a neutro: 127 V (o 120 V) — 110-4." : "Capturar la tensión entre fases. 1F-3H: 240 V (120/240). 2F-3H y 3F-4H: 220 V (220Y/127) o 208 V (208Y/120). 3F-3H: 220, 240, 480 V… — 110-4.")">@(EsUnaFaseDosHilos ? "Tensión F-N (V)" : "Tensión F-F (V)")</span>
            <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="@Numero(DatosDelTablero.TensionMinimaV)" step="1" value="@Numero(Datos.TensionFaseFaseV)" @onchange="e => { Datos.TensionFaseFaseV = Leer(e, Datos.TensionFaseFaseV, DatosDelTablero.TensionMinimaV); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Seleccionar los conductores energizados. 1: una fase y neutro (1F-2H) o monofásico con derivación central, 120/240 V (1F-3H). 2: dos fases de un sistema en estrella, 220/127 V (2F-3H, el «bifásico»). 3: trifásico.">Fases</span>
            <select id="campo-fases" value="@Datos.Fases" @onchange="CambiarFases">@foreach (var f in new[] { 1, 2, 3 }) { <option value="@f">@f</option> }</select></label>
        <label><span class="ayuda" title="Hilos = fases + neutro. La tierra no se cuenta: fase, neutro y tierra es 1F-2H. 1F-3H es otro sistema: dos vivos en oposición y neutro, 120/240 V.">Hilos</span>
            <select id="campo-hilos" value="@Datos.Hilos" @onchange="CambiarHilos">@foreach (var h in Datos.HilosValidos) { <option value="@h">@h</option> }</select></label>
        <label>Frecuencia (Hz) <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="@DatosDelTablero.FrecuenciaMinimaHz" step="10" @bind="Datos.FrecuenciaHz" @bind:culture="CultureInfo.InvariantCulture" /></label>
        <p class="derivado">
            @Datos.EtiquetaSistema ·
            Tensión F-N <strong>@Datos.TensionFaseNeutroV.ToString("N1") V</strong> ·
            barras <strong>@string.Join(" ", Datos.Barras)</strong>
        </p>
        @if (Datos.AvisoTension is { } avisoTension)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoTension</span></p>
        }
    </div>
    </div>

    <div class="grupo">
        <h2>Gabinete</h2>
        <label>Espacios <select id="campo-espacios" value="@Datos.NumeroEspacios" @onchange="CambiarEspacios">
            @foreach (var e in Datos.EspaciosValidos) { <option value="@e">@e</option> }
        </select></label>
        <label>Acometida <select @bind="Datos.TipoAcometida" @bind:after="Recalcular">
            <option value="@TipoAcometidaTablero.InterruptorPrincipal">Interruptor principal</option>
            <option value="@TipoAcometidaTablero.ZapatasPrincipales">Zapatas principales</option>
        </select></label>
        @* Dónde va el principal — decisión montaje-del-interruptor-principal (I-68). Con una barra no
           hay zócalo: siempre va en un espacio. *@
        @if (Datos.UsaInterruptorPrincipal && Datos.Barras.Count > 1)
        {
            <label><span class="ayuda" title="Zócalo propio: abajo de las barras, sin ocupar espacios numerados. En espacios: como un derivado, se come tantos espacios como polos; por omisión, los últimos pares.">Montaje del principal</span>
                <select @bind="Datos.MontajePrincipal" @bind:after="Recalcular">
                    <option value="@MontajeDelPrincipal.Zocalo">Zócalo propio</option>
                    <option value="@MontajeDelPrincipal.EnEspacios">En espacios del gabinete</option>
                </select></label>
        }
        @if (Datos.PrincipalEnEspacios)
        {
            <label><span class="ayuda" title="Los espacios que se come el interruptor principal. Es un valor por omisión: se puede mover a donde quepa sin pisar un circuito.">Espacios del principal</span>
                <select value="@Cuadro.EspacioInicialDelPrincipal" @onchange="CambiarEspacioDelPrincipal">
                    @foreach (var e in Datos.EspaciosValidosDelPrincipal)
                    {
                        <option value="@e">@string.Join("-", DistribucionBarras.EspaciosQueOcupa(e, Datos.PolosDelPrincipal))</option>
                    }
                </select></label>
        }
        @if (Cuadro.AvisoDelPrincipal is { } avisoPrincipal)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoPrincipal</span></p>
        }
        <label>Montaje <select @bind="Datos.Montaje">
            <option value="Sobreponer">Sobreponer</option>
            <option value="Empotrar">Empotrar</option>
        </select></label>
        <label>Barras <select @bind="Datos.MaterialBarras">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label>Gabinete NEMA <select @bind="Datos.GabineteNema">
            @foreach (var n in new[] { "1", "3R", "4X", "12" }) { <option value="@n">@n</option> }
        </select></label>
        <label>Capacidad de barra (A) <input type="text" inputmode="decimal" autocomplete="off" data-numero min="0" step="1" placeholder="—"
                                             @bind="Datos.CapacidadBarraA" @bind:culture="CultureInfo.InvariantCulture" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Seleccionar la familia de interruptores. Centro de carga (NEMA): 240-6(a) sin 16, 32 ni 63 A. Riel DIN (IEC): 16, 20, 25, 32, 40, 50, 63, 80, 100 y 125 A. NOM completa: 240-6(a) sin exclusiones.">Interruptores</span>
            <select @bind="Datos.SerieInterruptores" @bind:after="Recalcular">
                @foreach (var serie in new[] { SerieDeInterruptores.CentroDeCargaNema, SerieDeInterruptores.RielDinIec, SerieDeInterruptores.NomCompleta })
                {
                    <option value="@serie">@serie.Nombre()</option>
                }
            </select></label>
        <label><span class="ayuda" title="Seleccionar el inmueble. Decide dos cosas: el mínimo del principal si el tablero es equipo de acometida — 230-79 (vivienda unifamiliar: según la carga; vivienda popular hasta 60 m²: 30 A; los demás: 60 A) — y qué justificaciones del factor de demanda aplican — Tabla 220-42, vivienda o no vivienda.">Inmueble</span>
            <select @bind="Datos.Inmueble" @bind:after="Recalcular">
                @foreach (var inmueble in Enum.GetValues<TipoDeInmueble>()) { <option value="@inmueble">@inmueble.Nombre()</option> }
            </select></label>
        <label><span class="ayuda" title="Marcar si el tablero es el medio de desconexión de la acometida (el primero después del medidor). El principal sube al mínimo de 230-79 según el inmueble.">Equipo de acometida</span>
            <input type="checkbox" class="casilla" @bind="Datos.EsEquipoDeAcometida" @bind:after="Recalcular" /></label>
    </div>

    <div class="grupo">
        <h2>Condiciones de cálculo</h2>
        <label>Conductor <select @bind="Datos.MaterialConductor" @bind:after="Recalcular">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label><span class="ayuda" title="Seleccionar el aislamiento — Tabla 310-104(a). Determina la columna de temperatura de la Tabla 310-15(b)(16) para aplicar FT y FA. Ampacidad limitada a la temperatura de la terminal — 110-14(c).">Aislamiento</span>
            <select @bind="Datos.TipoAislamiento" @bind:after="Recalcular">
                @foreach (var aislamiento in Aislamientos)
                {
                    <option value="@aislamiento">@aislamiento@(EnTabla5(aislamiento) ? "" : " · diámetro del fabricante")</option>
                }
            </select></label>
        <label><span class="ayuda" title="Declarar la temperatura de las terminales del interruptor y del equipo — 110-14(c)(1). Regla general: 60 °C hasta 100 A; 75 °C arriba de 100 A. Marcadas 75 °C: aplicar solo si ambas terminales lo indican — a.(3). Conductor de 60 °C: usar 60 °C — a.(1).">Terminales</span>
            <select @bind="Terminales" @bind:after="Recalcular">
                <option value="60">60 °C hasta 100 A (regla general)</option>
                <option value="75">Marcadas 75 °C</option>
            </select></label>
        <label><span class="ayuda" title="Seleccionar el lugar de instalación — Tabla 310-104(a). Determina la temperatura del aislamiento (THHW-LS: 90 °C seco, 75 °C mojado) y su validez (THHN: solo lugar seco).">Lugar</span>
            <select @bind="Lugar" @bind:after="Recalcular">
                <option value="seco">Seco</option>
                <option value="mojado">Húmedo o mojado</option>
            </select></label>
        <label>T. ambiente (°C) <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="10" max="80" step="1" value="@Numero(Datos.TemperaturaAmbienteC)" @onchange="e => { Datos.TemperaturaAmbienteC = Leer(e, Datos.TemperaturaAmbienteC); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Marcar si la mayor parte de la carga es no lineal (electrónica, iluminación LED, equipo de cómputo): en 3F-4H el neutro lleva armónicas y cuenta como portador — 310-15(b)(5)(3).">Carga no lineal</span>
            <input type="checkbox" class="casilla" @bind="Datos.CargaNoLineal" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del circuito derivado. Recomendado: 3 % — 210-19(a)(1), NOTA 4.">e% máx. derivado</span> <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="0.5" max="10" step="0.5" value="@Numero(Datos.CaidaMaxDerivadoPct)" @onchange="e => { Datos.CaidaMaxDerivadoPct = Leer(e, Datos.CaidaMaxDerivadoPct); Recalcular(); }" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del alimentador. Valor inicial: 2 %, para que con el 3 % del derivado sumen el 5 % combinado — 215-2(a)(4), NOTA 2; 210-19(a)(1), NOTA 4.">e% máx. alimentador</span> <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="0.5" max="10" step="0.5" value="@Numero(Datos.CaidaMaxAlimentadorPct)" @onchange="e => { Datos.CaidaMaxAlimentadorPct = Leer(e, Datos.CaidaMaxAlimentadorPct); Recalcular(); }" /></label>
        @if (Datos.AvisoLimitesDeCaida is { } avisoLimites)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoLimites</span></p>
        }
        @if (Cuadro.AvisoAislamientoDelLugar is { } avisoLugar)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoLugar</span></p>
        }
        @* El diámetro del fabricante va con el aislamiento, que es uno para todo el tablero (David,
           2026-09-28); antes se pedía al pie de la tarjeta de canalizaciones. Capítulo 10, Nota 5. *@
        @if (Cuadro.AvisoDiametroDelFabricante is { } avisoDiametro)
        {
            <p class="aviso"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@avisoDiametro</span></p>
            @foreach (var designacion in Cuadro.CalibresConDiametroDelFabricante)
            {
                var clave = DatosDelTablero.ClaveDiametro(Datos.TipoAislamiento, designacion);
                var calibre = Calibre.UnidadDe(designacion);
                <label><span class="ayuda" title="Capturar el diámetro exterior del conductor @Datos.TipoAislamiento de @calibre, del catálogo del fabricante — Capítulo 10, Nota 5. Vacío: sin dato; si la Tabla 5 lo trae, regresa a ella.">Ø @calibre (mm)</span>
                    <input type="text" inputmode="decimal" autocomplete="off" data-numero min="0" step="0.01" placeholder="—" aria-label="Diámetro exterior del fabricante · @calibre (mm)"
                           value="@(Datos.DiametrosFabricante.TryGetValue(clave, out var d) ? Numero(d) : "")"
                           @onchange="e => CambiarDiametro(clave, e.Value?.ToString())" /></label>
            }
        }
    </div>
</section>

<section class="cuadro-completo" id="sec-cuadro">
    <table class="cuadro">
        <thead>
            @*
                Encabezados en UN renglón con la unidad entre paréntesis —«In (A)», «L (m)», «e (%)»—
                y no partidos en dos líneas: partidos, las columnas de una sola línea quedaban
                desalineadas con las de dos y el cuadro se leía torcido. Lo que no cabe en el rótulo
                va en el tooltip, no en una segunda línea.
            *@
            <tr>
                <th rowspan="2"><span class="ayuda" title="@(Cuadro.UnaSolaBarra ? "Identificar el circuito por su espacio en la barra. Una sola barra: en orden." : "Identificar el circuito por su espacio en la barra. Nones arriba, pares abajo.")">N.º</span></th>
                <th rowspan="2" class="izq descripcion" data-col="desc" title="Describir el circuito. Ctrl+Enter abre o cierra el desglose de sus aparatos.">Descripción</th>
                <th rowspan="2" data-col="tipo"><span class="ayuda" title="Seleccionar el tipo de carga. Determina el factor de demanda del resumen — Art. 220.&#10;&#10;Alumbrado: luminarias y alumbrado general.&#10;Contactos: contactos de uso general; en vivienda, seleccionar el uso (cocina, lavadora, baño).&#10;Equipo: aparatos con su valor de placa, también con motor o compresor: hornos, estufas, secadoras, lavadoras, lavavajillas, calentadores de agua, refrigeradores domésticos (son aparatos — 440-3(c)), equipo electrónico — Art. 422.&#10;Motor: bombas, ventiladores, extractores, compresores de aire; manejadoras sin motocompresor (440-3(b)) — Art. 430.&#10;A/C y refrigeración: minisplit, paquete, condensadora, cámara comercial (motocompresor hermético) — Art. 440.&#10;Calefacción: calefacción por resistencia eléctrica: calefactores, cables calefactores, calderas eléctricas; carga continua — 424-3(b).&#10;&#10;Motor y A/C se calculan con su propio artículo y entran al alimentador por 430-24 / 440-33. 240-4(b) no aplica en contactos.">Tipo</span></th>
                <th colspan="4"><span class="ayuda" title="Capturar la carga de placa en VA, W o A y su factor de potencia. Continua (3 h o más): 125 % — 210-19(a)(1), 210-20(a). No continua: 100 %. En W o A, consultar abajo el VA de cálculo.&#10;&#10;Motor: los HP, o los amperes si la placa no trae HP. La corriente sale de la tabla — 430-6(a).&#10;A/C y refrigeración: MCA y MOCP de la placa (440-4(b)), o la corriente de carga nominal del compresor y la de selección si viene (440-6(a)).">Carga</span></th>
                <th colspan="@Datos.Barras.Count"><span class="ayuda" title="Consultar la carga del circuito repartida entre las barras que toca.">Balanceo de fases <span class="simbolo">(VA)</span></span></th>
                <th rowspan="2" class="col-res" data-col="l"><span class="ayuda" title="Capturar la longitud del circuito. Determina la caída de tensión — Tabla 9."><span class="simbolo">L (m)</span></span></th>
                <th rowspan="2" data-col="canal"><span class="ayuda" title="Seleccionar la canalización del circuito de la lista de la tarjeta «Canalizaciones». Al capturar la carga, cada circuito nace en la suya (T1, T2…); para agrupar, elegir la de otro circuito, o «+ Nueva». Los circuitos de una misma canalización se agrupan y el programa cuenta sus portadores — 310-15(b)(3)(a). Si el circuito pasa por varias, la del tramo más desfavorable — 310-15(a)(2). Debajo: el tamaño que resultó.">Canal.</span></th>
                <th rowspan="2" class="col-res" data-col="polos masn"><span class="ayuda" title="Seleccionar los polos del interruptor. Un multipolar ocupa los espacios N, N+2 y N+4 del mismo lado.">P</span></th>
                <th rowspan="2" class="col-res"><span class="ayuda" title="Consultar la corriente de diseño de la carga capturada — 210-19(a)(1)."><span class="simbolo">In (A)</span></span></th>
                <th rowspan="2" class="col-res dos-lineas"><span class="ayuda" title="Consultar la protección: primer tamaño normalizado mayor o igual a la capacidad mínima — 240-6(a), 210-20(a). Pasar el cursor sobre el valor para consultar el desglose.">Protec.<br /><span class="simbolo">(A)</span></span></th>
                <th rowspan="2" class="col-res"><span class="ayuda" title="Consultar el conductor de fase: designación AWG/kcmil y, debajo, su sección (mm²) — Tabla 8. Si lleva conductores en paralelo, «2 ×» antes del calibre. Pasar el cursor sobre el calibre para consultar el desglose.&#10;&#10;Colores de fase: la NOM no los fija — 210-5(c)(2) —; se usan negro, rojo y azul, la práctica común.">Fase</span></th>
                <th rowspan="2" class="col-res"><span class="ayuda" title="Consultar el conductor de neutro. Blanco o gris claro — 200-6.">Neutro</span></th>
                <th rowspan="2" class="col-res"><span class="ayuda" title="Consultar el conductor de puesta a tierra de equipos — Tabla 250-122 y 250-122(b). Verde, o verde con franjas amarillas — 250-119.">Tierra</span></th>
                <th rowspan="2" class="ultima col-res"><span class="ayuda" title="Consultar la caída de tensión del circuito. Límite recomendado: 3 % en el derivado y 5 % combinada — 210-19(a)(1), nota 4."><span class="simbolo">e (%)</span></span></th>
            </tr>
            <tr>
                <th data-col="unidad"><span class="ayuda" title="Seleccionar la unidad de placa. W: convertir con el factor de potencia. A: convertir con la tensión y los polos del circuito.&#10;&#10;Motor: HP, o A si la placa no trae HP — 430-6(a)(1).&#10;A/C y refrigeración: MCA (ampacidad mínima y protección máxima, 440-4(b)) o A (corriente de carga nominal, 440-6(a)).">Unidad</span></th>
                <th data-col="continua"><span class="ayuda" title="Capturar la carga que opera 3 h o más. Aplicar 125 % — 210-19(a)(1), 210-20(a).">Continua</span></th>
                <th data-col="nocontinua"><span class="ayuda" title="Capturar la carga que opera menos de 3 h. Aplicar 100 %.">No continua</span></th>
                <th data-col="fp"><span class="ayuda" title="Capturar el factor de potencia de la carga. Valor inicial: 0.9.&#10;&#10;Capturada en W: VA = W ÷ F.P. Modifica corriente, protección, conductor, caída de tensión y kW.&#10;&#10;Capturada en VA o A: modifica solo la caída de tensión (y el conductor, si excede el límite) y los kW — Tabla 9, nota 2.">F.P.</span></th>
                @foreach (var barra in Datos.Barras)
                {
                    <th class="col-fase"><span class="ayuda" title="Consultar la carga que el circuito asigna a la barra @barra."><span class="fase-rect fase-rect-@char.ToLowerInvariant(barra)">@barra</span></span></th>
                }
            </tr>
        </thead>
        <tbody>
            @*
                Los nones arriba y los pares abajo, separados por un renglón delgado — es como está
                armado el Excel (filas 34-54, una fila en blanco de 6 pt, y 56-76), y ahí NO hay
                ningún rótulo de "lado": el número de circuito dice de qué columna del gabinete es.

                Van en UNA sola tabla y no en dos, aunque se vean como dos bloques: dos tablas
                independientes calculan sus anchos de columna por separado, y los renglones de
                abajo no cuadrarían con los de arriba.

                UN MULTIPOLAR ES UN SOLO RENGLÓN ALTO. Sus celdas se combinan hacia abajo cubriendo
                los espacios que ocupa —así se VE que abarca tres—, menos la columna del número, que
                sigue renglón por renglón porque 1 / 3 / 5 es justo lo que se quiere leer. Misma
                decisión que el exportador de escritorio, tomada con esta misma queja: antes decía
                "↳ ocupado por el circuito 1" en cada espacio, y eso se LEE en vez de VERSE.
            *@
            @foreach (var (lado, indice) in Lados.Select((b, i) => (b, i)))
            {
                @if (indice > 0)
                {
                    <tr class="separador"><td colspan="@Columnas"></td></tr>
                }

                @foreach (var c in lado.Where(x => !x.EsContinuacion))
                {
                    @* El interruptor principal en espacios: un renglón que dice lo que es, sin captura (I-68). *@
                    if (c.EsDelPrincipal)
                    {
                        <tr class="fila-principal" data-espacio="@c.Espacio">
                            <td class="num asa" data-arrastre="@c.Espacio" data-destino="@c.Espacio" data-etiqueta="Interruptor principal" data-principal="1" title="Arrastrar para mover el interruptor principal, también al zócalo">@NumeroConFase(c.Espacio)</td>
                            <td colspan="@(Columnas - 1)" rowspan="@Cuadro.EspaciosDelPrincipal.Count">
                                <strong>Interruptor principal</strong>@(Cuadro.InterruptorPrincipalA > 0m ? $" · {Cuadro.InterruptorPrincipalA:N0} A" : "") · @Polos(Datos.PolosDelPrincipal) · @(Datos.Barras.Count == 1 ? "alimenta la barra" : "alimenta las barras")
                            </td>
                        </tr>
                        @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                        {
                            <tr class="fila-principal"><td class="num asa" data-arrastre="@seguido.Espacio" data-destino="@seguido.Espacio" data-etiqueta="Interruptor principal" data-principal="1" title="Arrastrar para mover el interruptor principal, también al zócalo">@NumeroConFase(seguido.Espacio)</td></tr>
                        }
                        continue;
                    }
                    <tr class="@(c.Resultado is null ? "vacio" : null) @(LlevaNotas(c) ? "con-nota" : null) @(c.Polos == 2 ? "dos-polos" : null)" data-espacio="@c.Espacio">
                        <td class="num @(c.TieneCaptura ? "asa" : null)" data-destino="@c.Espacio" data-arrastre="@(c.TieneCaptura ? c.Espacio : null)" data-etiqueta="@EtiquetaDeArrastre(c)" title="@(c.TieneCaptura ? "Arrastrar para mover el circuito a otro espacio" : null)">@NumeroConFase(c.Espacio)</td>
                        <td rowspan="@c.Polos">
                            <div class="desc-linea">
                                <button class="desglosar" tabindex="-1" aria-label="Desglose del circuito @c.Espacio" aria-expanded="@(Abierto(c) ? "true" : "false")" disabled="@(c.EsDeMotor && !c.EsGrupo)"
                                        title="@(c.EsGrupo ? "Los motores y las otras cargas del circuito — 430-53. Con el teclado: Ctrl+Enter."
                                                 : c.EsMotor ? "Un motor solo no se desglosa — 430-22. Para varios motores, o motores y otras cargas, en un circuito: «Varios» en la unidad — 430-53."
                                                 : c.EsAireAcondicionado ? "Un equipo de A/C no se desglosa: es una sola máquina con su placa — 440-4(b)."
                                                 : "Desglosar los aparatos que alimenta el circuito. La carga del circuito es la suma. Con el teclado: Ctrl+Enter.")"
                                        @onclick="() => AlternarDesglose(c)"><Icono Nombre="@(Abierto(c) ? "desglose-abierto" : "desglose")" Tamano="14" /></button>
                                <input class="desc" data-col="desc" aria-label="Circuito @c.Espacio · Descripción" @bind="c.Descripcion" @bind:event="oninput" @bind:after="DibujarAlPausar" placeholder="—" />
                            </div>
                            @if (c.EsGrupo)
                            {
                                <span class="en-va izq">(@TextoDelGrupo(c))</span>
                            }
                            else if (c.TieneDesglose)
                            {
                                <span class="en-va izq">(@c.Aparatos.Sum(x => x.Cantidad) aparato@(c.Aparatos.Sum(x => x.Cantidad) == 1 ? "" : "s"))</span>
                            }
                        </td>
                        <td rowspan="@c.Polos">
                            <div class="tipo-uso">
                            @* Sin icono (David, 2026-09-29 — I-112): el selector ya dice el tipo; el icono queda en el
                               resumen de carga. Sin tipo elegido, «—» y el renglón no calcula (I-111). *@
                            <select class="tipo @(c.TipoElegido ? null : "sin-elegir")" data-col="tipo" aria-label="Circuito @c.Espacio · Tipo" title="@(c.TipoElegido ? c.Categoria.Descripcion() : "Seleccionar el tipo de carga. Decide el factor de demanda y el cálculo.")"
                                    value="@(c.TipoElegido ? c.Categoria.ToString() : "")" @onchange="e => ElegirTipo(c, e.Value?.ToString())">
                                @if (!c.TipoElegido)
                                {
                                    <option value="">—</option>
                                }
                                @foreach (var categoria in Enum.GetValues<CategoriaDeCarga>()) { <option value="@categoria">@categoria.Nombre()</option> }
                            </select>
                            @* El uso solo cuenta en vivienda de más de 60 m² — 210-11(c), 220-52 (I-46). *@
                            @if (c.Tipo == TipoCarga.Contactos && Datos.Inmueble.AplicaUsoDeContactos())
                            {
                                <select class="tipo uso" data-col="uso" aria-label="Circuito @c.Espacio · Uso de los contactos" title="Seleccionar el uso del circuito de contactos. Cocina = aparatos pequeños (cocina, despensa, comedor, desayunador), lavadora y baño llevan 20 A — 210-11(c) — y solo esas salidas — 210-52(b)(2), 210-11(c)(2) y (3). Aparatos pequeños y lavadora cuentan 1500 VA en el alimentador — 220-52. Refrigerador: el contacto del refrigerador en su propio circuito, de 15 A o más — 210-52(b)(1) Excepción 2 —, fuera de los 1500 VA — 220-52(a) Excepción; conectado a los contactos de la cocina, va en Cocina y no se captura aparte. Solo en vivienda; no en la popular de hasta 60 m² ni fuera de vivienda."
                                        @bind="c.Uso" @bind:after="Recalcular">
                                    @foreach (var uso in Enum.GetValues<UsoDeContactos>()) { <option value="@uso">@uso.NombreCorto()</option> }
                                </select>
                                @if (c.Ajuste220_52VA > 0m)
                                {
                                    @* Notas cortas, en una línea; la referencia, en el título (David, 2026-09-29): partidas en
                                       dos renglones, «Exc. 2» quedaba solo y la celda se veía amontonada. *@
                                    <span class="en-va" title="Entra al alimentador con 1,500 VA — @c.UsoEfectivo.ReferenciaCargaMinima().">1,500 VA al alimentador</span>
                                }
                                else if (c.UsoEfectivo.Nota() is { } nota)
                                {
                                    <span class="en-va" title="210-52(b)(1) Excepción 2. @nota">Circuito individual</span>
                                }
                            }
                            </div>
                        </td>
                        <td rowspan="@c.Polos">
                            <select class="unidad" data-col="unidad" aria-label="Circuito @c.Espacio · Unidad" value="@UnidadDe(c)" @onchange="e => CambiarUnidad(c, e.Value?.ToString())" disabled="@(c.TieneDesglose && !c.EsGrupo)" title="@AyudaUnidad(c)">
                                @if (c.EsMotor)
                                {
                                    <option value="@nameof(CapturaDeMotor.Hp)">HP</option>
                                    <option value="@nameof(CapturaDeMotor.Amperes)">A</option>
                                    <option value="@nameof(CapturaDeMotor.Grupo)">Varios</option>
                                }
                                else if (c.EsAireAcondicionado)
                                {
                                    <option value="@nameof(PlacaDeAireAcondicionado.AmpacidadYProteccion)">MCA</option>
                                    <option value="@nameof(PlacaDeAireAcondicionado.CorrienteNominal)">A</option>
                                }
                                else
                                {
                                    <option value="@UnidadConsumo.VoltAmperes">VA</option>
                                    <option value="@UnidadConsumo.Watts">W</option>
                                    <option value="@UnidadConsumo.Amperes">A</option>
                                }
                            </select>
                        </td>
                        @* I-15, I-74: un motor o un equipo de A/C no tiene continua ni no continua; su placa ocupa las dos celdas. *@
                        @if (c.EsMotor && c.CapturaMotor == CapturaDeMotor.Hp)
                        {
                            <td rowspan="@c.Polos" colspan="2">
                                @* Los HP de las tres alimentaciones, agrupados: elegir uno de otra cambia los polos (I-114).
                                   Antes solo se veían los de los polos del renglón, que nace en 1: un motor trifásico
                                   pedía cambiar P primero, hasta el otro extremo del renglón. *@
                                <select class="hp" data-col="continua" aria-label="Circuito @c.Espacio · HP" value="@ValorHpConPolos(c.Polos, c.Hp ?? 0m)" @onchange="e => CambiarHp(c, e.Value?.ToString())"
                                        title="Seleccionar los caballos de placa del motor, con su corriente de tabla, agrupados por alimentación: elegir uno de otro grupo cambia los polos. La corriente sale de la tabla, no de la placa — 430-6(a). Dos polos a 220 V es monofásico (Tabla 430-248). Si la placa solo trae amperes, elegir A en la unidad.">
                                    <option @key="@($"{c.Polos}|0")" value="@ValorHpConPolos(c.Polos, 0m)">—</option>
                                    @* @key: la lista cambia con los polos (1 fase ↔ 3 fases); sin llave, Blazor reutilizaba las
                                       opciones por posición y el selector decía «15 HP» con el motor en 5 (como I-45). *@
                                    @for (var p = 1; p <= Datos.MaximoPolos; p++)
                                    {
                                        var polos = p;
                                        var disponibles = Cuadro.HpDisponibles(polos);
                                        if (disponibles.Count == 0) { continue; }
                                        <optgroup @key="@($"g{polos}")" label="@Cuadro.AlimentacionDelMotor(polos) · @polos @(polos == 1 ? "polo" : "polos")">
                                            @foreach (var hp in disponibles) { <option @key="@ValorHpConPolos(polos, hp)" value="@ValorHpConPolos(polos, hp)">@MotoresEnHp.Texto(hp) HP — @Cuadro.FlcDe(hp, polos).ToString("N2") A</option> }
                                        </optgroup>
                                    }
                                    @if (c.Hp is > 0m and { } fuera && !Cuadro.HpDisponibles(c).Contains(fuera))
                                    {
                                        <option @key="@($"fuera|{fuera}")" value="@ValorHpConPolos(c.Polos, fuera)">@MotoresEnHp.Texto(fuera) HP</option>
                                    }
                                </select>
                                <span class="en-va" title="@(c.FlcA > 0m ? $"Corriente a plena carga de la {Cuadro.FuenteDeFlc(c)} — 430-6(a): {c.FlcA:N2} A. La carga en VA es la FLC por la tensión del circuito{(c.Polos == 3 ? " por √3" : "")}: {c.MotorVA:#,0} VA." : $"La FLC sale de la {Cuadro.FuenteDeFlc(c)} — 430-6(a).")">@Cuadro.AlimentacionDelMotor(c.Polos)</span>
                            </td>
                        }
                        else if (c.EsGrupo)
                        {
                            @* I-115: la corriente del grupo es la suma de sus máquinas; se captura en el desglose. *@
                            <td rowspan="@c.Polos" colspan="2">
                                <input class="va" type="text" data-col="continua" aria-label="Circuito @c.Espacio · Corriente de los motores (A)" disabled
                                       value="@(c.CorrienteDeMotorA > 0m ? $"{c.CorrienteDeMotorA:N2} A" : "")" placeholder="A"
                                       title="Suma de las corrientes de los motores del desglose (la flecha junto a la descripción), cada uno con su FLC de tabla — 430-6(a). Conductor por 430-24; protección por 430-53(c)(4)." />
                                <span class="en-va">@Cuadro.AlimentacionDelMotor(c.Polos)</span>
                            </td>
                        }
                        else if (c.EsMotor)
                        {
                            <td rowspan="@c.Polos" colspan="2">
                                <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="continua" aria-label="Circuito @c.Espacio · Corriente de placa del motor (A)" value="@Carga(c.CorrientePlacaA)" @onchange="e => { c.CorrientePlacaA = LeerCarga(e, c.CorrientePlacaA); Recalcular(); }"
                                       title="Capturar la corriente de placa de un motor que no trae HP. Se toman los HP que le corresponden en la tabla, interpolando; su FLC es esa corriente — 430-6(a)(1)." />
                                @if (c.MotorEnAmperes is { } m)
                                {
                                    <span class="en-va" title="@MotoresEnHp.Interpolacion(m, c.Polos) — 430-6(a)(1). La carga en VA es la FLC por la tensión del circuito@(c.Polos == 3 ? " por √3" : ""): @c.MotorVA.ToString("#,0") VA. @Cuadro.AlimentacionDelMotor(c.Polos).">@m.Hp.ToString("0.##") HP · @MotoresEnHp.AlimentacionTexto(c.Polos, MotoresEnHp.Tension(c.Polos, Datos.TensionFaseNeutroV, Datos.TensionFaseFaseV))</span>
                                }
                                else
                                {
                                    <span class="en-va">@Cuadro.AlimentacionDelMotor(c.Polos)</span>
                                }
                            </td>
                        }
                        else if (c.EsAireAcondicionado && c.PlacaAire == PlacaDeAireAcondicionado.AmpacidadYProteccion)
                        {
                            <td rowspan="@c.Polos">
                                <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="MCA" data-col="continua" aria-label="Circuito @c.Espacio · Ampacidad mínima (MCA)" value="@Carga(c.AmpacidadMinimaA)" @onchange="e => { c.AmpacidadMinimaA = LeerCarga(e, c.AmpacidadMinimaA); Recalcular(); }"
                                       title="Capturar la ampacidad mínima de los conductores que marca la placa (MCA, «Min. circuit ampacity») — 440-4(b). Ya trae el 125 % del motor mayor." />
                                <span class="en-va" title="@(c.MotorVA > 0m ? $"{c.MotorVA:#,0} VA: la MCA por la tensión del circuito." : null)">MCA · @MotoresEnHp.AlimentacionTexto(c.Polos, MotoresEnHp.Tension(c.Polos, Datos.TensionFaseNeutroV, Datos.TensionFaseFaseV))</span>
                            </td>
                            <td rowspan="@c.Polos">
                                <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="MOCP" data-col="nocontinua" aria-label="Circuito @c.Espacio · Protección máxima (MOCP)" value="@Carga(c.ProteccionMaximaA)" @onchange="e => { c.ProteccionMaximaA = LeerCarga(e, c.ProteccionMaximaA); Recalcular(); }"
                                       title="Capturar la protección máxima que marca la placa (MOCP, «Max. fuse / breaker») — 440-4(b). La protección del circuito no la excede." />
                                <span class="en-va">MOCP</span>
                            </td>
                        }
                        else if (c.EsAireAcondicionado)
                        {
                            <td rowspan="@c.Polos">
                                <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="continua" aria-label="Circuito @c.Espacio · Corriente de carga nominal (A)" value="@Carga(c.CorrientePlacaA)" @onchange="e => { c.CorrientePlacaA = LeerCarga(e, c.CorrientePlacaA); Recalcular(); }"
                                       title="Capturar la corriente de carga nominal del motocompresor que marca la placa (RLA) — 440-6(a). Conductor al 125 % (440-32); protección hasta 175 % (440-22(a))." />
                                <span class="en-va" title="@(c.MotorVA > 0m ? $"{c.MotorVA:#,0} VA: la corriente por la tensión del circuito." : null)">Nominal · @MotoresEnHp.AlimentacionTexto(c.Polos, MotoresEnHp.Tension(c.Polos, Datos.TensionFaseNeutroV, Datos.TensionFaseFaseV))</span>
                            </td>
                            <td rowspan="@c.Polos">
                                <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="—" data-col="nocontinua" aria-label="Circuito @c.Espacio · Corriente de selección del circuito (A)" value="@Carga(c.CorrienteSeleccionA ?? 0m)" @onchange="e => { var v = LeerCarga(e, c.CorrienteSeleccionA ?? 0m); c.CorrienteSeleccionA = v > 0m ? v : null; Recalcular(); }"
                                       title="Capturar la corriente de selección del circuito derivado, si la placa la trae. Si es mayor que la nominal, se usa ella — 440-6(a) Excepción 1." />
                                <label class="mas-n" title="Marcar si la protección al 175 % no conduce la corriente de arranque del equipo: el máximo sube a 225 % — 440-22(a).">
                                    <input type="checkbox" aria-label="Circuito @c.Espacio · No arranca al 175 %" checked="@c.ArranqueAl225" @onchange="e => { c.ArranqueAl225 = e.Value is true; Recalcular(); }" />225 %</label>
                            </td>
                        }
                        else
                        {
                        <td rowspan="@c.Polos">
                            <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="continua" aria-label="Circuito @c.Espacio · Continua" value="@Carga(c.Continua)" @onchange="e => { c.Continua = LeerCarga(e, c.Continua); Recalcular(); }"
                                   disabled="@c.TieneDesglose" title="@SumaDelDesglose(c)" />
                            @EnVA(c, c.Continua, c.ContinuaVA)
                        </td>
                        <td rowspan="@c.Polos">
                            <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="nocontinua" aria-label="Circuito @c.Espacio · No continua" value="@Carga(c.NoContinua)" @onchange="e => { c.NoContinua = LeerCarga(e, c.NoContinua); Recalcular(); }"
                                   disabled="@(c.TieneDesglose || c.Categoria == CategoriaDeCarga.CalefaccionFija)"
                                   title="@(c.Categoria == CategoriaDeCarga.CalefaccionFija ? "Calefacción fija: carga continua — 424-3(b)." : SumaDelDesglose(c))" />
                            @EnVA(c, c.NoContinua, c.NoContinuaVA)
                        </td>
                        }
                        <td rowspan="@c.Polos"><input data-requerido data-col="fp" aria-label="Circuito @c.Espacio · F.P." class="va fp" type="text" inputmode="decimal" autocomplete="off" data-numero min="@FactorMinimo" max="1" step="0.05" title="@(c.TieneDesglose ? "F.P. combinado de los aparatos: P ÷ √(P² + Q²)." : AyudaFactorPotencia(c))" value="@Factor(c.FactorPotencia)" @onchange="e => { c.FactorPotencia = LeerFactor(e, c.FactorPotencia); Recalcular(); }" disabled="@c.TieneDesglose" /></td>
                        @foreach (var barra in Datos.Barras)
                        {
                            <td rowspan="@c.Polos" class="num tenue col-fase">@(c.TieneCarga && c.Fases.Contains(barra) ? c.CargaPorFaseVA.ToString("#,0.##") : "")</td>
                        }
                        <td rowspan="@c.Polos"><input data-requerido class="va corto" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" data-col="l" aria-label="Circuito @c.Espacio · Longitud (m)" value="@Numero(c.LongitudM)" @onchange="e => { c.LongitudM = Leer(e, c.LongitudM); Recalcular(); }" /></td>
                        <td rowspan="@c.Polos" class="canal">
                            <select class="canal" data-col="canal" aria-label="Circuito @c.Espacio · Canalización" value="@(c.Canalizacion ?? "")" @onchange="e => CambiarCanalizacion(c, e.Value?.ToString())">
                                @if (!c.TieneCarga)
                                {
                                    <option value="">—</option>
                                }
                                @* @key: al quitarse un tubo de la lista, Blazor reutilizaba las opciones por posición y la
                                   seleccionada pasaba a decir otro tubo; el circuito seguía en el suyo (I-45). *@
                                @foreach (var t in Datos.Canalizaciones) { <option @key="t.Id" value="@t.Id">@t.Nombre</option> }
                                @if (!c.TieneCarga || c.CanalizacionEfectiva?.Circuitos.Count > 1)
                                {
                                    <option value="+">+ Nueva</option>
                                }
                            </select>
                            @if (c.TieneCarga && c.CanalizacionEfectiva is { } canal)
                            {
                                <span class="en-va">@canal.TamanoRotulo</span>
                            }
                        </td>
                        <td rowspan="@c.Polos">
                            <select class="polos" data-col="polos" aria-label="Circuito @c.Espacio · Polos" value="@c.Polos"
                                    @onchange="e => CambiarPolos(c, e.Value?.ToString())">
                                @foreach (var p in Enumerable.Range(1, Datos.MaximoPolos)) { <option value="@p">@p</option> }
                            </select>
                            @* Un motor trifásico no lleva neutro: sin la casilla (I-114). *@
                            @if (c.Polos > 1 && TieneNeutro && !(c.EsMotor && c.Polos == 3))
                            {
                                <label class="mas-n" title="Marcar si la carga es F-N (220/127 V) y el circuito lleva neutro. En 2 fases + neutro de estrella el neutro cuenta como portador — 310-15(b)(5)(2).">
                                    <input type="checkbox" data-col="masn" aria-label="Circuito @c.Espacio · Con neutro" checked="@c.ConNeutro" @onchange="e => { c.ConNeutro = e.Value is true; Recalcular(); }" />+N</label>
                            }
                        </td>
                        <td rowspan="@c.Polos" class="num">@c.Resultado?.CorrienteDisenoA.ToString("N2")</td>
                        @{ var desglose = Cuadro.Desglose(c); }
                        <td rowspan="@c.Polos" class="num">@Ayuda(c.Resultado?.ProteccionA.ToString("N0"), desglose?.Proteccion)</td>
                        @Conductor(c.Resultado?.CalibreFase, c.Resultado?.NumeroConductoresParalelo ?? 0, c.Polos, desglose?.Conductor)
                        @Conductor(c.Resultado?.CalibreNeutro, c.Resultado is null ? 0 : 1, c.Polos, sinConductor: c.Resultado is not null && !c.LlevaNeutro)
                        @Conductor(c.Resultado?.CalibreTierra, c.Resultado is null ? 0 : 1, c.Polos)
                        <td rowspan="@c.Polos" class="num ultima @(Excede(c) ? "excede" : null)">@c.Resultado?.CaidaTensionPct.ToString("N2")</td>
                    </tr>

                    @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                    {
                        <tr class="@(c.Resultado is null ? "vacio" : null) @(c.Polos == 2 ? "dos-polos" : null)">
                            <td class="num @(c.TieneCaptura ? "asa" : null)" data-destino="@seguido.Espacio" data-arrastre="@(c.TieneCaptura ? seguido.Espacio : null)" data-etiqueta="@EtiquetaDeArrastre(c)">@NumeroConFase(seguido.Espacio)</td>
                        </tr>
                    }

                    @if (c.Error is not null)
                    {
                        <tr class="fila-error">
                            <td></td>
                            <td colspan="@(Columnas - 1)">@c.Error</td>
                        </tr>
                    }

                    @*
                        EL DESGLOSE VA DESPUÉS DEL ÚLTIMO ESPACIO DEL CIRCUITO, en un renglón que ocupa todo
                        el ancho: nunca entre los espacios de un multipolar, y sin mover ninguna columna.
                    *@
                    @if (Abierto(c) && (!c.EsDeMotor || c.EsGrupo))
                    {
                        var calefaccion = c.Categoria == CategoriaDeCarga.CalefaccionFija;
                        var grupo = c.EsGrupo;
                        <tr class="fila-desglose">
                            <td></td>
                            <td colspan="@(Columnas - 1)">
                                <table class="desglose" data-circuito="@c.Espacio">
                                    <thead>
                                        <tr>
                                            <th class="izq" data-col="ap-desc">@(grupo ? $"Motores y cargas del circuito {c.Espacio}" : $"Aparato del circuito {c.Espacio}")</th>
                                            <th data-col="ap-cant">Cant.</th>
                                            <th data-col="ap-unidad"><span class="ayuda" title="@(grupo
                                                ? "Motor: en HP, con su FLC de tabla (430-6(a)), o en A si la placa no trae HP (430-6(a)(1)). Otra carga: VA, W o A de placa. Todos a la tensión y los polos del circuito."
                                                : "Carga: VA, W o A de placa. Aparato con motor fijo en su sitio (lavadora, triturador, extractor): en HP, con su FLC de tabla, o en A de placa (430-6(a)(1) Excepción 3). Con otras cargas, el motor mayor de más de ⅛ hp entra al 125 % — 220-18(a).")">Unidad</span></th>
                                            <th data-col="ap-carga">Carga c/u</th>
                                            <th data-col="ap-continua"><span class="ayuda" title="@(grupo ? "Otras cargas: opera 3 h o más, 125 % — 430-24. Un motor ya entra con su regla: 125 % del mayor — 430-24." : "Opera 3 h o más: 125 % — 210-19(a)(1). Calefacción: siempre — 424-3(b). Un aparato con motor ya entra con su regla: el mayor al 125 % — 220-18(a).")">Continua</span></th>
                                            <th data-col="ap-fp">F.P.</th>
                                            <th>Total <span class="simbolo">(VA)</span></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (aparato, n) in c.Aparatos.Select((a, i) => (a, i + 1)))
                                        {
                                            <tr>
                                                <td class="izq"><input class="desc" data-col="ap-desc" aria-label="Circuito @c.Espacio, aparato @n · Descripción" @bind="aparato.Descripcion" @bind:after="Recalcular" placeholder="Aparato (Contacto: 180 VA)" /></td>
                                                <td><input data-requerido data-col="ap-cant" aria-label="Circuito @c.Espacio, aparato @n · Cantidad" class="va corto" type="text" inputmode="decimal" autocomplete="off" data-numero min="1" step="1" @bind="aparato.Cantidad" @bind:culture="CultureInfo.InvariantCulture" @bind:after="Recalcular" /></td>
                                                <td>
                                                    @* La clase y la unidad en un solo selector, como el HP con sus polos: en un grupo, motor u
                                                       otra carga (I-115); en cualquier otro desglose, carga o aparato con motor (I-118). *@
                                                    <select class="unidad" data-col="ap-unidad" aria-label="Circuito @c.Espacio, aparato @n · Unidad" value="@UnidadDeMiembro(aparato)" @onchange="e => CambiarUnidadDeMiembro(aparato, e.Value?.ToString())">
                                                        <optgroup label="@(grupo ? "Otra carga" : "Carga")">
                                                            <option value="Carga|@UnidadConsumo.VoltAmperes">VA</option>
                                                            <option value="Carga|@UnidadConsumo.Watts">W</option>
                                                            <option value="Carga|@UnidadConsumo.Amperes">A</option>
                                                        </optgroup>
                                                        <optgroup label="@(grupo ? "Motor" : "Aparato con motor")">
                                                            <option value="Motor|@CapturaDeMotor.Hp">HP</option>
                                                            <option value="Motor|@CapturaDeMotor.Amperes">A</option>
                                                        </optgroup>
                                                    </select>
                                                </td>
                                                @if (aparato.Clase == ClaseDeAparato.Motor && aparato.CapturaMotor == CapturaDeMotor.Hp)
                                                {
                                                    <td>
                                                        <select class="hp" data-col="ap-carga" aria-label="Circuito @c.Espacio, aparato @n · HP" value="@(aparato.Hp?.ToString(CultureInfo.InvariantCulture) ?? "0")" @onchange="e => CambiarHpDeMiembro(aparato, e.Value?.ToString())"
                                                                title="Seleccionar los caballos de placa, con su corriente de tabla a la tensión del circuito (@Cuadro.AlimentacionDelMotor(c.Polos)) — 430-6(a).">
                                                            <option value="0">—</option>
                                                            @foreach (var hp in Cuadro.HpDisponibles(c.Polos)) { <option @key="hp" value="@hp.ToString(CultureInfo.InvariantCulture)">@MotoresEnHp.Texto(hp) HP — @Cuadro.FlcDe(hp, c.Polos).ToString("N2") A</option> }
                                                            @if (aparato.Hp is > 0m and { } fuera && !Cuadro.HpDisponibles(c.Polos).Contains(fuera))
                                                            {
                                                                <option value="@fuera.ToString(CultureInfo.InvariantCulture)">@MotoresEnHp.Texto(fuera) HP</option>
                                                            }
                                                        </select>
                                                    </td>
                                                }
                                                else if (aparato.EsMaquina)
                                                {
                                                    <td><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio, aparato @n · Corriente de placa (A)" value="@Carga(aparato.CorrientePlacaA)" @onchange="e => { aparato.CorrientePlacaA = LeerCarga(e, aparato.CorrientePlacaA); Recalcular(); }"
                                                               title="@(aparato.MotorEnAmperes is { } m ? $"{m.Hp:0.##} HP — {MotoresEnHp.Interpolacion(m, c.Polos)}, 430-6(a)(1)." : "Capturar la corriente de placa de un motor que no trae HP; se le asignan los HP de la tabla, interpolando — 430-6(a)(1).")" /></td>
                                                }
                                                else
                                                {
                                                    <td><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="ap-carga" aria-label="Circuito @c.Espacio, aparato @n · Carga c/u" value="@Carga(aparato.CargaUnitaria)" @onchange="e => { aparato.CargaUnitaria = LeerCarga(e, aparato.CargaUnitaria); Recalcular(); }" /></td>
                                                }
                                                <td>
                                                    @if (!aparato.EsMaquina)
                                                    {
                                                        <input type="checkbox" data-col="ap-continua" aria-label="Circuito @c.Espacio, aparato @n · Continua" @bind="aparato.Continua" @bind:after="Recalcular" disabled="@calefaccion" />
                                                    }
                                                    else
                                                    {
                                                        @* Qué es y cómo cuenta: el selector cerrado solo dice «HP» o «A». *@
                                                        <span class="clase-motor" title="@(grupo ? "Motor del grupo: 125 % del mayor y los demás al 100 % — 430-24."
                                                            : ReferenceEquals(c.MotorAl125, aparato) ? "El motor mayor, con otras cargas: al 125 % — 220-18(a)."
                                                            : "Aparato con motor: al 100 %; solo el mayor va al 125 % — 220-18(a).")">@(ReferenceEquals(c.MotorAl125, aparato) ? "motor · 125 %" : "motor")</span>
                                                    }
                                                </td>
                                                <td><input data-requerido class="va fp" type="text" inputmode="decimal" autocomplete="off" data-numero min="@FactorMinimo" max="1" step="0.05" data-col="ap-fp" aria-label="Circuito @c.Espacio, aparato @n · F.P." value="@Factor(aparato.FactorPotencia)" @onchange="e => { aparato.FactorPotencia = LeerFactor(e, aparato.FactorPotencia); Recalcular(); }" /></td>
                                                <td class="num" title="@(aparato.EsMaquina && aparato.CorrienteUnitariaA > 0m ? $"{aparato.Cantidad} × {aparato.CorrienteUnitariaA:N2} A = {aparato.Cantidad * aparato.CorrienteUnitariaA:N2} A, por la tensión del circuito." : null)">@aparato.TotalVA.ToString("#,0.##")</td>
                                                <td><button class="quitar" title="Quitar el aparato" aria-label="Quitar el aparato @n del circuito @c.Espacio" @onclick="() => QuitarAparato(c, aparato, n)"><Icono Nombre="quitar" Tamano="14" /></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td class="izq">
                                                @if (grupo)
                                                {
                                                    <button class="agregar" data-agregar="@c.Espacio" @onclick="() => AgregarMotor(c)"><Icono Nombre="agregar" Tamano="14" />Agregar motor</button>
                                                    <button class="agregar" data-agregar-carga="@c.Espacio" @onclick="() => AgregarAparato(c)"><Icono Nombre="agregar" Tamano="14" />Agregar otra carga</button>
                                                }
                                                else
                                                {
                                                    <button class="agregar" data-agregar="@c.Espacio" @onclick="() => AgregarAparato(c)"><Icono Nombre="agregar" Tamano="14" />Agregar aparato</button>
                                                }
                                            </td>
                                            <td colspan="7" class="num">
                                                @if (grupo && c.TieneDesglose)
                                                {
                                                    <text>Motores @c.CorrienteDeMotorA.ToString("N2") A · otras cargas: continua @c.ContinuaVA.ToString("#,0.##") · no continua @c.NoContinuaVA.ToString("#,0.##") VA · F.P. @c.FactorPotencia.ToString("N2")</text>
                                                }
                                                else if (c.TieneDesglose)
                                                {
                                                    <text>Total: continua @c.ContinuaVA.ToString("#,0.##") · no continua @c.NoContinuaVA.ToString("#,0.##") VA · F.P. @c.FactorPotencia.ToString("N2")</text>
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</section>

@*
    CANALIZACIONES — decisión canalizaciones-y-agrupamiento (2026-09-24). Se captura qué circuitos van
    juntos (columna «Canal.») y aquí sale lo demás: portadores, factor de agrupamiento según el tipo
    de canalización y tamaño (Capítulo 10). Una sola lista: cada circuito con carga nace en la suya;
    todas nacen como tubo EMT y se configuran en su renglón (David, 2026-09-24).
*@
<section class="tarjeta canalizaciones" id="sec-canalizaciones">
    <div class="encabezado-tarjeta">
        <h2>Canalizaciones</h2>
        <button class="boton con-icono" id="nueva-canalizacion" @onclick="NuevaCanalizacion"><Icono Nombre="agregar" Clase="boton-icono" />Nueva canalización</button>
    </div>

    @* Una sola lista de tubos: por omisión cada circuito con carga recibe el suyo (T1, T2…) y en la
       columna «Canal.» del cuadro se elige de la lista (David, 2026-09-24). Una fila por canalización,
       sin plegar: la tabla crece con el tablero. Las opciones van en columnas, no apiladas. *@
    <h3 class="subtitulo-canal">Circuitos derivados</h3>
    <div class="desplazable">
    <table class="cuadro canal-tabla">
        <thead>
            <tr>
                <th rowspan="2" data-col="cn-nombre"><span class="ayuda" title="El nombre con el que aparece en la columna «Canal.» del cuadro, en el documento y en la memoria. Nace T1, T2…; editable: «Tubo pasillo», «Bajada cocina». Borrado, regresa a su número.">Nombre</span></th>
                <th rowspan="2" data-col="cn-tipo cn-tubo cn-ancho cn-alto cn-area cn-max"><span class="ayuda" title="Toda canalización nace como tubo conduit EMT; se decide en cada una. En tubo, el bloque de la Tabla 4. Ductos y canales: medidas interiores (20 % — 376-22, 378-22, 366-22). Superficiales: área interior y número de conductores del fabricante (386-22, 388-22).">Tipo</span></th>
                <th rowspan="2"><span class="ayuda" title="Los circuitos que van por esta canalización. Cada circuito con carga nace en la suya; se cambia en la columna «Canal.» del cuadro.">Circuitos</span></th>
                <th colspan="3"><span class="ayuda" title="Cuántos conductores de cada uno van en la canalización. Para el llenado cuentan todos — Nota 3 del Capítulo 10.">Conductores</span></th>
                @EncabezadoCalculo()
                <th colspan="4">Opciones</th>
            </tr>
            <tr>
                <th>Fase</th><th>Neutro</th><th>Tierra</th>
                <th><span class="simbolo">mm</span></th><th><span class="simbolo">in</span></th>
                <th class="dos-lineas" data-col="cn-neutro"><span class="ayuda" title="Los circuitos de 1 polo de esta canalización, en barras distintas, comparten un solo neutro: circuito multiconductor — 210-4. Baja los portadores, pero exige que los interruptores desconecten juntos — 210-4(b). Solo con dos o más circuitos.">Neutro comp.</span></th>
                <th class="dos-lineas" data-col="cn-tierra"><span class="ayuda" title="Una sola tierra para todos los circuitos de la canalización, del calibre que pide la protección mayor — 250-122(c). Menos conductores, tubo más chico. Solo con dos o más circuitos.">Tierra común</span></th>
                @EncabezadoTierraDesnuda()
                @EncabezadoAzotea()
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Datos.Canalizaciones)
            {
                @FilaCanal(t)
            }
            @if (Datos.Canalizaciones.Count == 0)
            {
                <tr><td colspan="16" class="ultima vacia">Captura la carga de algún circuito y aquí sale su canalización.</td></tr>
            }
        </tbody>
    </table>
    </div>

    <h3 class="subtitulo-canal">Alimentador</h3>
    <div class="desplazable">
    <table class="cuadro canal-tabla">
        <thead>
            <tr>
                <th rowspan="2" data-col="cn-tipo cn-tubo cn-ancho cn-alto cn-area cn-max"><span class="ayuda" title="La canalización del alimentador, que va sola: no hereda el agrupamiento de los derivados. Nace como tubo conduit EMT.">Tipo</span></th>
                <th colspan="3">Conductores</th>
                @EncabezadoCalculo()
                <th colspan="3">Opciones</th>
            </tr>
            <tr>
                <th>Fase</th><th>Neutro</th><th>Tierra</th>
                <th><span class="simbolo">mm</span></th><th><span class="simbolo">in</span></th>
                @EncabezadoTierraDesnuda()
                @EncabezadoAzotea()
                <th class="dos-lineas" data-col="cn-paralelos"><span class="ayuda" title="Solo si el alimentador sale con conductores en paralelo: todos los juegos en una sola canalización, y cada conductor cuenta como portador — 310-15(b)(3)(a). Sin marcar: un juego por canalización, todas iguales — 310-10(h)(3).">Paralelos en un tubo</span></th>
            </tr>
        </thead>
        <tbody>
            @FilaCanal(Datos.CanalizacionAlimentador, alimentador: true)
        </tbody>
    </table>
    </div>

</section>

@if (_aviso is { } flotante)
{
    <div class="aviso-flotante @flotante.Clase" role="status" aria-live="polite">
        <span>@flotante.Texto</span>
        @if (flotante.Clase == "bien" && Cuadro.PuedeDeshacer)
        {
            <button class="boton" @onclick="DeshacerMovimiento">Deshacer</button>
        }
    </div>
}

<div class="cierre">
    @*
        El interior del tablero: la tapa muerta con las barras en multifilar, los interruptores a sus
        lados y el directorio afuera — Layout/InteriorDelGabinete.razor (I-67).
    *@
    <section class="tarjeta gabinete-tarjeta">
        <div class="encabezado-tarjeta">
            <h2>Gabinete · convención NEMA · @Datos.EtiquetaSistema</h2>
            @if (Cuadro.PuedeDeshacer)
            {
                <button class="boton con-icono" @onclick="DeshacerMovimiento" title="Regresar al acomodo de antes del último movimiento u optimización"><Icono Nombre="deshacer" Clase="boton-icono" />Deshacer movimiento</button>
            }
        </div>
        <p class="derivado sin-margen">
            <strong>@Cuadro.EspaciosOcupados</strong> de @Datos.NumeroEspacios espacios ocupados ·
            @Cuadro.EspaciosLibres libres
        </p>

        <InteriorDelGabinete Cuadro="Cuadro" />
    </section>

    <div class="columna">
    <section class="tarjeta" id="sec-resumen">
        <h2>Resumen de carga</h2>
        <table class="datos resumen">
            <tr>
                <th class="izq">Tipo de carga</th><th>Instalada <span class="simbolo">(kVA)</span></th><th data-col="fd" title="Factor de demanda del tipo de carga — Art. 220. Enter baja al siguiente.">F.D.</th><th>Demandada <span class="simbolo">(kVA)</span></th>
            </tr>
            @foreach (var fila in Cuadro.Resumen.PorCategoria ?? [])
            {
                <tr>
                    <td class="izq"><span class="con-icono-carga"><Icono Nombre="@Icono.De(fila.Categoria)" Tamano="16" />@fila.Categoria.NombreCompleto()</span></td>
                    <td class="num">@((fila.InstaladaVA / 1000m).ToString("N2"))</td>
                    <td class="num">
                        <input data-requerido data-col="fd" aria-label="F.D. · @fila.Categoria.NombreCompleto()" class="va chico" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" max="1" step="0.05"
                               value="@Factor(fila.FactorDemanda)"
                               @onchange="e => CambiarFactor(fila.Categoria, e)" />
                    </td>
                    <td class="num">@((fila.DemandadaVA / 1000m).ToString("N2"))</td>
                </tr>
            }
            @if (Cuadro.Resumen.Minimo220_52VA > 0m)
            {
                <tr>
                    <td class="izq"><span class="ayuda" title="Completar a 1500 VA cada circuito de aparatos pequeños o de lavadora — 220-52(a) y (b). Carga de alimentador; no cambia el derivado. Lleva el F.D. de contactos.">Mínimo 220-52</span></td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52VA / 1000m).ToString("N2"))</td>
                    <td class="num">@Factor(Datos.FactorDemandaContactos)</td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52DemandadoVA / 1000m).ToString("N2"))</td>
                </tr>
            }
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kVA)</span></td>
                <td class="num">@((Cuadro.Resumen.CalculadaVA / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kW)</span></td>
                <td class="num">@((Cuadro.Resumen.InstaladaW / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaW / 1000m).ToString("N2"))</td>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar el factor de potencia de la carga instalada: kW totales ÷ suma vectorial de kVA. El del alimentador, con el que se calcula la caída, lleva además el factor de demanda.">F.P. resultante</span></td>
                <td class="num">@Cuadro.Resumen.FactorPotencia.ToString("N2")</td>
                <td></td><td></td>
            </tr>
            @* CÓMO ENTRA AL ALIMENTADOR, aparte de los tipos (I-74): la misma carga, vista por la regla con la
               que se suma. Los tres renglones suman el total. *@
            <tr class="subtitulo">
                <th class="izq" colspan="4"><span class="ayuda" title="Consultar cómo entra la carga al alimentador. Es la misma carga de arriba, repartida por la regla con la que se suma; los renglones dan el total.">Al alimentador</span></th>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar la carga continua (3 h o más): entra al 125 % en el alimentador — 215-2(a)(1), 215-3.">Continua — 125 %</span></td>
                <td class="num">@((Cuadro.Resumen.ContinuaVA / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.ContinuaDemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar la carga no continua: entra al 100 %. Lleva el mínimo de 220-52, si hay.">No continua — 100 %</span></td>
                <td class="num">@(((Cuadro.Resumen.NoContinuaVA + Cuadro.Resumen.Minimo220_52VA) / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@(((Cuadro.Resumen.NoContinuaDemandadaVA + Cuadro.Resumen.Minimo220_52DemandadoVA) / 1000m).ToString("N2"))</td>
            </tr>
            @if (Cuadro.Resumen.MotoresVA > 0m)
            {
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar la carga de los motores y los equipos de A/C. No es continua ni no continua: en el alimentador entra con su corriente —la de tabla de los motores, la de placa del A/C—, 125 % la del mayor y 100 % la de los demás, en cada fase — 430-24, 440-33. Lleva el F.D. de su tipo — 430-26.">@Cuadro.EtiquetaDeMotores — @Cuadro.ReferenciaDeMotores</span></td>
                    <td class="num">@((Cuadro.Resumen.MotoresVA / 1000m).ToString("N2"))</td>
                    <td></td>
                    <td class="num">@((Cuadro.Resumen.MotoresDemandadaVA / 1000m).ToString("N2"))</td>
                </tr>
            }
        </table>

        @if (Datos.ReduceCargaPorDemanda)
        {
            <h2 class="separado"><span class="ayuda" title="Seleccionar, para cada tipo con F.D. menor que 1, la tabla o sección del Art. 220 que lo sustenta. Se imprime en la memoria del alimentador — 220-40.">Justificación del F.D.</span></h2>
            @foreach (var categoria in CategoriasDeCarga.Todas.Where(c => Datos.FactorDeDemanda(c) < 1m))
            {
                <div class="justificaciones">
                    <strong>@categoria.NombreCompleto() · F.D. @Datos.FactorDeDemanda(categoria).ToString("N2")</strong>
                    @foreach (var j in categoria.JustificacionesPosibles(Datos.Inmueble))
                    {
                        <label><input type="checkbox" checked="@Datos.Justificaciones[categoria].Contains(j)" @onchange="e => Justificar(categoria, j, e)" /> @j.Nombre()</label>
                    }
                    @if (Datos.Justificaciones[categoria].Contains(JustificacionFactorDemanda.Otra))
                    {
                        <input class="otra" placeholder="Describir el criterio" value="@Datos.JustificacionOtra[categoria]"
                               @oninput="e => { Datos.JustificacionOtra[categoria] = e.Value?.ToString() ?? string.Empty; Recalcular(); }" />
                    }
                </div>
            }
        }

    </section>

    @* Balanceo en su propia tarjeta, con barras de los colores de fase (David, 2026-09-24). La barra
       más cargada llena la pista; las demás, en proporción. *@
    <section class="tarjeta balanceo">
        <div class="encabezado-tarjeta">
            <h2>Balanceo de fases</h2>
            @if (Datos.Barras.Count > 1)
            {
                <button class="boton" @onclick="OptimizarAcomodo" title="Reacomodar los circuitos para el menor desbalanceo, moviendo los menos posibles. Se puede deshacer.">Optimizar acomodo</button>
            }
        </div>
        @{ var mayor = Datos.Barras.Max(b => Cuadro.Resumen.CargaPorFaseVA[b]); }
        @foreach (var barra in Datos.Barras)
        {
            var va = Cuadro.Resumen.CargaPorFaseVA[barra];
            var ancho = mayor > 0m ? va * 100m / mayor : 0m;
            <div class="fila-fase">
                <span class="fase-rect fase-rect-@char.ToLowerInvariant(barra)">@barra</span>
                <div class="pista"><div class="relleno color-@char.ToLowerInvariant(barra)" style="width: @ancho.ToString("0.#", CultureInfo.InvariantCulture)%"></div></div>
                <span class="num fuerte">@va.ToString("#,0.##") VA</span>
            </div>
        }
        <div class="desbalanceo">
            <span>Desbalanceo</span>
            <strong class="num">@Cuadro.Resumen.DesbalanceoPct.ToString("N1") %</strong>
        </div>
    </section>
    </div>

    @*
        Lo primero que se ve es la protección seleccionada, y luego los conductores con el color de su
        forro (David, 2026-09-24). El cálculo que lleva a ellos va abajo; los avisos, en su tarjeta.
    *@
    <section class="tarjeta alimentador" id="sec-alimentador">
        <h2>Alimentador y protección principal</h2>

        @if (Cuadro.Alimentador.Resultado is { } a)
        {
            <div class="seleccion">
                <span class="rotulo">@(Datos.UsaInterruptorPrincipal ? "Interruptor principal" : "Protección del lado de alimentación")</span>
                <span class="valor">@Ayuda($"{a.ProteccionA:N0} A", Cuadro.DesgloseDelAlimentador()?.Proteccion) <span class="polos">· @Polos(Cuadro.Alimentador.Polos)</span></span>
            </div>

            <div class="cables">
                <div class="cable">
                    <span class="muestras grande">@foreach (var barra in Datos.Barras) { <i class="color-@char.ToLowerInvariant(barra)"></i> }</span>
                    <span class="rotulo">Fase</span>
                    <span class="calibre">@Ayuda(ConHilos(a.CalibreFase, a.NumeroConductoresParalelo), Cuadro.DesgloseDelAlimentador()?.Conductor)<small>@a.CalibreFase.AreaMm2.ToString("N2") mm²</small></span>
                </div>
                <div class="cable">
                    <span class="muestras grande"><i class="color-neutro"></i></span>
                    <span class="rotulo"><span class="ayuda" title="Consultar el conductor de neutro: mismo calibre que la fase. En 2 fases + neutro de estrella lleva ≈ la corriente de fase: contarlo en «Agrupados» — 310-15(b)(5)(2); no reducirlo — 220-61(c)(1). Blanco o gris claro — 200-6.">Neutro</span></span>
                    @* I-73: en 3F-3H el alimentador no lleva neutro, como un bipolar sin «+N» — I-41. *@
                    @if (Cuadro.SistemaConNeutro)
                    {
                        <span class="calibre">@ConHilos(a.CalibreNeutro, a.NumeroConductoresParalelo)<small>@a.CalibreNeutro.AreaMm2.ToString("N2") mm²</small></span>
                    }
                    else
                    {
                        <span class="calibre" title="3F-3H (delta): el sistema no tiene neutro.">—</span>
                    }
                </div>
                <div class="cable">
                    <span class="muestras grande"><i class="color-tierra"></i></span>
                    <span class="rotulo"><span class="ayuda" title="Consultar el conductor de puesta a tierra de equipos — Tabla 250-122. Verde, o verde con franjas amarillas — 250-119.">Puesta a tierra</span></span>
                    <span class="calibre">@a.CalibreTierra.DesignacionConUnidad<small>@a.CalibreTierra.AreaMm2.ToString("N2") mm²</small></span>
                </div>
            </div>

            <p class="derivado">Canalización: <strong>@Datos.CanalizacionAlimentador.Rotulo · @Datos.CanalizacionAlimentador.TamanoRotulo</strong> · @(Datos.CanalizacionAlimentador.Conteo?.Portadores) portadores — ver «Canalizaciones».</p>

            <label class="suelto">Longitud del alimentador (m)
                <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="0" step="1" value="@Numero(Datos.LongitudAlimentadorM)" @onchange="e => { Datos.LongitudAlimentadorM = Leer(e, Datos.LongitudAlimentadorM); Recalcular(); }" />
            </label>
            <table class="datos">
                @if (Cuadro.Alimentador.Gobierna is { } g && Datos.Barras.Count > 1)
                {
                    <tr>
                        <td class="izq"><span class="ayuda" title="Consultar la fase de mayor capacidad requerida (125 % continua + no continua; con motores y A/C, más 125 % del mayor y 100 % de los demás — 430-24, 440-33). Dimensiona el alimentador — 215-2(a)(1), 215-3.">Fase que gobierna</span></td>
                        <td class="num">@g.Fase, la más cargada</td>
                    </tr>
                }
                <tr><td class="izq"><span class="ayuda" title="Consultar la corriente con la que se dimensionan la protección y el conductor: los VA demandados sumados directamente, entre la tensión. La caída de tensión usa la suma fasorial, que puede ser un poco menor.">Corriente de diseño</span></td><td class="num">@a.CorrienteDisenoA.ToString("N2") A</td></tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar el factor de potencia de las cargas de la fase que gobierna, con su factor de demanda y el mínimo de 220-52: el de la corriente con la que se calcula la caída de tensión del alimentador.">Factor de potencia</span></td>
                    <td class="num">@Cuadro.Alimentador.FactorPotencia.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar la caída de tensión del alimentador: la de la peor fase, con la caída del neutro — Tabla 9. Pasar el cursor sobre el valor para consultar cada fase. Recomendado: 3 % en el alimentador y 5 % combinada con el derivado — 215-2(a)(4), NOTA 2.">Caída de tensión</span></td>
                    <td class="num @(a.CaidaTensionPct > Datos.CaidaMaxAlimentadorPct ? "excede" : null)">@Ayuda(CaidaDelAlimentador(a), CaidaPorFase(a))</td>
                </tr>
                @* En 1F-2H el neutro lleva la corriente de la fase: un renglón aparte decía otro número (I-47). *@
                @if (a.CorrienteNeutro is { } neutro && SistemaDelTablero.De(Datos.Sistema) != ConfiguracionTablero.UnaFaseDosHilos)
                {
                    <tr><td class="izq"><span class="ayuda" title="Consultar la corriente del neutro: suma fasorial de las corrientes de fase. Entra a la caída de tensión.">Corriente de neutro</span></td><td class="num">@neutro.Magnitud.ToString("N2") A</td></tr>
                }
            </table>
        }
        else
        {
            <label class="suelto">Longitud del alimentador (m)
                <input data-requerido type="text" inputmode="decimal" autocomplete="off" data-numero min="0" step="1" value="@Numero(Datos.LongitudAlimentadorM)" @onchange="e => { Datos.LongitudAlimentadorM = Leer(e, Datos.LongitudAlimentadorM); Recalcular(); }" />
            </label>
            @if (Cuadro.Alimentador.Error is { } error)
            {
                <p class="aviso error"><Icono Nombre="aviso" Clase="aviso-icono" /><span>@error</span></p>
            }
            else
            {
                <p class="derivado">Captura la carga de algún circuito y aquí sale el alimentador.</p>
            }
        }
    </section>
</div>

