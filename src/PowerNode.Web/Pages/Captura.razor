    /// regresar al cálculo) y el programa verifica que alcance. En lo demás, texto.
    /// </summary>
    private RenderFragment CeldaTamano(CanalizacionDelTablero t, bool pulgadas) =>
        @<text>
            @if (t.Tipo.EsTubo() && t.Ocupacion is { } o && o.AreaTotalMm2 is not null)
            {
                var calculado = o.TamanoCalculado;
