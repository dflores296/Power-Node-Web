@page "/"
@inject ProyectoActual Proyecto
@inject MotorNom Motor
@inject NavigationManager Navegacion

<PageTitle>Cuadro de carga — Power Node</PageTitle>

<header class="encabezado">
    <div class="titulo">
        <img src="marca/powernode-icono.svg" alt="Power Node" width="38" height="38" />
        <div>
            <h1>Cuadro de carga</h1>
            <p class="meta">NOM-001-SEDE-2012 · Art. 210, 215, 220, 240, 250, 310, 408</p>
        </div>
    </div>
    <div class="acciones">
        <button class="boton" @onclick="@(() => Navegacion.NavigateTo("documento"))">Documento y memoria</button>
    </div>
</header>

<section class="ficha">
    <div class="grupo">
        <h2>Identificación</h2>
        <label>Tablero <input @bind="Datos.Tablero" @bind:event="oninput" /></label>
        <label>Clave <input @bind="Datos.Clave" @bind:event="oninput" /></label>
        <label>Ubicación <input @bind="Datos.Ubicacion" @bind:event="oninput" /></label>
        <label>Proyecto <input @bind="Datos.Proyecto" @bind:event="oninput" /></label>
        <label>Cliente <input @bind="Datos.Cliente" @bind:event="oninput" /></label>
    </div>

    <div class="grupo">
        <h2>Sistema</h2>
        <label>Tensión F-F (V) <input type="number" min="100" step="1" @bind="Datos.TensionFaseFaseV" @bind:after="Recalcular" /></label>
        <label>Fases <select @bind="Datos.Fases" @bind:after="Recalcular">@foreach (var f in new[] { 1, 2, 3 }) { <option value="@f">@f</option> }</select></label>
        <label>Hilos <select @bind="Datos.Hilos" @bind:after="Recalcular">@foreach (var h in new[] { 2, 3, 4 }) { <option value="@h">@h</option> }</select></label>
        <label>Frecuencia (Hz) <input type="number" min="50" step="10" @bind="Datos.FrecuenciaHz" /></label>
        <p class="derivado">
            @Datos.EtiquetaSistema ·
            Tensión F-N <strong>@Datos.TensionFaseNeutroV.ToString("N1") V</strong> ·
            barras <strong>@string.Join(" ", Datos.Barras)</strong>
        </p>
    </div>

    <div class="grupo">
        <h2>Gabinete</h2>
        <label>Espacios <select @bind="Datos.NumeroEspacios" @bind:after="Recalcular">
            @foreach (var e in new[] { 6, 12, 18, 24, 30, 36, 42 }) { <option value="@e">@e</option> }
        </select></label>
        <label class="apilado">Acometida <select @bind="Datos.TipoAcometida" @bind:after="Recalcular">
            <option value="@TipoAcometidaTablero.InterruptorPrincipal">Interruptor principal</option>
            <option value="@TipoAcometidaTablero.ZapatasPrincipales">Zapatas principales</option>
        </select></label>
        <label>Montaje <select @bind="Datos.Montaje">
            <option value="Sobreponer">Sobreponer</option>
            <option value="Empotrar">Empotrar</option>
        </select></label>
        <label>Barras <select @bind="Datos.MaterialBarras">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label>Gabinete NEMA <select @bind="Datos.GabineteNema">
            @foreach (var n in new[] { "1", "3R", "4X", "12" }) { <option value="@n">@n</option> }
        </select></label>
        <label>Capacidad de barra (A) <input type="number" min="0" step="1" placeholder="—"
                                             @bind="Datos.CapacidadBarraA" @bind:after="Recalcular" /></label>
        <label class="apilado"><span class="ayuda" title="Seleccionar la familia de interruptores. Centro de carga (NEMA): 240-6(a) sin 16, 32 ni 63 A. Riel DIN (IEC): 16, 20, 25, 32, 40, 50, 63, 80, 100 y 125 A. NOM completa: 240-6(a) sin exclusiones.">Interruptores</span>
            <select @bind="Datos.SerieInterruptores" @bind:after="Recalcular">
                @foreach (var serie in new[] { SerieDeInterruptores.CentroDeCargaNema, SerieDeInterruptores.RielDinIec, SerieDeInterruptores.NomCompleta })
                {
                    <option value="@serie">@serie.Nombre()</option>
                }
            </select></label>
        <label><span class="ayuda" title="Capturar el mínimo del interruptor principal (criterio del proyectista). Vacío: sin verificación. Principal calculado menor al mínimo: aviso, sin cambio del valor calculado.">Mínimo del principal (A)</span>
            <input type="number" min="0" step="5" placeholder="—"
                   @bind="Datos.MinimoInterruptorPrincipalA" @bind:after="Recalcular" /></label>
    </div>

    <div class="grupo">
        <h2>Condiciones de cálculo</h2>
        <label>Conductor <select @bind="Datos.MaterialConductor" @bind:after="Recalcular">
            <option value="@MaterialConductor.Cobre">Cobre</option>
            <option value="@MaterialConductor.Aluminio">Aluminio</option>
        </select></label>
        <label><span class="ayuda" title="Seleccionar el aislamiento — Tabla 310-104(a). Determina la columna de temperatura de la Tabla 310-15(b)(16) para aplicar FT y FA. Ampacidad limitada a la temperatura de la terminal — 110-14(c).">Aislamiento</span>
            <select @bind="Datos.TipoAislamiento" @bind:after="Recalcular">
                @foreach (var aislamiento in Aislamientos) { <option value="@aislamiento">@aislamiento</option> }
            </select></label>
        <label class="apilado"><span class="ayuda" title="Declarar la temperatura de las terminales del interruptor y del equipo — 110-14(c)(1). Regla general: 60 °C hasta 100 A; 75 °C arriba de 100 A. Marcadas 75 °C: aplicar solo si ambas terminales lo indican — a.(3). Conductor de 60 °C: usar 60 °C — a.(1).">Terminales</span>
            <select @bind="Terminales" @bind:after="Recalcular">
                <option value="60">60 °C hasta 100 A (regla general)</option>
                <option value="75">Marcadas 75 °C</option>
            </select></label>
        <label class="apilado"><span class="ayuda" title="Seleccionar el lugar de instalación — Tabla 310-104(a). Determina la temperatura del aislamiento (THHW-LS: 90 °C seco, 75 °C mojado) y su validez (THHN: solo lugar seco).">Lugar</span>
            <select @bind="Lugar" @bind:after="Recalcular">
                <option value="seco">Seco</option>
                <option value="mojado">Húmedo o mojado</option>
            </select></label>
        <label>Canalización <select @bind="Datos.MaterialCanalizacion" @bind:after="Recalcular">
            <option value="@MaterialCanalizacion.Pvc">PVC</option>
            <option value="@MaterialCanalizacion.Aluminio">Aluminio</option>
            <option value="@MaterialCanalizacion.Acero">Acero</option>
        </select></label>
        <label>T. ambiente (°C) <input type="number" min="10" max="80" step="1" @bind="Datos.TemperaturaAmbienteC" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Capturar los conductores portadores de corriente en la canalización — Tabla 310-15(b)(3)(a): 4 a 6, 80 %; 7 a 9, 70 %; 10 a 20, 50 %. Excluir la tierra — 310-15(b)(6). Excluir el neutro con solo corriente de desbalance — (b)(5)(1). Contar el neutro en 2 fases + neutro de estrella — (b)(5)(2) y con carga no lineal — (b)(5)(3).">Agrupados</span> <input type="number" min="1" max="40" step="1" @bind="Datos.ConductoresAgrupados" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del circuito derivado. Recomendado: 3 % — 210-19(a)(1), NOTA 4.">e% máx. derivado</span> <input type="number" min="0.5" max="10" step="0.5" @bind="Datos.CaidaMaxDerivadoPct" @bind:after="Recalcular" /></label>
        <label><span class="ayuda" title="Capturar el límite de caída del alimentador. Valor inicial: 2 %, para que con el 3 % del derivado sumen el 5 % combinado — 215-2(a)(4), NOTA 2; 210-19(a)(1), NOTA 4.">e% máx. alimentador</span> <input type="number" min="0.5" max="10" step="0.5" @bind="Datos.CaidaMaxAlimentadorPct" @bind:after="Recalcular" /></label>
        @if (Datos.AvisoLimitesDeCaida is { } avisoLimites)
        {
            <p class="aviso">@avisoLimites</p>
        }
    </div>
</section>

<section class="cuadro-completo">
    <table class="cuadro">
        <thead>
            @*
                Encabezados en UN renglón con la unidad entre paréntesis —«In (A)», «L (m)», «e (%)»—
                y no partidos en dos líneas: partidos, las columnas de una sola línea quedaban
                desalineadas con las de dos y el cuadro se leía torcido. Lo que no cabe en el rótulo
                va en el tooltip, no en una segunda línea.
            *@
            <tr>
                <th rowspan="2"><span class="ayuda" title="Identificar el circuito por su espacio en la barra. Nones arriba, pares abajo.">N.º</span></th>
                <th rowspan="2" class="izq descripcion">Descripción</th>
                <th rowspan="2"><span class="ayuda" title="Seleccionar el tipo de carga. Determina la aplicación de 240-4(b) (excluida en contactos). Protección: primer tamaño de 240-6(a) ≥ capacidad mínima, sin mínimo por tipo. Contactos de vivienda: seleccionar el uso — 210-11(c).">Tipo</span></th>
                <th colspan="4"><span class="ayuda" title="Capturar la carga de placa en VA, W o A y su factor de potencia. Continua (3 h o más): 125 % — 210-19(a)(1), 210-20(a). No continua: 100 %. En W o A, consultar abajo el VA de cálculo.">Carga</span></th>
                <th colspan="@Datos.Barras.Count"><span class="ayuda" title="Consultar la carga del circuito repartida entre las barras que toca.">Balanceo de fases <span class="simbolo">(VA)</span></span></th>
                <th rowspan="2"><span class="ayuda" title="Capturar la longitud del circuito. Determina la caída de tensión — Tabla 9."><span class="simbolo">L (m)</span></span></th>
                <th rowspan="2"><span class="ayuda" title="Seleccionar los polos del interruptor. Un multipolar ocupa los espacios N, N+2 y N+4 del mismo lado.">P</span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar las barras que toca el interruptor. Las determina el espacio de montaje.">Barras</span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar la corriente de diseño de la carga capturada — 210-19(a)(1)."><span class="simbolo">In (A)</span></span></th>
                <th rowspan="2"><span class="ayuda" title="Consultar la protección: primer tamaño normalizado mayor o igual a la capacidad mínima — 240-6(a), 210-20(a). Pasar el cursor sobre el valor para consultar el desglose.">Protec. <span class="simbolo">(A)</span></span></th>
                <th colspan="3"><span class="ayuda" title="Consultar el conductor de fase: hilos por fase, sección (mm²) y designación AWG/kcmil. Pasar el cursor sobre el calibre para consultar el desglose.">Fase</span></th>
                <th colspan="3"><span class="ayuda" title="Consultar el conductor de neutro.">Neutro</span></th>
                <th colspan="3"><span class="ayuda" title="Consultar el conductor de puesta a tierra de equipos — Tabla 250-122 y 250-122(b).">Puesta a tierra</span></th>
                <th rowspan="2" class="ultima"><span class="ayuda" title="Consultar la caída de tensión del circuito. Límite recomendado: 3 % en el derivado y 5 % combinada — 210-19(a)(1), nota 4."><span class="simbolo">e (%)</span></span></th>
            </tr>
            <tr>
                <th><span class="ayuda" title="Seleccionar la unidad de placa. W: convertir con el factor de potencia. A: convertir con la tensión y los polos del circuito.">Unidad</span></th>
                <th><span class="ayuda" title="Capturar la carga que opera 3 h o más. Aplicar 125 % — 210-19(a)(1), 210-20(a).">Continua</span></th>
                <th><span class="ayuda" title="Capturar la carga que opera menos de 3 h. Aplicar 100 %.">No continua</span></th>
                <th><span class="ayuda" title="Capturar el factor de potencia de la carga. Valor inicial: 0.9.&#10;&#10;Capturada en W: VA = W ÷ F.P. Modifica corriente, protección, conductor, caída de tensión y kW.&#10;&#10;Capturada en VA o A: modifica solo la caída de tensión (y el conductor, si excede el límite) y los kW — Tabla 9, nota 2.">F.P.</span></th>
                @foreach (var barra in Datos.Barras)
                {
                    <th><span class="ayuda" title="Consultar la carga que el circuito asigna a la barra @barra.">@barra</span></th>
                }
                @foreach (var _ in new[] { "fase", "neutro", "tierra" })
                {
                    <th><span class="ayuda" title="Consultar los conductores en paralelo por fase.">Hilos</span></th>
                    <th><span class="ayuda" title="Consultar la sección transversal del conductor — Tabla 8."><span class="simbolo">mm²</span></span></th>
                    <th><span class="ayuda" title="Consultar la designación AWG o kcmil."><span class="simbolo">AWG/kcmil</span></span></th>
                }
            </tr>
        </thead>
        <tbody>
            @*
                Los nones arriba y los pares abajo, separados por un renglón delgado — es como está
                armado el Excel (filas 34-54, una fila en blanco de 6 pt, y 56-76), y ahí NO hay
                ningún rótulo de "lado": el número de circuito dice de qué columna del gabinete es.

                Van en UNA sola tabla y no en dos, aunque se vean como dos bloques: dos tablas
                independientes calculan sus anchos de columna por separado, y los renglones de
                abajo no cuadrarían con los de arriba.

                UN MULTIPOLAR ES UN SOLO RENGLÓN ALTO. Sus celdas se combinan hacia abajo cubriendo
                los espacios que ocupa —así se VE que abarca tres—, menos la columna del número, que
                sigue renglón por renglón porque 1 / 3 / 5 es justo lo que se quiere leer. Misma
                decisión que el exportador de escritorio, tomada con esta misma queja: antes decía
                "↳ ocupado por el circuito 1" en cada espacio, y eso se LEE en vez de VERSE.
            *@
            @foreach (var (lado, indice) in Lados.Select((b, i) => (b, i)))
            {
                @if (indice > 0)
                {
                    <tr class="separador"><td colspan="@Columnas"></td></tr>
                }

                @foreach (var c in lado.Where(x => !x.EsContinuacion))
                {
                    <tr class="@(c.Resultado is null ? "vacio" : null)">
                        <td class="num">@c.Espacio</td>
                        <td rowspan="@c.Polos"><input class="desc" @bind="c.Descripcion" @bind:event="oninput" placeholder="—" /></td>
                        <td rowspan="@c.Polos">
                            <select class="tipo" @bind="c.Tipo" @bind:after="Recalcular">
                                <option value="@TipoCarga.Alumbrado">Alumbrado</option>
                                <option value="@TipoCarga.Contactos">Contactos</option>
                                <option value="@TipoCarga.Equipo">Equipo</option>
                            </select>
                            @if (c.Tipo == TipoCarga.Contactos)
                            {
                                <select class="tipo uso" title="Seleccionar el uso del circuito de contactos. Vivienda: cocina = aparatos pequeños (cocina, despensa, comedor, desayunador), lavadora y baño llevan 20 A — 210-11(c) — y solo esas salidas — 210-52(b)(2), 210-11(c)(2) y (3). Aparatos pequeños y lavadora cuentan 1500 VA en el alimentador — 220-52. Excepción: vivienda popular de hasta 60 m²."
                                        @bind="c.Uso" @bind:after="Recalcular">
                                    @foreach (var uso in Enum.GetValues<UsoDeContactos>()) { <option value="@uso">@uso.NombreCorto()</option> }
                                </select>
                                @if (c.Ajuste220_52VA > 0m)
                                {
                                    <span class="en-va">Alimentador: 1,500 VA — @c.UsoEfectivo.ReferenciaCargaMinima()</span>
                                }
                            }
                        </td>
                        <td rowspan="@c.Polos">
                            <select class="unidad" @bind="c.Unidad" @bind:after="Recalcular">
                                <option value="@UnidadConsumo.VoltAmperes">VA</option>
                                <option value="@UnidadConsumo.Watts">W</option>
                                <option value="@UnidadConsumo.Amperes">A</option>
                            </select>
                        </td>
                        <td rowspan="@c.Polos">
                            <input class="va" type="number" min="0" @bind="c.Continua" @bind:after="Recalcular" />
                            @EnVA(c, c.Continua, c.ContinuaVA)
                        </td>
                        <td rowspan="@c.Polos">
                            <input class="va" type="number" min="0" @bind="c.NoContinua" @bind:after="Recalcular" />
                            @EnVA(c, c.NoContinua, c.NoContinuaVA)
                        </td>
                        <td rowspan="@c.Polos"><input class="va fp" type="number" min="0.1" max="1" step="0.05" title="@AyudaFactorPotencia(c)" @bind="c.FactorPotencia" @bind:after="Recalcular" /></td>
                        @foreach (var barra in Datos.Barras)
                        {
                            <td rowspan="@c.Polos" class="num tenue">@(c.TieneCarga && c.Fases.Contains(barra) ? c.CargaPorFaseVA.ToString("N0") : "")</td>
                        }
                        <td rowspan="@c.Polos"><input class="va corto" type="number" min="0" @bind="c.LongitudM" @bind:after="Recalcular" /></td>
                        <td rowspan="@c.Polos">
                            <select class="polos" value="@c.Polos"
                                    @onchange="e => CambiarPolos(c, e.Value?.ToString())">
                                @foreach (var p in Enumerable.Range(1, Datos.MaximoPolos)) { <option value="@p">@p</option> }
                            </select>
                        </td>
                        <td rowspan="@c.Polos" class="fase">
                            @foreach (var barra in c.Fases)
                            {
                                <span class="fase-@char.ToLowerInvariant(barra)">@barra</span>
                            }
                        </td>
                        <td rowspan="@c.Polos" class="num">@c.Resultado?.CorrienteDisenoA.ToString("N2")</td>
                        @{ var desglose = Cuadro.Desglose(c); }
                        <td rowspan="@c.Polos" class="num">@Ayuda(c.Resultado?.ProteccionA.ToString("N0"), desglose?.Proteccion)</td>
                        @Conductor(c.Resultado?.CalibreFase, c.Resultado?.NumeroConductoresParalelo ?? 0, c.Polos, desglose?.Conductor)
                        @Conductor(c.Resultado?.CalibreNeutro, c.Resultado is null ? 0 : 1, c.Polos)
                        @Conductor(c.Resultado?.CalibreTierra, c.Resultado is null ? 0 : 1, c.Polos)
                        <td rowspan="@c.Polos" class="num ultima @(Excede(c) ? "excede" : null)">@c.Resultado?.CaidaTensionPct.ToString("N2")</td>
                    </tr>

                    @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                    {
                        <tr class="@(c.Resultado is null ? "vacio" : null)">
                            <td class="num">@seguido.Espacio</td>
                        </tr>
                    }

                    @if (c.Error is not null || _motivo.TryGetValue(c.Espacio, out _))
                    {
                        <tr class="fila-error">
                            <td></td>
                            <td colspan="@(Columnas - 1)">@(c.Error ?? _motivo[c.Espacio])</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</section>

<div class="cierre">
    @*
        El interior del tablero, calcado del editor de gabinete de escritorio: UNA celda por
        interruptor —tan alta como polos tiene—, no una por espacio. Un trifásico dibujado como tres
        celdas sueltas con una flecha de "continúa" fue justo lo que David señaló allá el
        2026-08-20: en un directorio de tablero real, un interruptor es una sola celda.
    *@
    <section class="tarjeta">
        <h2>Gabinete · convención NEMA</h2>
        <p class="derivado sin-margen">
            <strong>@Cuadro.EspaciosOcupados</strong> de @Datos.NumeroEspacios espacios ocupados ·
            @Cuadro.EspaciosLibres libres
        </p>

        <div class="interior">
            @foreach (var bloque in Cuadro.Gabinete)
            {
                <div class="bloque @(bloque.Ocupado ? "ocupado" : "vacante")"
                     style="grid-column: @bloque.Columna; grid-row: @bloque.Fila / span @bloque.Espacios"
                     title="@Titulo(bloque)">
                    <span class="numeros">@bloque.Numeros</span>
                    <span class="pastillas">
                        @foreach (var barra in bloque.Barras)
                        {
                            <span class="pastilla pastilla-@char.ToLowerInvariant(barra)">@barra</span>
                        }
                    </span>
                    <span class="etiqueta">
                        @(bloque.Ocupado
                            ? (string.IsNullOrWhiteSpace(bloque.Circuito.Descripcion)
                                ? MemoriaDeCalculo.Etiqueta(bloque.Circuito)
                                : bloque.Circuito.Descripcion)
                            : "libre")
                    </span>
                    @if (bloque.Ocupado)
                    {
                        <span class="amperes">@bloque.Circuito.Resultado?.ProteccionA.ToString("N0") A</span>
                    }
                </div>
            }
        </div>

        @*
            El principal va abajo y centrado, fuera de las dos columnas: sin catálogo no se sabe si
            su marco es el de un derivado (y entonces se comería espacios numerados) o si trae
            alojamiento propio, y suponerlo sería inventar espacios que no se pueden usar. Se dibuja
            como lo que es seguro: existe y protege al tablero.
        *@
        @if (Datos.UsaInterruptorPrincipal)
        {
            <div class="principal">
                Interruptor principal
                @if (Cuadro.InterruptorPrincipalA > 0m)
                {
                    <strong>@Cuadro.InterruptorPrincipalA.ToString("N0") A · @Cuadro.Alimentador.Polos polos</strong>
                }
            </div>
        }

        <p class="nota">
            La barra de cada espacio (@string.Join("/", Datos.Barras)) la fija su número, no se
            elige: por eso un interruptor de 3 polos en los espacios 1-3-5 toca las tres barras. Un
            multipolar ocupa espacios de dos en dos del mismo lado.
        </p>
    </section>

    <section class="tarjeta">
        <h2>Resumen de carga</h2>
        <table class="datos">
            <tr>
                <th></th><th>Instalada <span class="simbolo">(kVA)</span></th><th>F.D.</th><th>Demandada <span class="simbolo">(kVA)</span></th>
            </tr>
            <tr>
                <td class="izq">Carga continua</td>
                <td class="num">@((Cuadro.Resumen.ContinuaVA / 1000m).ToString("N2"))</td>
                <td class="num"><input class="va chico" type="number" min="0" max="1" step="0.05"
                                       @bind="Datos.FactorDemandaContinua" @bind:after="Recalcular" /></td>
                <td class="num">@((Cuadro.Resumen.ContinuaDemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            <tr>
                <td class="izq">Carga no continua</td>
                <td class="num">@((Cuadro.Resumen.NoContinuaVA / 1000m).ToString("N2"))</td>
                <td class="num"><input class="va chico" type="number" min="0" max="1" step="0.05"
                                       @bind="Datos.FactorDemandaNoContinua" @bind:after="Recalcular" /></td>
                <td class="num">@((Cuadro.Resumen.NoContinuaDemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            @if (Cuadro.Resumen.Minimo220_52VA > 0m)
            {
                <tr>
                    <td class="izq"><span class="ayuda" title="Completar a 1500 VA cada circuito de aparatos pequeños o de lavadora — 220-52(a) y (b). Carga de alimentador; no cambia el derivado.">Mínimo 220-52</span></td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52VA / 1000m).ToString("N2"))</td>
                    <td class="num">@Datos.FactorDemandaNoContinua.ToString("N2")</td>
                    <td class="num">@((Cuadro.Resumen.Minimo220_52DemandadoVA / 1000m).ToString("N2"))</td>
                </tr>
            }
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kVA)</span></td>
                <td class="num">@((Cuadro.Resumen.CalculadaVA / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaVA / 1000m).ToString("N2"))</td>
            </tr>
            <tr class="total">
                <td class="izq">Total <span class="simbolo">(kW)</span></td>
                <td class="num">@((Cuadro.Resumen.InstaladaW / 1000m).ToString("N2"))</td>
                <td></td>
                <td class="num">@((Cuadro.Resumen.DemandadaW / 1000m).ToString("N2"))</td>
            </tr>
            <tr>
                <td class="izq"><span class="ayuda" title="Consultar el factor de potencia del tablero: kW totales ÷ suma vectorial de kVA.">F.P. resultante</span></td>
                <td class="num">@Cuadro.Resumen.FactorPotencia.ToString("N2")</td>
                <td></td><td></td>
            </tr>
        </table>

        <h2 class="separado">Balanceo de fases</h2>
        <table class="datos">
            <tr>
                @foreach (var barra in Datos.Barras) { <th>@barra <span class="simbolo">(VA)</span></th> }
                <th>Desbalanceo</th>
            </tr>
            <tr>
                @foreach (var barra in Datos.Barras)
                {
                    <td class="num">@Cuadro.Resumen.CargaPorFaseVA[barra].ToString("N0")</td>
                }
                <td class="num fuerte">@Cuadro.Resumen.DesbalanceoPct.ToString("N1") %</td>
            </tr>
        </table>
    </section>

    <section class="tarjeta">
        <h2>Alimentador y protección principal</h2>
        <label class="suelto">Longitud del alimentador (m)
            <input type="number" min="0" step="1" @bind="Datos.LongitudAlimentadorM" @bind:after="Recalcular" />
        </label>

        @if (Cuadro.Alimentador.Resultado is { } a)
        {
            <table class="datos">
                @if (Cuadro.Alimentador.Gobierna is { } g && Datos.Barras.Count > 1)
                {
                    <tr>
                        <td class="izq"><span class="ayuda" title="Consultar la fase de mayor capacidad requerida (125 % continua + no continua). Dimensiona el alimentador — 215-2(a)(1), 215-3.">Fase que gobierna</span></td>
                        <td class="num">@g.Fase, la más cargada</td>
                    </tr>
                }
                <tr><td class="izq">Corriente de diseño</td><td class="num">@a.CorrienteDisenoA.ToString("N2") A</td></tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar el factor de potencia de las cargas de la fase que gobierna. Aplica a la caída de tensión del alimentador.">Factor de potencia</span></td>
                    <td class="num">@Cuadro.Alimentador.FactorPotencia.ToString("N2")</td>
                </tr>
                <tr class="total">
                    <td class="izq">@(Datos.UsaInterruptorPrincipal ? "Interruptor principal" : "Protección del lado de alimentación")</td>
                    <td class="num fuerte">@Ayuda($"{a.ProteccionA:N0} A · {Cuadro.Alimentador.Polos} polos", Cuadro.DesgloseDelAlimentador()?.Proteccion)</td>
                </tr>
                <tr><td class="izq">Conductor de fase</td><td class="num">@Ayuda($"{a.CalibreFase.Designacion} AWG/kcmil", Cuadro.DesgloseDelAlimentador()?.Conductor)</td></tr>
                <tr><td class="izq"><span class="ayuda" title="Consultar el conductor de neutro: mismo calibre que la fase. En 2 fases + neutro de estrella lleva ≈ la corriente de fase: contarlo en «Agrupados» — 310-15(b)(5)(2); no reducirlo — 220-61(c)(1).">Conductor de neutro</span></td><td class="num">@a.CalibreNeutro.Designacion AWG/kcmil</td></tr>
                <tr><td class="izq">Puesta a tierra</td><td class="num">@a.CalibreTierra.Designacion AWG/kcmil</td></tr>
                <tr>
                    <td class="izq"><span class="ayuda" title="Consultar la caída de tensión del alimentador: la de la peor fase, con la caída del neutro — Tabla 9. Pasar el cursor sobre el valor para consultar cada fase. Recomendado: 3 % en el alimentador y 5 % combinada con el derivado — 215-2(a)(4), NOTA 2.">Caída de tensión</span></td>
                    <td class="num @(a.CaidaTensionPct > Datos.CaidaMaxAlimentadorPct ? "excede" : null)">@Ayuda(CaidaDelAlimentador(a), CaidaPorFase(a))</td>
                </tr>
                @if (a.CorrienteNeutro is { } neutro)
                {
                    <tr><td class="izq"><span class="ayuda" title="Consultar la corriente del neutro: suma fasorial de las corrientes de fase. Entra a la caída de tensión.">Corriente de neutro</span></td><td class="num">@neutro.Magnitud.ToString("N2") A</td></tr>
                }
            </table>

            @foreach (var aviso in Cuadro.Alimentador.Avisos)
            {
                <p class="aviso">@aviso</p>
            }
        }
        else if (Cuadro.Alimentador.Error is { } error)
        {
            <p class="aviso error">@error</p>
        }
        else
        {
            <p class="derivado">Captura la carga de algún circuito y aquí sale el alimentador.</p>
        }
    </section>
</div>

@*
    Los avisos de caída combinada van aquí y no como renglón de la tabla: dentro del cuadro partían
    los circuitos y se leían como parte del cálculo. Solo salen si los límites por tramo suman más
    del 5 % (Datos.AvisoLimitesDeCaida) y algún circuito de verdad se pasa.
*@
@if (Cuadro.ConCaidaCombinadaExcedida.Any())
{
    <section class="tarjeta avisos">
        <h2>Avisos de caída combinada</h2>
        @foreach (var c in Cuadro.ConCaidaCombinadaExcedida)
        {
            <p class="aviso">@c.AvisoCaidaCombinada</p>
        }
    </section>
}

<footer class="pie">
    Tablas leídas de
    <a href="https://github.com/dflores296/NOM-001-SEDE-2012">NOM-001-SEDE-2012</a>,
    verificadas celda por celda contra el PDF del DOF.
    Tabla 8 verificada el @Motor.Fuente.VerificadaEl("8").
    <strong>Los resultados no sustituyen el criterio del ingeniero responsable.</strong>
</footer>

@code {
    /// <summary>Por circuito, el motivo por el que no se pudo cambiar de polos. Se borra al siguiente intento.</summary>
    private readonly Dictionary<int, string> _motivo = [];

    private CuadroDeCarga Cuadro => Proyecto.Cuadro;
    private DatosDelTablero Datos => Cuadro.Datos;

    private void Recalcular() => Cuadro.Recalcular();

    /// <summary>
    /// Los aislamientos de uso común en instalaciones de baja tensión, todos reconocidos por la
    /// Tabla 310-104(a) que lee el motor. THW no está: la tabla lo da solo para lugares mojados;
    /// THW-LS cubre secos y mojados.
    /// </summary>
    /// <summary>El lugar como texto: un <c>select</c> enlazado directo a un <c>bool</c> no reconoce «true»/«false» y se queda en blanco.</summary>
    private string Lugar
    {
        get => Datos.LugarSeco ? "seco" : "mojado";
        set => Datos.LugarSeco = value == "seco";
    }

    private string Terminales
    {
        get => Datos.TerminalesMarcadas75C ? "75" : "60";
        set => Datos.TerminalesMarcadas75C = value == "75";
    }

    private static readonly string[] Aislamientos = ["THHN", "THHW-LS", "THW-LS", "THWN", "THWN-2", "XHHW-2", "TW"];

    /// <summary>
    /// Cuántas columnas tiene el cuadro, para los <c>colspan</c> de los renglones que abarcan todo.
    /// Depende de las barras: un tablero de dos barras no tiene columna de balanceo para la C.
    /// </summary>
    private int Columnas => 22 + Datos.Barras.Count;

    /// <summary>Los dos bloques del cuadro, ya materializados: cada uno se recorre más de una vez.</summary>
    private List<CircuitoDelCuadro>[] Lados => [Cuadro.Nones.ToList(), Cuadro.Pares.ToList()];

    /// <summary>
    /// Las tres celdas de un conductor: hilos, mm² y designación AWG/kcmil. Se combinan hacia abajo
    /// tantos renglones como polos tenga el interruptor.
    /// </summary>
    /// <param name="porque">El desglose de la selección: si viene, la designación AWG/kcmil lleva un
    /// tooltip con cómo se llegó a ese calibre.</param>
    private static RenderFragment Conductor(Calibre? calibre, int hilos, int polos, IReadOnlyList<string>? porque = null) => builder =>
    {
        var textos = calibre is null || hilos <= 0
            ? ["", "", ""]
            : new[] { hilos.ToString(), calibre.AreaMm2.ToString("N2"), calibre.Designacion };

        for (var i = 0; i < textos.Length; i++)
        {
            builder.OpenElement(0, "td");
            builder.AddAttribute(1, "class", "num");
            builder.AddAttribute(2, "rowspan", polos);
            if (i == 2 && porque is not null && textos[i] != "")
                builder.AddContent(3, Ayuda(textos[i], porque));
            else
                builder.AddContent(4, textos[i]);
            builder.CloseElement();
        }
    };

    /// <summary>
    /// Un valor con su porqué en un tooltip, subrayado punteado como los encabezados que ya lo
    /// llevan. Sin desglose, el valor tal cual.
    /// </summary>
    private static RenderFragment Ayuda(string? valor, IReadOnlyList<string>? porque) => builder =>
    {
        if (porque is null || string.IsNullOrEmpty(valor))
        {
            builder.AddContent(0, valor);
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", "ayuda");
        builder.AddAttribute(3, "title", DesgloseDeSeleccion.ComoTexto(porque));
        builder.AddContent(4, valor);
        builder.CloseElement();
    };

    /// <summary>
    /// El VA con el que de verdad se calcula, debajo de lo capturado en W o A — I-25. En VA no se
    /// repite: sería el mismo número dos veces.
    /// </summary>
    private static RenderFragment? EnVA(CircuitoDelCuadro c, decimal capturado, decimal va) =>
        c.Unidad == UnidadConsumo.VoltAmperes || capturado <= 0m
            ? null
            : @<span class="en-va">= @va.ToString("N0") VA</span>;

    /// <summary>
    /// Qué hace el F.P. en ESTE renglón, que depende de la unidad: con W convierte a VA y mueve todo;
    /// con VA o A la corriente no pasa por él, y solo mueve la caída de tensión y los kW.
    /// </summary>
    private static string AyudaFactorPotencia(CircuitoDelCuadro c) => c.Unidad == UnidadConsumo.Watts
        ? "Capturada en W: VA = W ÷ F.P. Modifica corriente, protección, conductor, caída de tensión y kW."
        : $"Capturada en {(c.Unidad == UnidadConsumo.Amperes ? "A" : "VA")}: el F.P. no modifica la corriente ni la protección. " +
          "Modifica la caída de tensión (y el conductor, si excede el límite) y los kW.";

    private static string Titulo(BloqueDelGabinete bloque) =>
        bloque.Ocupado
            ? $"Espacio(s) {bloque.Numeros} · barra(s) {bloque.Barras} · {bloque.Espacios} polo(s)"
            : $"Espacio {bloque.Numeros} · barra {bloque.Barras} · libre";

    /// <summary>«6.77 % (fase C)»: la caída del alimentador y la fase que la da.</summary>
    private static string CaidaDelAlimentador(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? $"{a.CaidaTensionPct:N2} % (fase {fases.Aggregate((m, f) => f.CaidaPct > m.CaidaPct ? f : m).Fase})"
            : $"{a.CaidaTensionPct:N2} %";

    private static IReadOnlyList<string>? CaidaPorFase(ResultadoAlimentador a) =>
        a.CaidaPorFase is { Count: > 0 } fases
            ? [.. fases.Select(f => $"Fase {f.Fase}: {f.Corriente.Magnitud:N2} A → {f.CaidaV:N2} V ({f.CaidaPct:N2} %)")]
            : null;

    private bool Excede(CircuitoDelCuadro c) =>
        c.Resultado is not null && c.Resultado.CaidaTensionPct > Datos.CaidaMaxDerivadoPct;

    /// <summary>
    /// Cambiar los polos puede no poderse —el espacio de al lado está ocupado, o el interruptor no
    /// cabe—, así que no se enlaza directo: se pregunta al cuadro y, si dice que no, se enseña el
    /// motivo en vez de dejar que el selector mienta.
    /// </summary>
    private void CambiarPolos(CircuitoDelCuadro circuito, string? valor)
    {
        _motivo.Remove(circuito.Espacio);

        if (!int.TryParse(valor, out var polos))
            return;

        if (Cuadro.CambiarPolos(circuito, polos) is { } motivo)
            _motivo[circuito.Espacio] = motivo;
    }
}
