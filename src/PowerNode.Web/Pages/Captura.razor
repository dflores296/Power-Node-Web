    private static string Apagado(bool apagado) => apagado ? "apagado" : "";

    /// <summary>
    /// El <c>data-col</c> del campo de cada columna: Enter baja al mismo campo de la línea siguiente, y la barra de
    /// ayuda (I-56) toma la del encabezado con el mismo valor.
    /// </summary>
    private static string CampoDe(ColDesglose col) => col switch
    {
        ColDesglose.Desc => "ap-desc", ColDesglose.Tipo => "ap-tipo", ColDesglose.Subtipo => "ap-subtipo", ColDesglose.Cant => "ap-cant",
        ColDesglose.Tension => "ap-tension", ColDesglose.Unidad => "ap-unidad", ColDesglose.Fp => "ap-fp",
        ColDesglose.CargaCU or ColDesglose.Hp or ColDesglose.CorrienteNominal or ColDesglose.CorrienteTotal or ColDesglose.CorrienteEntrada
            or ColDesglose.Ampacidad or ColDesglose.ContinuaTablero => "ap-carga",
        ColDesglose.Servicio or ColDesglose.NoContinuaTablero => "ap-continua",
        _ => $"ap-{col.ToString().ToLowerInvariant()}",
    };

    /// <summary>Una celda del equipo del renglón: sus datos son los del circuito.</summary>
    private RenderFragment CeldaDelEquipo(CircuitoDelCuadro c, BloqueDelDesglose b, ColDesglose col) => __builder =>
    {
        var subtipo = c.SubtipoDelRenglon!.Value;
        var tipo = subtipo.Tipo();
        switch (col)
        {
            case ColDesglose.Desc:
                <td data-falta="@FaltaEn(c, null, col)" class="izq"><input class="desc" data-col="ap-desc" aria-label="Circuito @c.Espacio, equipo · Descripción" @bind="c.DescripcionDelEquipo" @bind:after="Recalcular" placeholder="Descripción" /></td>
                break;
            case ColDesglose.Tipo:
                <td data-falta="@FaltaEn(c, null, col)">
                    <select class="tipo" data-col="ap-tipo" aria-label="Circuito @c.Espacio, equipo · Tipo" value="@tipo" @onchange="e => CambiarTipoDelRenglon(c, e.Value?.ToString())">
                        @foreach (var t in CategoriasDeCarga.Todas) { <option value="@t">@t.Nombre()</option> }
                    </select>
                </td>
                break;
            case ColDesglose.Subtipo:
                <td data-falta="@FaltaEn(c, null, col)" class="subtipo">
                    <select class="subtipo" data-col="ap-subtipo" aria-label="Circuito @c.Espacio, equipo · Subtipo" value="@subtipo" @onchange="e => CambiarSubtipoDelRenglon(c, e.Value?.ToString())">
                        @foreach (var sub in SubtiposDeCarga.De(tipo)) { <option @key="sub" value="@sub">@sub.Nombre()</option> }
                    </select>
                    <a class="a-la-guia" href="@($"guia#{GuiaDeCargas.Ancla(GuiaDeCargas.DeSubtipo(subtipo))}")" target="_blank" rel="noopener" tabindex="-1" title="Abrir su rama en la guía de cargas, en otra pestaña." aria-label="Guía: @subtipo.Nombre()">?</a>
                </td>
                break;
            case ColDesglose.Cant:
                @if (b.Juego is JuegoDeColumnas.Variadores or JuegoDeColumnas.Combinada)
                {
                    <td data-falta="@FaltaEn(c, null, col)"><span class="fijo" title="Un equipo por renglón.">1</span></td>
                }
                else
                {
                    <td data-falta="@FaltaEn(c, null, col)"><input class="va corto" data-col="ap-cant" type="text" inputmode="numeric" autocomplete="off" data-numero min="1" step="1" aria-label="Circuito @c.Espacio, equipo · Cantidad" value="1" @onchange="e => CambiarCantidadDelRenglon(c, e)" /></td>
                }
                break;
            case ColDesglose.Tension:
                var tensiones = TensionesDePlaca.De(Datos);
                <td data-falta="@FaltaEn(c, null, col)">
                    <select class="tension @(c.TensionDePlaca is null ? "falta" : null)" data-col="ap-tension" aria-label="Circuito @c.Espacio · @(c.EsVariador ? "Tensión de entrada del variador" : "Tensión de placa")" aria-invalid="@(c.TensionDePlaca is null ? "true" : null)"
                            value="@(c.TensionDePlaca?.ToString() ?? "")" @onchange="e => CambiarTensionDePlaca(c, e.Value?.ToString())">
                        <option @key="@("ninguna")" value="">— escoger —</option>
                        @foreach (var t in tensiones) { <option @key="t" value="@t">@t.Texto()</option> }
                        @if (c.TensionDePlaca is { } fuera && !tensiones.Contains(fuera)) { <option @key="fuera" value="@fuera">@fuera.Texto() (no es de este tablero)</option> }
                    </select>
                </td>
                break;
            case ColDesglose.Unidad:
                <td data-falta="@FaltaEn(c, null, col)">
                    <select class="unidad" data-col="ap-unidad" aria-label="Circuito @c.Espacio, equipo · Unidad" value="@c.CapturaMotor" @onchange="e => CambiarUnidad(c, e.Value?.ToString())">
                        <option value="@nameof(CapturaDeMotor.Hp)">HP</option>
                        <option value="@nameof(CapturaDeMotor.Amperes)">A</option>
                    </select>
                </td>
                break;
            case ColDesglose.Hp:
                @if (c.CapturaMotor == CapturaDeMotor.Hp)
                {
                    <td data-falta="@FaltaEn(c, null, col)">
                        <select class="hp" data-col="ap-carga" aria-label="Circuito @c.Espacio · HP" value="@ValorHpConPolos(c.Polos, c.Hp ?? 0m)" @onchange="e => CambiarHp(c, e.Value?.ToString())">
                            <option @key="@($"{c.Polos}|0")" value="@ValorHpConPolos(c.Polos, 0m)">—</option>
                            @for (var p = 1; p <= Datos.MaximoPolos; p++)
                            {
                                var polos = p;
                                var disponibles = Cuadro.HpDisponibles(polos);
                                if (disponibles.Count == 0) { continue; }
                                <optgroup @key="@($"g{polos}")" label="@Cuadro.AlimentacionDelMotor(polos) · @polos @(polos == 1 ? "polo" : "polos")">
                                    @foreach (var hp in disponibles) { <option @key="@ValorHpConPolos(polos, hp)" value="@ValorHpConPolos(polos, hp)">@MotoresEnHp.Texto(hp) HP · @Cuadro.TensionDelMotorV(polos).ToString("0") V — @Cuadro.FlcDe(hp, polos).ToString("N2") A</option> }
                                </optgroup>
                            }
                            @if (c.Hp is > 0m and { } fueraHp && !Cuadro.HpDisponibles(c).Contains(fueraHp)) { <option @key="@($"fuera|{fueraHp}")" value="@ValorHpConPolos(c.Polos, fueraHp)">@MotoresEnHp.Texto(fueraHp) HP</option> }
                        </select>
                        @if (c.FlcA > 0m)
                        {
                            <span class="nota-min" title="Corriente de plena carga de tabla · @(c.Polos == 3 ? "Tabla 430-250" : "Tabla 430-248")">@Cuadro.TensionDelMotorV(c.Polos).ToString("0") V · FLC @c.FlcA.ToString("N2") A</span>
                        }
                    </td>
                }
                else
                {
                    <td data-falta="@FaltaEn(c, null, col)"><span class="fijo" title="HP que le corresponden por su corriente · 430-6(a)(1)">@(c.MotorEnAmperes is { } m ? $"{m.Hp:0.##} HP" : "—")</span></td>
                }
                break;
            case ColDesglose.CorrientePlaca:
                @if (c.CapturaMotor == CapturaDeMotor.Amperes)
                {
                    <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="@CampoDe(ColDesglose.CorrientePlaca)" aria-label="Circuito @c.Espacio · Corriente de placa del motor (A)" value="@Carga(c.CorrientePlacaA)" @onchange="e => { c.CorrientePlacaA = LeerCarga(e, c.CorrientePlacaA); Recalcular(); }"
                               title="Corriente de la placa del motor · 430-6(a)(1)" /></td>
                }
                else
                {
                    var noContinuo = c.Servicio is not null;
                    <td data-falta="@FaltaEn(c, null, col)"><input class="va placa-servicio @Apagado(!noContinuo)" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="—" disabled="@(!noContinuo)" data-col="@CampoDe(ColDesglose.CorrientePlaca)" aria-label="Circuito @c.Espacio · Corriente de placa del motor (servicio)" value="@Carga(c.CorrientePlacaServicioA)" @onchange="e => { c.CorrientePlacaServicioA = LeerCarga(e, c.CorrientePlacaServicioA); Recalcular(); }"
                               title="@(noContinuo ? "Corriente usada para motores de servicio no continuo · 430-22(e)" : "Solo con servicio no continuo.")" /></td>
                }
                break;
            case ColDesglose.Servicio:
                <td data-falta="@FaltaEn(c, null, col)">
                    <select class="servicio" data-col="ap-continua" aria-label="Circuito @c.Espacio · Servicio del motor" value="@ValorServicio(c)" @onchange="e => CambiarServicio(c, e.Value?.ToString())">
                        <option value="">Continuo</option>
                        @foreach (var sv in Enum.GetValues<ServicioDeMotor>())
                        {
                            <optgroup label="@NombreServicio(sv)">
                                @foreach (var t in Enum.GetValues<EspecificacionDeTiempo>().Where(t => !(sv == ServicioDeMotor.CortaDuracion && t == EspecificacionDeTiempo.Continuo)))
                                {
                                    <option value="@($"{sv}|{t}")">@NombreServicio(sv, corto: true) · @NombreTiempo(t)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </td>
                break;
            case ColDesglose.NoArranca:
                <td data-falta="@FaltaEn(c, null, col)"><input type="checkbox" class="@Apagado(!c.EsMotorSolo)" disabled="@(!c.EsMotorSolo)" data-col="@CampoDe(ColDesglose.NoArranca)" aria-label="Circuito @c.Espacio · El motor no arranca con la protección de tabla" checked="@c.NoArrancaConLaTabla" @onchange="e => { c.NoArrancaConLaTabla = e.Value is true; Recalcular(); }"
                           title="@(c.EsMotorSolo ? $"El motor no arranca con la protección de tabla: hasta {(c.FlcA > 100m ? 300 : 400)} % · 430-52(c)(1)" : "Solo con un motor solo.")" /></td>
                break;
            case ColDesglose.Terminal75:
                <td data-falta="@FaltaEn(c, null, col)"><input type="checkbox" class="@Apagado(!c.EsMotorSolo)" disabled="@(!c.EsMotorSolo)" data-col="@CampoDe(ColDesglose.Terminal75)" aria-label="Circuito @c.Espacio · Motor diseño B a E y arrancador marcado 75 °C" checked="@c.MotorYArrancadorMarcados75C" @onchange="e => { c.MotorYArrancadorMarcados75C = e.Value is true; Recalcular(); }"
                           title="@(c.EsMotorSolo ? "Motor de diseño B a E con arrancador marcado 75 °C · 110-14(c)" : "Solo con un motor solo.")" /></td>
                break;
            case ColDesglose.CorrienteEntrada:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio · Corriente de entrada del variador (A)" value="@Carga(c.CorrienteEntradaVariadorA)" @onchange="e => { c.CorrienteEntradaVariadorA = LeerCarga(e, c.CorrienteEntradaVariadorA); Recalcular(); }"
                           title="Corriente de entrada de la placa del variador · 430-122(a)" /></td>
                break;
            case ColDesglose.ProtMaxFabricante:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="@CampoDe(ColDesglose.ProtMaxFabricante)" aria-label="Circuito @c.Espacio · Protección máxima del variador (A)" value="@Carga(c.ProteccionMaximaVariadorA)" @onchange="e => { c.ProteccionMaximaVariadorA = LeerCarga(e, c.ProteccionMaximaVariadorA); Recalcular(); }"
                           title="Protección máxima permitida por el fabricante · 110-3(b)" /></td>
                break;
            case ColDesglose.Bypass:
                <td data-falta="@FaltaEn(c, null, col)"><input type="checkbox" data-col="@CampoDe(ColDesglose.Bypass)" aria-label="Circuito @c.Espacio · Variador con bypass" checked="@c.VariadorConBypass" @onchange="e => { c.VariadorConBypass = e.Value is true; Recalcular(); }" title="El variador tiene bypass a la línea · 430-122(b)" /></td>
                break;
            case ColDesglose.HpMotor:
                var conBypass = c.VariadorConBypass;
                <td data-falta="@FaltaEn(c, null, col)">
                    <select class="hp @Apagado(!conBypass) @(conBypass && !(c.HpMotorDelVariador > 0m) ? "falta" : null)" disabled="@(!conBypass)" data-col="@CampoDe(ColDesglose.HpMotor)" aria-label="Circuito @c.Espacio · HP del motor del variador" value="@ValorHp(c.HpMotorDelVariador)" @onchange="e => CambiarHpDelVariador(c, e.Value?.ToString())"
                            title="@(conBypass ? "Potencia del motor que mueve el variador · 430-6(a)" : "Solo con bypass.")">
                        <option @key="@("ninguno")" value="">—</option>
                        @foreach (var hp in Cuadro.HpDisponibles(c.Polos)) { <option @key="hp" value="@ValorHp(hp)">@MotoresEnHp.Texto(hp) HP — @Cuadro.FlcDe(hp, c.Polos).ToString("N2") A</option> }
                        @if (c.HpMotorDelVariador is > 0m and { } fueraDelVariador && !Cuadro.HpDisponibles(c.Polos).Contains(fueraDelVariador)) { <option @key="@($"fuera|{fueraDelVariador}")" value="@ValorHp(fueraDelVariador)">@MotoresEnHp.Texto(fueraDelVariador) HP</option> }
                    </select>
                </td>
                break;
            case ColDesglose.CorrienteNominal:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio · Corriente de carga nominal (A)" value="@Carga(c.CorrientePlacaA)" @onchange="e => { c.CorrientePlacaA = LeerCarga(e, c.CorrientePlacaA); Recalcular(); }"
                           title="Corriente de carga nominal de la placa · 440-6(a)" /></td>
                break;
            case ColDesglose.CorrienteSeleccion:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="—" data-col="@CampoDe(ColDesglose.CorrienteSeleccion)" aria-label="Circuito @c.Espacio · Corriente de selección (A)" value="@Carga(c.CorrienteSeleccionA ?? 0m)" @onchange="e => { var v = LeerCarga(e, c.CorrienteSeleccionA ?? 0m); c.CorrienteSeleccionA = v > 0m ? v : null; Recalcular(); }"
                           title="Corriente de selección de la placa, si la trae · 440-6(a)" /></td>
                break;
            case ColDesglose.Arranque225:
                <td data-falta="@FaltaEn(c, null, col)"><input type="checkbox" data-col="@CampoDe(ColDesglose.Arranque225)" aria-label="Circuito @c.Espacio · No arranca al 175 %" checked="@c.ArranqueAl225" @onchange="e => { c.ArranqueAl225 = e.Value is true; Recalcular(); }" title="No arranca con la protección al 175 % · 440-22(a)" /></td>
                break;
            case ColDesglose.Ampacidad:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio · Ampacidad de los conductores (MCA)" value="@Carga(c.AmpacidadMinimaA)" @onchange="e => { c.AmpacidadMinimaA = LeerCarga(e, c.AmpacidadMinimaA); Recalcular(); }"
                           title="Ampacidad mínima de los conductores, de la placa · 440-4(b)" /></td>
                break;
            case ColDesglose.ProtMaxPlaca:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="@CampoDe(ColDesglose.ProtMaxPlaca)" aria-label="Circuito @c.Espacio · Protección máxima (MOCP)" value="@Carga(c.ProteccionMaximaA)" @onchange="e => { c.ProteccionMaximaA = LeerCarga(e, c.ProteccionMaximaA); Recalcular(); }"
                           title="Protección máxima de la placa · 440-4(b)" /></td>
                break;
            case ColDesglose.CorrienteTotal:
                <td data-falta="@FaltaEn(c, null, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio · Corriente total del acondicionador (A)" value="@Carga(c.CorrientePlacaA)" @onchange="e => { c.CorrientePlacaA = LeerCarga(e, c.CorrientePlacaA); Recalcular(); }"
                           title="Corriente total de la placa del acondicionador · 440-62" /></td>
                break;
            case ColDesglose.Fp:
                <td data-falta="@FaltaEn(c, null, col)"><input data-requerido class="va fp" type="text" inputmode="decimal" autocomplete="off" data-numero min="@FactorMinimo" max="1" step="0.05" data-col="ap-fp" aria-label="Circuito @c.Espacio, equipo · F.P." value="@Factor(c.FactorPotencia)" @onchange="e => { c.FactorPotencia = LeerFactor(e, c.FactorPotencia); Recalcular(); }" /></td>
                break;
            case ColDesglose.Total:
                <td data-falta="@FaltaEn(c, null, col)" class="num">@c.CargaInstaladaVA.ToString("#,0.##")</td>
                break;
            case ColDesglose.Quitar:
                <td data-falta="@FaltaEn(c, null, col)"><button class="quitar" title="Quitar el equipo del circuito" aria-label="Quitar el equipo del circuito @c.Espacio" @onclick="() => QuitarRenglon(c)"><Icono Nombre="quitar" Tamano="14" /></button></td>
                break;
            default:
                <td data-falta="@FaltaEn(c, null, col)" class="tenue">—</td>
                break;
        }
    };

    /// <summary>Una celda de una línea del desglose.</summary>
    private RenderFragment CeldaDeLinea(CircuitoDelCuadro c, CargaDelCircuito aparato, int n, ColDesglose col) => __builder =>
    {
        var tipoDeLinea = c.TipoDe(aparato);
        switch (col)
        {
            case ColDesglose.Desc:
                <td data-falta="@FaltaEn(c, aparato, col)" class="izq"><input class="desc" data-col="ap-desc" aria-label="Circuito @c.Espacio, carga @n · Descripción" @bind="aparato.Descripcion" @bind:after="Recalcular" placeholder="Descripción" /></td>
                break;
            case ColDesglose.Tipo:
                <td data-falta="@FaltaEn(c, aparato, col)">
                    <select class="tipo" data-col="ap-tipo" aria-label="Circuito @c.Espacio, carga @n · Tipo" value="@(aparato.Subtipo is null && !c.TipoElegido ? "" : tipoDeLinea.ToString())" @onchange="e => CambiarTipoDeCarga(c, aparato, e.Value?.ToString())">
                        @if (aparato.Subtipo is null && !c.TipoElegido) { <option value="">—</option> }
                        @foreach (var t in CategoriasDeCarga.Todas) { <option value="@t">@t.Nombre()</option> }
                    </select>
                </td>
                break;
            case ColDesglose.Subtipo:
                <td data-falta="@FaltaEn(c, aparato, col)" class="subtipo">
                    <select class="subtipo" data-col="ap-subtipo" aria-label="Circuito @c.Espacio, carga @n · Subtipo" value="@(aparato.Subtipo?.ToString() ?? "")" @onchange="e => CambiarSubtipo(c, aparato, e.Value?.ToString())">
                        @if (aparato.Subtipo is null) { <option value="">—</option> }
                        @foreach (var sub in SubtiposDeCarga.De(tipoDeLinea).Where(x => !x.SoloEnElRenglon() || c.Cargas.Count == 1)) { <option @key="sub" value="@sub">@sub.Nombre()</option> }
                    </select>
                    <a class="a-la-guia" href="@($"guia#{GuiaDeCargas.Ancla(aparato.Subtipo is { } sg ? GuiaDeCargas.DeSubtipo(sg) : GuiaDeCargas.DeTipo(tipoDeLinea))}")" target="_blank" rel="noopener" tabindex="-1"
                       title="Abrir su rama en la guía de cargas, en otra pestaña." aria-label="Guía: @(aparato.Subtipo?.Nombre() ?? tipoDeLinea.Nombre())">?</a>
                </td>
                break;
            case ColDesglose.Cant:
                var cantidadFija = aparato.Subtipo?.VaSolo() == true || aparato.EsTablero || aparato.Clase == ClaseDeAparato.Variador;
                @if (cantidadFija)
                {
                    <td data-falta="@FaltaEn(c, aparato, col)"><span class="fijo" title="@(aparato.EsTablero ? "Cada tablero en su renglón." : aparato.Clase == ClaseDeAparato.Variador ? "Cada variador en su renglón." : "Va solo en su circuito: uno.")">@aparato.Cantidad</span></td>
                }
                else
                {
                    <td data-falta="@FaltaEn(c, aparato, col)"><span class="cantidad"><input data-requerido data-col="ap-cant" aria-label="Circuito @c.Espacio, carga @n · Cantidad" class="va corto" type="text" inputmode="decimal" autocomplete="off" data-numero min="1" step="1" @bind="aparato.Cantidad" @bind:culture="CultureInfo.InvariantCulture" @bind:after="() => TrasEditarLinea(c)" />
                        <span class="flechas">
                            <button type="button" class="flecha" tabindex="-1" title="Una más" aria-label="Circuito @c.Espacio, carga @n · Una más" @onclick="() => CambiarCantidad(c, aparato, 1)"><svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 5 5 1 9 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
                            <button type="button" class="flecha" tabindex="-1" title="Una menos" aria-label="Circuito @c.Espacio, carga @n · Una menos" disabled="@(aparato.Cantidad <= 1)" @onclick="() => CambiarCantidad(c, aparato, -1)"><svg viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1 5 5 9 1" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
                        </span></span></td>
                }
                break;
            case ColDesglose.Unidad:
                <td data-falta="@FaltaEn(c, aparato, col)">
                    <select class="unidad" data-col="ap-unidad" aria-label="Circuito @c.Espacio, carga @n · Unidad" value="@UnidadDeMiembro(aparato)" @onchange="e => CambiarUnidadDeMiembro(aparato, e.Value?.ToString())">
                        @if (aparato.Clase == ClaseDeAparato.Motor)
                        {
                            <option value="Motor|@CapturaDeMotor.Hp">HP</option>
                            <option value="Motor|@CapturaDeMotor.Amperes">A</option>
                        }
                        else
                        {
                            <option value="Carga|@UnidadConsumo.VoltAmperes">VA</option>
                            <option value="Carga|@UnidadConsumo.Watts">W</option>
                            <option value="Carga|@UnidadConsumo.Amperes">A</option>
                        }
                    </select>
                </td>
                break;
            case ColDesglose.CargaCU:
                <td data-falta="@FaltaEn(c, aparato, col)">
                    <input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · Carga c/u" value="@Carga(aparato.CargaUnitaria)" @onchange="e => { aparato.CargaUnitaria = LeerCarga(e, aparato.CargaUnitaria); Recalcular(); }" />
                    @if (aparato.Subtipo?.MinimoUnitarioVA(Datos.Inmueble.EsVivienda()) is { } minimo)
                    {
                        <span class="nota-min" title="Carga mínima por salida: @minimo.VA.ToString("#,0") VA · @minimo.Referencia">mín. @minimo.VA.ToString("#,0") VA</span>
                    }
                    else if (aparato.Subtipo?.MinimoPorCircuitoVA() is { } porCircuito)
                    {
                        <span class="nota-min larga" title="Carga mínima por circuito de anuncios: @porCircuito.VA.ToString("#,0") VA · @porCircuito.Referencia">mín. @porCircuito.VA.ToString("#,0") VA por circuito</span>
                    }
                </td>
                break;
            case ColDesglose.Hp:
                @if (aparato.CapturaMotor == CapturaDeMotor.Hp)
                {
                    <td data-falta="@FaltaEn(c, aparato, col)">
                        <select class="hp" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · HP" value="@(aparato.Hp?.ToString(CultureInfo.InvariantCulture) ?? "0")" @onchange="e => CambiarHpDeMiembro(aparato, e.Value?.ToString())"
                                title="Potencia del motor, con su corriente de tabla · 430-6(a)">
                            <option value="0">—</option>
                            @foreach (var hp in Cuadro.HpDisponibles(c.Polos)) { <option @key="hp" value="@hp.ToString(CultureInfo.InvariantCulture)">@MotoresEnHp.Texto(hp) HP — @Cuadro.FlcDe(hp, c.Polos).ToString("N2") A</option> }
                            @if (aparato.Hp is > 0m and { } fuera && !Cuadro.HpDisponibles(c.Polos).Contains(fuera)) { <option value="@fuera.ToString(CultureInfo.InvariantCulture)">@MotoresEnHp.Texto(fuera) HP</option> }
                        </select>
                    </td>
                }
                else
                {
                    <td data-falta="@FaltaEn(c, aparato, col)"><span class="fijo" title="HP que le corresponden por su corriente · 430-6(a)(1)">@(aparato.MotorEnAmperes is { } m ? $"{m.Hp:0.##} HP" : "—")</span></td>
                }
                break;
            case ColDesglose.CorrientePlaca:
                var enAmperes = aparato.CapturaMotor == CapturaDeMotor.Amperes;
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va @Apagado(!enAmperes)" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="—" disabled="@(!enAmperes)" data-col="@CampoDe(ColDesglose.CorrientePlaca)" aria-label="Circuito @c.Espacio, carga @n · Corriente de placa (A)" value="@(enAmperes ? Carga(aparato.CorrientePlacaA) : "")" @onchange="e => { aparato.CorrientePlacaA = LeerCarga(e, aparato.CorrientePlacaA); Recalcular(); }"
                           title="@(enAmperes ? "Corriente de la placa del motor · 430-6(a)(1)" : "Solo con la unidad en A.")" /></td>
                break;
            case ColDesglose.Servicio:
                <td data-falta="@FaltaEn(c, aparato, col)">
                    @if (aparato.Clase == ClaseDeAparato.Motor)
                    {
                        @if (ReferenceEquals(c.MotorAl125, aparato))
                        {
                            <span class="clase-motor" title="El motor mayor del circuito se considera al 125 % · 220-18(a)">motor mayor · 125 %</span>
                        }
                        else if (c.TipoDe(aparato) == CategoriaDeCarga.Motor)
                        {
                            <span class="clase-motor" title="En un grupo, cada motor se considera continuo.">Continuo</span>
                        }
                        else
                        {
                            <span class="tenue" title="Se considera al 100 % · 220-18(a)">—</span>
                        }
                    }
                    else
                    {
                        <select class="servicio-carga" data-col="ap-continua" aria-label="Circuito @c.Espacio, carga @n · Continua" value="@(aparato.Continua ? "si" : "no")"
                                @onchange="e => CambiarContinua(aparato, e.Value?.ToString())" disabled="@(aparato.ReferenciaContinua is not null)"
                                title="@(aparato.ReferenciaContinua is { } rc ? $"Siempre continua · {rc}" : "Continua: opera 3 h o más · 210-19(a)(1)")">
                            <option value="no">No continua</option>
                            <option value="si">Continua</option>
                        </select>
                    }
                </td>
                break;
            case ColDesglose.NoArranca:
            case ColDesglose.Terminal75:
                <td data-falta="@FaltaEn(c, aparato, col)"><input type="checkbox" class="apagado" disabled data-col="@CampoDe(col)" aria-label="Circuito @c.Espacio, carga @n · @(col == ColDesglose.NoArranca ? "No arranca" : "Terminal 75 °C")" title="Solo con un motor solo." /></td>
                break;
            case ColDesglose.CorrienteEntrada:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · Corriente de entrada del variador (A)" value="@Carga(aparato.CorrientePlacaA)" @onchange="e => { aparato.CorrientePlacaA = LeerCarga(e, aparato.CorrientePlacaA); Recalcular(); }"
                           title="Corriente de entrada de la placa del variador · 430-122(a)" /></td>
                break;
            case ColDesglose.ProtMaxFabricante:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="@CampoDe(ColDesglose.ProtMaxFabricante)" aria-label="Circuito @c.Espacio, carga @n · Protección máxima del variador (A)" value="@Carga(aparato.ProteccionMaximaA)" @onchange="e => { aparato.ProteccionMaximaA = LeerCarga(e, aparato.ProteccionMaximaA); Recalcular(); }"
                           title="Protección máxima permitida por el fabricante · 110-3(b)" /></td>
                break;
            case ColDesglose.Bypass:
            case ColDesglose.HpMotor:
                @* D8: en un grupo, el bypass no entra al cálculo (430-53 cuenta el variador con su corriente de entrada). *@
                <td data-falta="@FaltaEn(c, aparato, col)">@if (col == ColDesglose.Bypass) { <input type="checkbox" class="apagado" disabled data-col="@CampoDe(ColDesglose.Bypass)" aria-label="Circuito @c.Espacio, carga @n · Bypass" title="Solo con el variador solo en su circuito." /> } else { <select class="hp apagado" disabled data-col="@CampoDe(ColDesglose.HpMotor)" aria-label="Circuito @c.Espacio, carga @n · HP del motor" title="Solo con el variador solo en su circuito."><option>—</option></select> }</td>
                break;
            case ColDesglose.CorrienteNominal:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · Corriente de carga nominal (A)" value="@Carga(aparato.CorrientePlacaA)" @onchange="e => { aparato.CorrientePlacaA = LeerCarga(e, aparato.CorrientePlacaA); Recalcular(); }"
                           title="Corriente de carga nominal de la placa · 440-6(a)" /></td>
                break;
            case ColDesglose.CorrienteSeleccion:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="—" data-col="@CampoDe(ColDesglose.CorrienteSeleccion)" aria-label="Circuito @c.Espacio, carga @n · Corriente de selección (A)" value="@Carga(aparato.CorrienteSeleccionA ?? 0m)" @onchange="e => { var v = LeerCarga(e, aparato.CorrienteSeleccionA ?? 0m); aparato.CorrienteSeleccionA = v > 0m ? v : null; Recalcular(); }"
                           title="Corriente de selección de la placa, si la trae · 440-6(a)" /></td>
                break;
            case ColDesglose.Arranque225:
                @* D10: solo el mayor, y en un circuito de A/A — 440-22(b)(1). *@
                var activa = c.EsAireAcondicionado && ReferenceEquals(MotocompresorMayor(c), aparato);
                <td data-falta="@FaltaEn(c, aparato, col)"><input type="checkbox" class="@Apagado(!activa)" disabled="@(!activa)" data-col="@CampoDe(ColDesglose.Arranque225)" aria-label="Circuito @c.Espacio, carga @n · No arranca al 175 %" checked="@(activa && c.ArranqueAl225)" @onchange="e => { c.ArranqueAl225 = e.Value is true; Recalcular(); }"
                           title="@(activa ? "No arranca con la protección al 175 % · 440-22(a)" : "Solo en el motocompresor mayor.")" /></td>
                break;
            case ColDesglose.CorrienteTotal:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="A" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · Corriente total (A)" value="@Carga(aparato.CorrientePlacaA)" @onchange="e => { aparato.CorrientePlacaA = LeerCarga(e, aparato.CorrientePlacaA); Recalcular(); }"
                           title="Corriente total de la placa del acondicionador · 440-62" /></td>
                break;
            case ColDesglose.ContinuaTablero:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="ap-carga" aria-label="Circuito @c.Espacio, carga @n · Continua" value="@Carga(aparato.CargaUnitaria)" @onchange="e => { aparato.CargaUnitaria = LeerCarga(e, aparato.CargaUnitaria); Recalcular(); }"
                           title="Carga continua del otro tablero, ya con sus factores de demanda · 220-40" /></td>
                break;
            case ColDesglose.NoContinuaTablero:
                <td data-falta="@FaltaEn(c, aparato, col)"><input class="va" type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="0" data-col="ap-continua" aria-label="Circuito @c.Espacio, carga @n · No continua" value="@Carga(aparato.NoContinua)" @onchange="e => { aparato.NoContinua = LeerCarga(e, aparato.NoContinua); Recalcular(); }"
                           title="Carga no continua del otro tablero, ya con sus factores de demanda · 220-40" /></td>
                break;
            case ColDesglose.Fp:
                <td data-falta="@FaltaEn(c, aparato, col)"><input data-requerido class="va fp" type="text" inputmode="decimal" autocomplete="off" data-numero min="@FactorMinimo" max="1" step="0.05" data-col="ap-fp" aria-label="Circuito @c.Espacio, carga @n · F.P." value="@Factor(aparato.FactorPotencia)" @onchange="e => { aparato.FactorPotencia = LeerFactor(e, aparato.FactorPotencia); Recalcular(); }" /></td>
                break;
            case ColDesglose.Total:
                <td data-falta="@FaltaEn(c, aparato, col)" class="num" title="@(aparato.EsMaquina && aparato.CorrienteUnitariaA > 0m ? $"{aparato.Cantidad} × {aparato.CorrienteUnitariaA:N2} A = {aparato.Cantidad * aparato.CorrienteUnitariaA:N2} A" : aparato.ReferenciaMinimo is { } rm ? $"Incluye la carga mínima · {rm}" : null)">@aparato.TotalVA.ToString("#,0.##")</td>
                break;
            case ColDesglose.Quitar:
                <td data-falta="@FaltaEn(c, aparato, col)"><button class="quitar" title="Quitar la carga" aria-label="Quitar la carga @n del circuito @c.Espacio" @onclick="() => QuitarAparato(c, aparato, n)"><Icono Nombre="quitar" Tamano="14" /></button></td>
                break;
            default:
                <td data-falta="@FaltaEn(c, aparato, col)" class="tenue">—</td>
                break;
        }
    };
}
