    private static bool LlevaNotas(CircuitoDelCuadro c) =>
        c.Polos == 1 && (c.TieneCarga || c.TieneDesglose || c.EsMotor || c.EsAireAcondicionado || c.Unidad != UnidadConsumo.VoltAmperes);

    private int Columnas => 15 + Datos.Barras.Count;

    /// <summary>Los dos bloques del cuadro, ya materializados: cada uno se recorre más de una vez.</summary>
    private IReadOnlyList<IReadOnlyList<CircuitoDelCuadro>> Lados => Cuadro.Lados;

    /// <summary>
    /// La celda de un conductor: la designación con su unidad («12 AWG», «250 kcmil») y, debajo, su sección en mm². Los hilos en
    /// paralelo ya no llevan columna (David, 2026-09-24): si son más de uno, «2 ×» antes del calibre.
    /// Se combina hacia abajo tantos renglones como polos tenga el interruptor.
    /// </summary>
    /// <param name="porque">El desglose de la selección: si viene, la designación AWG/kcmil lleva un
    /// tooltip con cómo se llegó a ese calibre.</param>
    /// <param name="sinConductor">El circuito no lleva ese conductor (un bipolar F-F sin neutro): «—» — I-41.</param>
    private static RenderFragment Conductor(Calibre? calibre, int hilos, int polos, IReadOnlyList<string>? porque = null, bool sinConductor = false) => builder =>
    {
        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "class", "num conductor");
        builder.AddAttribute(2, "rowspan", polos);
        if (sinConductor)
            builder.AddContent(7, "—");
        else if (calibre is not null && hilos > 0)
        {
            builder.AddContent(3, Ayuda(ConHilos(calibre, hilos), porque));
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "mm2");
            builder.AddContent(6, $"{calibre.AreaMm2:N2} mm²");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    /// <summary>El calibre con su unidad, y «2 ×» antes si lleva conductores en paralelo.</summary>
    internal static string ConHilos(Calibre calibre, int hilos) =>
        hilos > 1 ? $"{hilos} × {calibre.DesignacionConUnidad}" : calibre.DesignacionConUnidad;

    /// <summary>
    /// Un valor con su porqué en un tooltip, subrayado punteado como los encabezados que ya lo
    /// llevan. Sin desglose, el valor tal cual.
