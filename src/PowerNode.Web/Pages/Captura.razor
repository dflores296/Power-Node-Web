                            ×
                            <input type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="alto" data-col="cn-alto" aria-label="@CuadroDeCarga.NombreDe(t) · Alto interior (mm)" title="Alto interior (mm)" value="@Opcional(t.AltoMm)" @onchange="e => { t.AltoMm = Decimal(e.Value); Recalcular(); }" /> mm
                        </span>
                    }
                    else
                    {
                        <span class="medidas">
                            <input type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="área mm²" data-col="cn-area" aria-label="@CuadroDeCarga.NombreDe(t) · Área interior (mm²)" title="Área interior (mm²)" value="@Opcional(t.AreaInteriorMm2)" @onchange="e => { t.AreaInteriorMm2 = Decimal(e.Value); Recalcular(); }" />
                            <input type="text" inputmode="decimal" autocomplete="off" data-numero min="0" placeholder="máx." data-col="cn-max" aria-label="@CuadroDeCarga.NombreDe(t) · Máximo de conductores" title="Número máximo de conductores que marca el fabricante" value="@(t.MaxConductoresFabricante?.ToString() ?? "")" @onchange="e => { t.MaxConductoresFabricante = int.TryParse(e.Value?.ToString(), out var m) && m > 0 ? m : null; Recalcular(); }" />
                        </span>
                    }
                </div>
            </td>
            @if (!alimentador)
            {
                <td>@(t.Circuitos.Count == 0 ? "—" : string.Join(", ", t.Circuitos.Select(c => c.Espacio)))</td>
            }
            <td class="num">@DePapel(t, PapelConductor.Fase)</td>
            <td class="num">@DePapel(t, PapelConductor.Neutro)</td>
            <td class="num">@DePapel(t, PapelConductor.Tierra)</td>
            <td class="num">
                @if (t.Conteo is { } conteo)
                {
