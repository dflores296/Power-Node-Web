    private static string Texto(string valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    private static string Cifra(decimal valor) => valor <= 0m ? "" : valor.ToString("#,0.##");

    /// <summary>
    /// Lo que va en las cuatro celdas de carga de un motor o un equipo de A/C — I-15, I-74: «5 HP · FLC
    /// 15.20 A», «12 A (3.93 HP) · FLC 12.00 A», «MCA 18 A · MOCP 30 A».
    /// </summary>
    private static string PlacaDelRenglon(CircuitoDelCuadro c) =>
        c.EsGrupo ? PlacaDelGrupo(c)
        : c.EsVariador ? (c.TieneCarga ? $"Variador: entrada {c.CorrienteEntradaVariadorA:#,0.##} A · máx. {c.ProteccionMaximaVariadorA:#,0.##} A" : "")
        : c.EsAireAcondicionado ? (c.TieneCarga ? AireAcondicionadoDePlaca.Texto(c) : "")
        : c.MotorEnAmperes is { } m ? $"{m.Amperes:#,0.##} A ({m.Hp:0.##} HP) · FLC {c.FlcA:N2} A"
        : (c.Hp > 0m ? $"{MotoresEnHp.Texto(c.Hp.Value)} HP" : "") + (c.FlcA > 0m ? $" · FLC {c.FlcA:N2} A" : "");

    /// <summary>«3 × ½ HP + 5 HP · 41.90 A · otras 1,000 VA»: los motores de un grupo y su corriente — I-115.</summary>
    private static string PlacaDelGrupo(CircuitoDelCuadro c)
    {
        var maquinas = c.Cargas.Where(a => a.EsMaquina && a.TieneCapturaDeMaquina).Select(a =>
            (a.Cantidad > 1 ? $"{a.Cantidad} × " : "") +
            (a.Clase == ClaseDeAparato.Motocompresor ? $"motocompresor {a.CorrienteUnitariaA:#,0.##} A"
             : a.Clase == ClaseDeAparato.Variador ? $"variador {a.CorrientePlacaA:#,0.##} A"
             : a.CapturaMotor == CapturaDeMotor.Hp ? $"{MotoresEnHp.Texto(a.Hp ?? 0m)} HP" : $"{a.CorrientePlacaA:#,0.##} A"));
        var otras = c.ContinuaVA + c.NoContinuaVA;
        return string.Join(" + ", maquinas)
            + (c.CorrienteDeMotorA > 0m ? $" · {c.CorrienteDeMotorA:N2} A" : "")
            + (otras > 0m ? $" · otras {otras:#,0} VA" : "");
    }

    private static string DePapel(CanalizacionDelTablero t, PapelConductor papel) =>
