@page "/documento"
@page "/documento/{Pagina}"
@inject ProyectoActual Proyecto

<PageTitle>@Proyecto.TituloDeVentana</PageTitle>

@if (HojaVisible == Hoja.Cuadro)
{
    <article class="documento">
        <header class="doc-encabezado">
            <div class="doc-marca">
                <img class="solo-claro" src="marca/powernode-firma.svg" alt="Power Node" height="34" />
                <img class="solo-oscuro" src="marca/powernode-firma-oscura.svg" alt="Power Node" height="34" />
                <p class="doc-norma"><strong>Cuadro de carga</strong>NOM-001-SEDE-2012</p>
            </div>
            <dl class="doc-datos">
                <div><dt>Tablero</dt><dd>@Texto(Datos.Tablero)</dd></div>
                <div><dt>Clave</dt><dd>@Texto(Datos.Clave)</dd></div>
                <div><dt>Ubicación</dt><dd>@Texto(Datos.Ubicacion)</dd></div>
                <div><dt>Montaje</dt><dd>@Datos.Montaje · NEMA @Datos.GabineteNema</dd></div>
                <div><dt>Barras</dt><dd>@MemoriaDeCalculo.Etiqueta(Datos.MaterialBarras)@(Datos.CapacidadBarraA is { } cap ? $" · {cap:N0} A" : "")</dd></div>
                <div><dt>Espacios</dt><dd>@Datos.NumeroEspacios</dd></div>
                <div><dt>Conductor</dt><dd>@MemoriaDeCalculo.Etiqueta(Datos.MaterialConductor) · @MemoriaDeCalculo.Aislamiento(Datos)</dd></div>
            </dl>
            <dl class="doc-datos">
                <div><dt>Proyecto</dt><dd>@Texto(Datos.Proyecto)</dd></div>
                <div><dt>Cliente</dt><dd>@Texto(Datos.Cliente)</dd></div>
                <div><dt>Sistema</dt><dd>@Datos.EtiquetaSistema</dd></div>
                @* Sin neutro (3F-3H), solo la tensión entre fases — P2-1. *@
                <div><dt>Tensión</dt><dd>@(Datos.Barras.Count > 1 ? $"{Datos.TensionFaseFaseV:#,0.##} V F-F · " : "")@(Cuadro.SistemaConNeutro ? $"{Datos.TensionFaseNeutroV:N1} V F-N · " : "")@Datos.FrecuenciaHz Hz</dd></div>
                <div><dt>Int. ppal.</dt><dd>@(Cuadro.InterruptorPrincipalA > 0m ? $"{Cuadro.InterruptorPrincipalA:N0} A" : "—")</dd></div>
                <div><dt>Acometida</dt><dd>@(Datos.UsaInterruptorPrincipal ? "Interruptor principal" : "Zapatas principales")</dd></div>
                <div><dt>Inmueble</dt><dd>@Datos.Inmueble.Nombre()</dd></div>
                @if (Datos.EsEquipoDeAcometida)
                {
                    <div><dt>Equipo de acometida</dt><dd>Sí@(Datos.Minimo230_79 is { } m ? $" · principal mínimo {m.Amperes:N0} A — {m.Referencia}" : " · vivienda unifamiliar: según la carga — 230-79(c)")</dd></div>
                }
                <div><dt>Interruptores</dt><dd>@Datos.SerieInterruptores.Nombre()</dd></div>
            </dl>
        </header>

        @*
            Nones arriba, pares abajo, sin rótulo de lado y con un renglón delgado en medio: es
            literalmente como está armado el Excel. Una sola tabla para que las columnas de los dos
            bloques queden alineadas.
        *@
        @* En pantalla, la tabla se desplaza dentro de la hoja: en el celular salía de ella y arrastraba
           la página entera de lado (I-86). Impresa cabe y no se desplaza. *@
        <div class="desplazable">
        <table class="doc-cuadro">
            <thead>
                <tr>
                    <th rowspan="2">N.º</th>
                    <th rowspan="2" class="izq">Descripción</th>
                    <th colspan="5">Carga <span class="simbolo">(VA)</span></th>
                    <th colspan="@Datos.Barras.Count">Balanceo de fases <span class="simbolo">(VA)</span></th>
                    <th colspan="2">Protección</th>
                    <th rowspan="2">Fase</th>
                    <th rowspan="2">Neutro</th>
                    <th rowspan="2" title="Puesta a tierra">Tierra</th>
                    <th rowspan="2"><span class="simbolo">In (A)</span></th>
                    <th rowspan="2"><span class="simbolo">L (m)</span></th>
                    <th rowspan="2">Canal.</th>
                    <th rowspan="2"><span class="simbolo">e (%)</span></th>
                </tr>
                <tr>
                    <th>Continua</th><th>F.D.</th><th>No cont.</th><th>F.D.</th><th>Conectada</th>
                    @foreach (var barra in Datos.Barras) { <th class="col-fase">@barra</th> }
                    <th>P</th><th>A</th>
                </tr>
            </thead>
            <tbody>
                @*
                    Un multipolar es un solo renglón alto: sus celdas se combinan hacia abajo
                    cubriendo los espacios que ocupa, menos la del número, que sigue renglón por
                    renglón para que se lea 1 / 3 / 5. Es lo que hace un panel schedule, y lo que
                    ya emite el exportador de escritorio.
                *@
                @foreach (var (lado, indice) in Lados.Select((b, i) => (b, i)))
                {
                    @if (indice > 0)
                    {
                        <tr class="separador"><td colspan="@(16 + Datos.Barras.Count)"></td></tr>
                    }

                    @foreach (var c in lado.Where(x => !x.EsContinuacion))
                    {
                        @* El interruptor principal en espacios (I-68). *@
                        if (c.EsDelPrincipal)
                        {
                            <tr class="principal-doc">
                                <td class="num">@c.Espacio</td>
                                <td colspan="@(15 + Datos.Barras.Count)" rowspan="@Cuadro.EspaciosDelPrincipal.Count" class="izq">
                                    <strong>INTERRUPTOR PRINCIPAL</strong>@(Cuadro.InterruptorPrincipalA > 0m ? $" · {Cuadro.InterruptorPrincipalA:N0} A" : "") · @Datos.PolosDelPrincipal @(Datos.PolosDelPrincipal == 1 ? "polo" : "polos")
                                </td>
                            </tr>
                            @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                            {
                                <tr class="principal-doc"><td class="num">@seguido.Espacio</td></tr>
                            }
                            continue;
                        }
                        <tr class="@(c.TieneCarga ? null : "libre")">
                            <td class="num">@c.Espacio</td>
                            <td rowspan="@c.Polos" class="izq">@(c.SinTipo ? $"{(string.IsNullOrWhiteSpace(c.Descripcion) ? "" : c.Descripcion + " · ")}SIN TIPO" : string.IsNullOrWhiteSpace(c.Descripcion) ? (c.TieneCarga ? MemoriaDeCalculo.Etiqueta(c) : "LIBRE") : c.Descripcion)@if (ClaseDe(c) is { } tc)
                            {
                                <span class="doc-clase">@tc</span>
                            }</td>
                            @if (c.EsDeMotor)
                            {
                                @* I-15, I-74: un motor o un equipo de A/C no es continua ni no continua; va por 430-24 / 440-33. *@
                                <td rowspan="@c.Polos" colspan="4" class="num">@PlacaDelRenglon(c)</td>
                            }
                            else
                            {
                                <td rowspan="@c.Polos" class="num">@Cifra(c.ContinuaVA)</td>
                                <td rowspan="@c.Polos" class="num">@(c.TieneCarga ? "1.00" : "")</td>
                                <td rowspan="@c.Polos" class="num">@Cifra(c.NoContinuaVA)</td>
                                <td rowspan="@c.Polos" class="num">@(c.TieneCarga ? "1.00" : "")</td>
                            }
                            <td rowspan="@c.Polos" class="num">@Cifra(c.CargaInstaladaVA)</td>
                            @foreach (var barra in Datos.Barras)
                            {
                                <td rowspan="@c.Polos" class="num col-fase">@(c.TieneCarga && c.Fases.Contains(barra) ? c.CargaPorFaseVA.ToString("#,0.##") : "")</td>
                            }
                            <td rowspan="@c.Polos" class="num">@(c.Resultado is null ? "" : c.Polos.ToString())</td>
                            <td rowspan="@c.Polos" class="num">@(c.Resultado is null ? "" : c.Resultado.ProteccionA.ToString("N0"))</td>
                            @Conductor(c.Resultado?.CalibreFase, c.Resultado?.NumeroConductoresParalelo ?? 0, c.Polos)
                            @Conductor(c.LlevaNeutro ? c.Resultado?.CalibreNeutro : null, c.Resultado is null ? 0 : 1, c.Polos, sinConductor: c.Resultado is not null && !c.LlevaNeutro)
                            @Conductor(c.Resultado?.CalibreTierra, c.Resultado is null ? 0 : 1, c.Polos)
                            <td rowspan="@c.Polos" class="num">@(c.Resultado?.CorrienteDisenoA.ToString("N2"))</td>
                            <td rowspan="@c.Polos" class="num">@(c.Resultado is null ? "" : c.LongitudM.ToString("N0"))</td>
                            @* El nombre arriba y el tamaño abajo, sin partir: impreso, «T1 · 21 mm / ¾ in» salía en tres renglones (I-92). *@
                            <td rowspan="@c.Polos" class="num canal">@if (c.Resultado is not null && c.CanalizacionEfectiva is { } canal) {<span class="canal-nombre">@canal.Nombre</span><span class="canal-tamano">@canal.TamanoRotulo</span>}</td>
                            <td rowspan="@c.Polos" class="num">@(c.Resultado?.CaidaTensionPct.ToString("N2"))</td>
                        </tr>

                        @foreach (var seguido in lado.Where(x => x.ContinuacionDe == c.Espacio))
                        {
                            <tr>
                                <td class="num">@seguido.Espacio</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
        </div>

        <section class="doc-pie">
            <div>
                <h3>Resumen de carga</h3>
                <table class="doc-resumen">
                    <tr><th></th><th>Carga conectada <span class="simbolo">(kVA)</span></th><th>F.D.</th><th>Demanda <span class="simbolo">(kVA)</span></th></tr>
                    @foreach (var fila in (Cuadro.Resumen.PorCategoria ?? []).Where(f => f.InstaladaVA > 0m))
                    {
                        <tr>
                            <td class="izq">@fila.Categoria.NombreCompleto()</td>
                            <td class="num">@((fila.InstaladaVA / 1000m).ToString("N2"))</td>
                            <td class="num">@fila.FactorDemanda.ToString("N2")</td>
                            <td class="num">@((fila.DemandadaVA / 1000m).ToString("N2"))</td>
                        </tr>
                    }
                    @if (Cuadro.Resumen.Minimo220_52VA > 0m)
                    {
                        <tr>
                            <td class="izq">Mínimo 220-52</td>
                            <td class="num">@((Cuadro.Resumen.Minimo220_52VA / 1000m).ToString("N2"))</td>
                            <td class="num">@Datos.FactorDemandaContactos.ToString("N2")</td>
                            <td class="num">@((Cuadro.Resumen.Minimo220_52DemandadoVA / 1000m).ToString("N2"))</td>
                        </tr>
                    }
                    @if (Cuadro.Resumen.Superficie is { } sp)
                    {
                        <tr>
                            <td class="izq">Mínimo 220-12 · @sp.AreaM2.ToString("N0") m² × @sp.VaPorM2.ToString("N0") VA/m²</td>
                            <td class="num">@((sp.AjusteAlumbradoVA / 1000m).ToString("N2"))</td>
                            <td class="num">@Datos.FactorDemandaAlumbrado.ToString("N2")</td>
                            <td class="num">@((sp.AjusteAlumbradoVA * Datos.FactorDemandaAlumbrado / 1000m).ToString("N2"))</td>
                        </tr>
                        @if (sp.MinimoContactosVA is not null)
                        {
                            <tr>
                                <td class="izq">Mínimo 220-14(k) · 11 VA/m²</td>
                                <td class="num">@((sp.AjusteContactosVA / 1000m).ToString("N2"))</td>
                                <td class="num">@Datos.FactorDemandaContactos.ToString("N2")</td>
                                <td class="num">@((sp.AjusteContactosVA * Datos.FactorDemandaContactos / 1000m).ToString("N2"))</td>
                            </tr>
                        }
                    }
                    <tr class="total">
                        <td class="izq">Total <span class="simbolo">(kVA)</span></td>
                        <td class="num">@((Cuadro.Resumen.CalculadaVA / 1000m).ToString("N2"))</td>
                        <td></td>
                        <td class="num">@((Cuadro.Resumen.DemandadaVA / 1000m).ToString("N2"))</td>
                    </tr>
                    <tr class="total">
                        <td class="izq">Total <span class="simbolo">(kW)</span></td>
                        <td class="num">@((Cuadro.Resumen.InstaladaW / 1000m).ToString("N2"))</td>
                        <td></td>
                        <td class="num">@((Cuadro.Resumen.DemandadaW / 1000m).ToString("N2"))</td>
                    </tr>
                    <tr>
                        <td class="izq">F.P. resultante</td>
                        <td class="num">@Cuadro.Resumen.FactorPotencia.ToString("N2")</td>
                        <td></td><td></td>
                    </tr>
                    <tr class="subtitulo">
                        <th class="izq" colspan="4">Al alimentador</th>
                    </tr>
                    <tr>
                        <td class="izq">Continua — 125 %, 215-3</td>
                        <td class="num">@(((Cuadro.Resumen.ContinuaVA + (Cuadro.Resumen.Superficie?.AjusteContinuaVA ?? 0m)) / 1000m).ToString("N2"))</td>
                        <td></td>
                        <td class="num">@(((Cuadro.Resumen.ContinuaDemandadaVA + (Cuadro.Resumen.Superficie?.ContinuaDemandadaVA ?? 0m)) / 1000m).ToString("N2"))</td>
                    </tr>
                    <tr>
                        <td class="izq">No continua — 100 %</td>
                        <td class="num">@(((Cuadro.Resumen.NoContinuaVA + Cuadro.Resumen.Minimo220_52VA + (Cuadro.Resumen.Superficie?.AjusteNoContinuaVA ?? 0m)) / 1000m).ToString("N2"))</td>
                        <td></td>
                        <td class="num">@(((Cuadro.Resumen.NoContinuaDemandadaVA + Cuadro.Resumen.Minimo220_52DemandadoVA + (Cuadro.Resumen.Superficie?.NoContinuaDemandadaVA ?? 0m)) / 1000m).ToString("N2"))</td>
                    </tr>
                    @if (Cuadro.Resumen.MotoresVA > 0m)
                    {
                        <tr>
                            <td class="izq">@Cuadro.EtiquetaDeMotores — @Cuadro.ReferenciaDeMotores</td>
                            <td class="num">@((Cuadro.Resumen.MotoresVA / 1000m).ToString("N2"))</td>
                            <td></td>
                            <td class="num">@((Cuadro.Resumen.MotoresDemandadaVA / 1000m).ToString("N2"))</td>
                        </tr>
                    }
                </table>
            </div>

            <div>
                <h3>Alimentador y protección principal</h3>
                @if (Cuadro.Alimentador.Resultado is { } a)
                {
                    <table class="doc-resumen">
                        <tr>
                            <th>P × A</th><th>Fase</th><th>Neutro</th><th>Puesta a tierra</th><th><span class="simbolo">In (A)</span></th><th><span class="simbolo">L (m)</span></th><th><span class="simbolo">e (%)</span></th>
                        </tr>
                        <tr>
                            <td class="num fuerte">@Cuadro.Alimentador.Polos × @a.ProteccionA.ToString("N0")</td>
                            <td class="num">@Captura.ConHilos(a.CalibreFase, a.NumeroConductoresParalelo)</td>
                            <td class="num">@(Cuadro.SistemaConNeutro ? Captura.ConHilos(a.CalibreNeutro, a.NumeroConductoresParalelo) : "—")</td>
                            @* En paralelo, una por canalización — 250-122(f) (riesgo 4). *@
                            <td class="num">@Captura.ConHilos(a.CalibreTierra, Cuadro.TierrasDelAlimentador)</td>
                            @* La corriente de la fase más cargada, que es con la que se dimensiona — M-02. *@
                            <td class="num">@a.CorrienteDisenoA.ToString("N2")@(Cuadro.Alimentador.Gobierna is { } g && Datos.Barras.Count > 1 ? $" (fase {g.Fase})" : "")</td>
                            <td class="num">@Datos.LongitudAlimentadorM.ToString("N0")</td>
                            <td class="num">@a.CaidaTensionPct.ToString("N2")</td>
                        </tr>
                    </table>
                    @* Equipo de acometida (P3-3): el conductor del electrodo y el puente de unión principal. *@
                    @if (Cuadro.TierraDeAcometida is { } tierraAcometida)
                    {
                        <table class="doc-resumen separado">
                            <tr><th>Conductor del electrodo de puesta a tierra</th><th>Puente de unión principal</th></tr>
                            <tr>
                                <td class="num">@tierraAcometida.ConductorElectrodo.DesignacionConUnidad — Tabla 250-66</td>
                                <td class="num">@tierraAcometida.PuenteDeUnion.DesignacionConUnidad — 250-28(d)(1)</td>
                            </tr>
                        </table>
                    }
                }
                <table class="doc-resumen separado">
                    <tr>
                        @foreach (var barra in Datos.Barras) { <th>Fase @barra <span class="simbolo">(VA)</span></th> }
                        <th>Desbalanceo</th>
                    </tr>
                    <tr>
                        @foreach (var barra in Datos.Barras)
                        {
                            <td class="num">@Cuadro.Resumen.CargaPorFaseVA[barra].ToString("#,0.##")</td>
                        }
                        <td class="num fuerte">@Cuadro.Resumen.DesbalanceoPct.ToString("N1") %</td>
                    </tr>
                </table>
            </div>
        </section>

        @{ var canales = Cuadro.TodasLasCanalizaciones.Where(t => t.Ocupacion is not null).ToList(); }
        @if (canales.Count > 0)
        {
            <h3 class="doc-titulo-canal">Canalizaciones</h3>
            <div class="desplazable">
            <table class="doc-resumen doc-canal">
                <tr>
                    <th rowspan="2">Canal.</th><th rowspan="2">Tipo</th><th rowspan="2">Circuitos</th>
                    <th colspan="3">Conductores</th>
                    <th rowspan="2">Portadores</th><th rowspan="2">F.A.</th><th rowspan="2">Área <span class="simbolo">(mm²)</span></th>
                    <th colspan="2">Tamaño</th><th rowspan="2">Ocupación</th>
                </tr>
                <tr>
                    <th>Fase</th><th>Neutro</th><th>Tierra</th><th><span class="simbolo">mm</span></th><th><span class="simbolo">in</span></th>
                </tr>
                @foreach (var t in canales)
                {
                    <tr>
                        <td>@(t.EsAlimentador ? "Alimentador" : t.Nombre)</td>
                        <td>@t.Rotulo</td>
                        <td>@(t.EsAlimentador ? "" : string.Join(", ", t.Circuitos.Select(c => c.Espacio)))</td>
                        <td class="num">@DePapel(t, PapelConductor.Fase)</td>
                        <td class="num">@DePapel(t, PapelConductor.Neutro)</td>
                        <td class="num">@DePapel(t, PapelConductor.Tierra)</td>
                        <td class="num">@t.Conteo?.Portadores</td>
                        <td class="num">@t.FactorAgrupamiento?.ToString("N2")</td>
                        <td class="num">@t.Ocupacion!.AreaTotalMm2?.ToString("N1")</td>
                        <td class="num fuerte">@t.TamanoMm</td>
                        <td class="num fuerte">@t.TamanoIn</td>
                        <td class="num">@(t.Ocupacion.OcupacionPct is { } pct ? $"{pct:N1} %" : "")</td>
                    </tr>
                }
            </table>
            </div>
        }

        @foreach (var aviso in Cuadro.Alimentador.Avisos)
        {
            <p class="aviso">@aviso</p>
        }
        @foreach (var c in Cuadro.ConCaidaCombinadaExcedida)
        {
            <p class="aviso">@c.AvisoCaidaCombinada</p>
        }
        @foreach (var aviso in Cuadro.AvisosDeCanalizaciones)
        {
            <p class="aviso">@aviso</p>
        }

        <p class="doc-nota">
            Calculado con las tablas de la NOM-001-SEDE-2012 verificadas contra el PDF del DOF.
            <strong>Los resultados no sustituyen el criterio del ingeniero responsable.</strong>
        </p>
    </article>
}
else
{
    <article class="documento memoria-doc">
        <header class="doc-encabezado">
            <div class="doc-marca">
                <img class="solo-claro" src="marca/powernode-firma.svg" alt="Power Node" height="34" />
                <img class="solo-oscuro" src="marca/powernode-firma-oscura.svg" alt="Power Node" height="34" />
                <p class="doc-norma"><strong>Memoria de cálculo</strong>NOM-001-SEDE-2012</p>
            </div>
            <dl class="doc-datos">
                <div><dt>Tablero</dt><dd>@Texto(Datos.Tablero)</dd></div>
                <div><dt>Clave</dt><dd>@Texto(Datos.Clave)</dd></div>
                <div><dt>Ubicación</dt><dd>@Texto(Datos.Ubicacion)</dd></div>
                <div><dt>Proyecto</dt><dd>@Texto(Datos.Proyecto)</dd></div>
            </dl>
            <dl class="doc-datos">
                <div><dt>Cliente</dt><dd>@Texto(Datos.Cliente)</dd></div>
                <div><dt>Diseñó</dt><dd>@Texto(Datos.Diseno)</dd></div>
                <div><dt>Revisó</dt><dd>@Texto(Datos.Reviso)</dd></div>
                <div><dt>Aprobó</dt><dd>@Texto(Datos.Aprobo)</dd></div>
            </dl>
        </header>

        @if (Hojas.Count == 0)
        {
            <p class="derivado">Todavía no hay circuitos calculados: captura la carga de alguno y la memoria se arma sola.</p>
        }

        @foreach (var hoja in Hojas)
        {
            <section class="hoja">
                <h3>@hoja.Sujeto</h3>

                @foreach (var bloque in MemoriaDeCalculo.Secciones(hoja))
                {
                    <h4>@bloque.Titulo</h4>

                    @if (bloque.Introduccion is { } introduccion)
                    {
                        <p class="intro">@introduccion</p>
                    }

                    @if (bloque.Renglones.Count > 0)
                    {
                        <table class="doc-resumen">
                            @foreach (var renglon in bloque.Renglones)
                            {
                                <tr>
                                    <td class="izq rotulo">@renglon.Rotulo</td>
                                    <td class="izq">@renglon.Valor</td>
                                </tr>
                            }
                        </table>
                    }

                    @foreach (var formula in bloque.Formulas)
                    {
                        <p class="formula">@formula</p>
                    }

                    @foreach (var nota in bloque.Notas)
                    {
                        <p class="nota">@nota</p>
                    }
                }

                <h4>CITAS DEL CÁLCULO</h4>
                <ul class="citas">
                    @foreach (var cita in hoja.Citas)
                    {
                        <li><code>@cita.Referencia</code> @cita.Descripcion</li>
                    }
                </ul>
            </section>
        }

        @foreach (var (sujeto, bloques) in MemoriaDeCalculo.Canalizaciones(Cuadro))
        {
            <section class="hoja">
                <h3>@sujeto</h3>
                @foreach (var bloque in bloques)
                {
                    <h4>@bloque.Titulo</h4>
                    @if (bloque.Renglones.Count > 0)
                    {
                        <table class="doc-resumen">
                            @foreach (var renglon in bloque.Renglones)
                            {
                                <tr>
                                    <td class="izq rotulo">@renglon.Rotulo</td>
                                    <td class="izq">@renglon.Valor</td>
                                </tr>
                            }
                        </table>
                    }
                    @foreach (var formula in bloque.Formulas)
                    {
                        <p class="formula">@formula</p>
                    }
                    @foreach (var nota in bloque.Notas)
                    {
