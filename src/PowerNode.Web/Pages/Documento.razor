        {
            builder.AddContent(3, Captura.ConHilos(calibre, hilos));
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "mm2");
            builder.AddContent(6, $"{calibre.AreaMm2:N2} mm²");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    /// <summary>
    /// «Uso general», «Individual», «Grupo de motores», «Alimentador»: la clase del circuito, como en la
    /// captura — decisión captura-en-el-desplegable.md. El tipo es de cada carga, no del circuito.
    /// </summary>
    private static string? ClaseDe(CircuitoDelCuadro c) =>
